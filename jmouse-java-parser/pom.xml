<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.1</version>
    </parent>
    <artifactId>jmouse-java-parser</artifactId>
    <version>1.0.1</version>
    <name>jMouse - Java Parser</name>
    <description>Structural Java source parser on the jME lexer, cursor and node contracts: package, imports, types,
        members, signatures and JavaDoc with exact source spans and stable symbol ids; bodies stay opaque, nothing is
        resolved or executed.
    </description>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>1.0.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- The token, cursor, tokenizer, source and node contracts the parser is built on. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-el</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
