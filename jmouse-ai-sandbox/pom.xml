<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.0-b20260802</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <packaging>jar</packaging>
    <artifactId>jmouse-ai-sandbox</artifactId>
    <name>jMouse - AI Sandbox</name>
    <description>jMouse Framework - Reference application exercising the AI modules through every entry point. Not published.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.deploy.skip>true</maven.deploy.skip>

        <!-- What `mvn exec:java` runs unless -Dexec.mainClass names the other one. -->
        <exec.mainClass>org.jmouse.ai.sandbox.SandboxApplication</exec.mainClass>
    </properties>

    <!--
      The consumer the AI modules would otherwise not have.

      Building the whole library before any product adopts it means every SPI signature and every
      guard boundary is a hypothesis until something calls it. This module is what calls it: every
      seam implemented, tool definitions covering the awkward cases (read-only, destructive with a
      record resolver, scope-confined, nested object-list arguments), driven through all three entry
      points - the dispatcher directly, the conversation runner, and an MCP client.

      Same role pet-gallery and wep-app already play in this repository. Never published, and never
      depended on by anything.
    -->
    <dependencies>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-conversation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          The optional management controllers, exercised the same way everything else here is: by being
          called. They are plain methods returning plain values, so no container is needed to find out
          whether they answer - and no container is what stops this module from quietly becoming a
          Spring application whose behaviour depends on a context nobody reads.
        -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-management</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- To render what those methods return exactly as a client would receive it. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!--
              A default rather than a fixed value, because the whole point of this module is that
              somebody runs it after changing something - and there is more than one thing to run.
              -Dexec.mainClass=... picks the other.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>

</project>
