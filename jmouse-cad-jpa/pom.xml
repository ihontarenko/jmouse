<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <packaging>jar</packaging>
    <artifactId>jmouse-cad-jpa</artifactId>
    <name>jMouse - CAD JPA</name>
    <description>jMouse Framework - jmCAD persistence over Jakarta Persistence: the catalogue of documents — every revision of their text, the index rows derived from the head, their sections, tags and relations — under its own migration history.</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-cad-jpa</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ihontarenko</id>
            <name>Ivan Hontarenko</name>
            <email>ihontarenko@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
        <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
        <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-cad-jpa</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <!-- The Hibernate the products adopting this run (Spring Boot 4.0.7's), compiled against only. -->
        <hibernate.version>7.2.19.Final</hibernate.version>
    </properties>

    <dependencies>
        <!-- ⚠️ No dependency on the language: a document's kind and a relation's kind are stored as the words the
             language writes them with (component, footprint, symbol…), so a new kind needs no change here. -->
        <!-- The name a revision is said by — 20261023_001 —: written with every revision of a document's text. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-revisions</artifactId>
        </dependency>

        <!-- Jakarta Persistence only. No Spring Data, no Spring: transaction demarcation belongs to
             whoever calls the stores, not to the library. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- ⚠️ Annotations only, and provided by the application's own JPA provider. The entities pin column
             types Jakarta Persistence cannot say for two dialects at once: a CHAR(64) checksum (PostgreSQL's
             validation refuses it as VARCHAR) and LONGTEXT/TEXT. A columnDefinition would name one dialect;
             @Lob maps a String to an oid on PostgreSQL. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
