<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.0-b20260902</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <packaging>jar</packaging>
    <artifactId>jmouse-access-enforcement</artifactId>
    <name>jMouse - Access (enforcement)</name>
    <description>jMouse Framework - Scoped authorization engine (scope model, ordered axes, grant store SPI, visibility scopes)</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-access-enforcement</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ihontarenko</id>
            <name>Ivan Hontarenko</name>
            <email>ihontarenko@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
        <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
        <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-access-enforcement</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>

    <!--
      Deliberately almost dependency-free — not even jmouse-core.

      The point of this module is that an authorization engine can be dropped into a product whose
      layers, storage and web stack are all somebody else's. A dependency added here is a dependency
      every such product inherits, so the bar is: does the engine stop working without it? For a
      logging facade the answer is yes and it is an interface anyway; for string helpers it is no,
      however convenient they are. Persistence, HTTP and dependency injection are the caller's, and
      the seams under `org.jmouse.access.spi` are how they get in.
    -->
    <dependencies>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              ⚠️ THIS MODULE'S DEPENDENCY LIST IS LOAD-BEARING, so the build states it rather than
              trusting a reviewer to notice.

              `@AccessContext(values = @AccessValue(from = "purposeCode"))` names a METHOD PARAMETER,
              not a path variable, and that is the whole reason the same annotation gates an agent
              tool, a scheduled job or a game as well as a controller. The moment anything here
              imports a web framework that stops being true — silently, at the next release, for every
              consumer who is not on that framework.

              Transitive arrivals are banned too: the failure is about what reaches the classpath, not
              about what somebody wrote in this file.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforcement-stays-framework-free</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>jakarta.servlet:*</exclude>
                                        <exclude>javax.servlet:*</exclude>
                                        <exclude>jakarta.ws.rs:*</exclude>
                                        <exclude>org.jmouse:jmouse-web</exclude>
                                        <exclude>org.jmouse:jmouse-http</exclude>
                                        <exclude>org.jmouse:jmouse-core</exclude>
                                    </excludes>
                                    <message>
                                        jmouse-access-enforcement depends on jmouse-access and slf4j
                                        and nothing else. Its annotations name method parameters,
                                        never request parameters, which is what lets them gate an
                                        agent tool or a job as well as a controller. Anything that
                                        knows what a request is belongs in an adapter module.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
