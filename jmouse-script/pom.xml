<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.0-b20260902</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <packaging>jar</packaging>
    <artifactId>jmouse-script</artifactId>
    <name>jMouse - Script (stages)</name>
    <description>jMouse Framework - where a jMS script may be hung: named stages, the three verbs, the dispatcher and the run log</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-script</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ihontarenko</id>
            <name>Ivan Hontarenko</name>
            <email>ihontarenko@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
        <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
        <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-script</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>

    <dependencies>
        <!--
            ⚠️ THE DIALECT, AND NOTHING ELSE. This module says WHERE a script may be hung and WHAT it is
            allowed to do there; `jmouse-script-el` says what the language is. The split is the same one
            `jmouse-validation` and `jmouse-validation-el` already keep.
        -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-script-el</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            ⚠️ THERE IS DELIBERATELY NO SPRING HERE, AND NO PERSISTENCE.

            Measured before this module was written: 0 Spring imports across 183 files of
            `jmouse-files`, `jmouse-storage`, `jmouse-access` and their `-jpa` halves. That is a
            convention rather than an accident, and the mechanism this module extracts did NOT hold to it
            where it came from — it was built on `@Component`, `@Service`, `ObjectProvider` and
            `PlatformTransactionManager`.

            So the extraction de-Springs on the way out: a registry takes its list, a runtime takes a
            lookup, and a dispatcher takes something that can run work in a transaction. Each of those is
            one line for a product to supply, and none of them drags a container into a library.
        -->

        <!--
            ⚠️ DECLARED, not inherited through `jmouse-script-el`. The registry logs the stage list at
            startup, so slf4j is a DIRECT import here — and a direct import resting on a transitive
            dependency breaks the day the module in between stops needing it. Every sibling that logs
            declares it the same way.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
