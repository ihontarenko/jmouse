<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-spring</artifactId>
        <version>1.0.0-b20260802</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jmouse-access-spring-boot</artifactId>
    <packaging>jar</packaging>
    <name>jMouse - Access Spring Boot Starter</name>
    <description>Spring Boot auto-configuration for the jMouse access engine: @RequiresAccess advice, target binding, request-scoped resolution cache</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-spring/jmouse-access-spring-boot</url>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- Compiled against Boot 4, which is what the products adopting this run. Every Spring type
             used here — @AutoConfiguration, the @ConditionalOn* family, Environment, MultipartFile,
             ResponseEntity — is unchanged between 3.3 and 4.x, so the jar still works on a Boot 3
             application. Boot's own Flyway classes are deliberately NOT referenced: those did move
             package in 4, and ordering is expressed by bean name instead. -->
        <spring-boot.version>4.0.7</spring-boot.version>
        <flyway.version>11.7.2</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The engine and its framework-less enforcement. Both required: this module is the adapter
             and contributes no mechanism of its own. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-enforcement</artifactId>
        </dependency>

        <!-- The JPA target resolver — optional, so a product resolving targets some other way never
             sees jakarta.persistence. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Declarative policies, and the .jmp parser that reads them. Optional, and in practice both
             or neither: the policy auto-configuration is conditional on the loader being present, so a
             product that keeps every grant in tables carries none of this and never sees jmouse-el. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-policy</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-el</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Spring MVC, for reading  and  off a handler. Optional: a
             non-web application still gets the advice, and simply names parameters by their
             declared names. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
