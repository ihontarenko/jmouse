<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-spring</artifactId>
        <version>1.0.0-b20260802</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <packaging>jar</packaging>
    <artifactId>jmouse-ai-spring-boot</artifactId>
    <name>jMouse - AI Spring Boot</name>
    <description>jMouse Framework - Spring Boot autoconfiguration for the AI tool catalogue, dispatcher, providers and MCP transport</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-spring/jmouse-ai-spring-boot</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ihontarenko</id>
            <name>Ivan Hontarenko</name>
            <email>ihontarenko@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
        <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
        <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-spring/jmouse-ai-spring-boot</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!--
          Spring Boot 4, overriding the jmouse-spring parent's 3.3.5, and the same choice
          jmouse-access-spring-boot made.

          The consequence is stated rather than worked around: a product still on Boot 3.3 cannot take
          this starter. It can take jmouse-ai, jmouse-ai-provider and jmouse-ai-conversation - all
          plain Java - and declare the beans itself, which is roughly twenty lines. A compatibility
          shim was considered and rejected: it would outlive the migrations it exists to postpone.
        -->
        <spring-boot.version>4.0.7</spring-boot.version>

        <!-- SCAFFOLD - remove with the first public type (ticket 10). See jmouse-ai/pom.xml for why. -->
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Wiring only. Collect the ToolDefinition beans, build the catalogue, bind the properties, order
      the guard chain, run the Flyway migrations, and register the management controllers when that
      module is present and switched on. No controllers of its own - neither jmouse-access-spring-boot
      nor jmouse-storage-spring-boot ships one, and for the same reason: a library controller cannot
      know a product's error model, its authorization annotation or its admin route conventions.

      The satellite modules are optional so a product pays only for what it takes: tools without a
      model provider, a provider without MCP, MCP without an access engine.
    -->
    <dependencies>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-provider</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-conversation</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-mcp</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-access</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-jpa</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai-management</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
