<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-spring</artifactId>
        <version>1.0.0-b20260902</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jmouse-script-spring-boot</artifactId>
    <packaging>jar</packaging>
    <name>jMouse - Script Spring Boot Starter</name>
    <description>Spring Boot auto-configuration for jMS rules: the stage registry and dispatcher, the
        document store and its index, the event bridge, and the library's own schema migration
    </description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-spring/jmouse-script-spring-boot</url>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- Compiled against Boot 4, which is what the products adopting this run. Every Spring type
             used here is unchanged between 3.3 and 4.x, so the jar still works on a Boot 3
             application. Boot's own Flyway classes are deliberately NOT referenced: those did move
             package in 4, and ordering is expressed by bean name instead. -->
        <spring-boot.version>4.0.7</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The language and the mechanism. Both required: this module is the adapter and contributes
             no mechanism of its own. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-script-el</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-script</artifactId>
        </dependency>

        <!-- The store — optional, because a product may hold its rules somewhere else entirely and
             supply its own ScriptDocuments. The store's beans are conditional on this being present. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-script-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ⚠️ Not optional-with-a-fallback. The dispatcher's observation verb MUST run in a
             transaction of its own, and there is no way to express that without spring-tx. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ⚠️ For SharedEntityManagerCreator: Boot registers an EntityManagerFactory and never a
             plain EntityManager, so the store's beans would otherwise fail to wire in any application
             that has JPA. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-orm</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ⚠️ Optional, and the migration auto-configuration is @ConditionalOnClass over it: a
             product that creates these two tables some other way must not inherit a migration tool
             for the privilege. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
