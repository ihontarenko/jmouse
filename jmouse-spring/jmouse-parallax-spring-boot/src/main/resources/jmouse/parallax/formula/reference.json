{
  "summary": "jMF is the formula language every Parallax object is written in: ordinary mathematical notation with power as ^, implicit multiplication, your own functions, sums, products, integrals, exact derivatives and cases. A formula is a document — definitions first, separated by ';', then the formula.",
  "notation": [
    {"construct": "Number", "written": "42  -3.5  .5  6.022e23", "example": "6.022e23 * n", "note": ""},
    {"construct": "Addition, subtraction", "written": "+  -", "example": "x + y - 1", "note": "− (U+2212) reads as -"},
    {"construct": "Multiplication", "written": "*  ·  ×", "example": "2 * x", "note": ""},
    {"construct": "Implicit multiplication", "written": "juxtaposition", "example": "2x,  3(x + 1),  π r^2", "note": "Two letters need a space: ab is one name"},
    {"construct": "Division", "written": "/  ÷", "example": "1 / (1 + x^2)", "note": ""},
    {"construct": "Remainder", "written": "%", "example": "n % 7", "note": "Same as mod(n, 7)"},
    {"construct": "Power", "written": "^  **  superscripts", "example": "x^2,  x²,  2^-x", "note": "Right-associative; -x^2 is -(x^2)"},
    {"construct": "Factorial", "written": "trailing !", "example": "n!,  (n + 1)!", "note": "Γ(n + 1), defined for real n"},
    {"construct": "Comparison", "written": "<  <=  >  >=  ==  !=  ≤  ≥  ≠", "example": "x^2 + y^2 <= 1", "note": "Value 1 or 0"},
    {"construct": "Logic", "written": "and  or  !", "example": "x > 0 and y > 0", "note": "&&, ||, ∧, ∨, ¬ also read"},
    {"construct": "Ternary", "written": "c ? a : b", "example": "x > 0 ? sqrt(x) : 0", "note": ""},
    {"construct": "Equation", "written": "lhs = rhs", "example": "x^2 + y^2 = r^2", "note": "Value is lhs - rhs; one = only"},
    {"construct": "Function definition", "written": "name(p, q) = body", "example": "bump(u, s) = exp(-u^2 / (2 s^2))", "note": "Lexically scoped, no recursion"},
    {"construct": "Local name", "written": "name = body", "example": "r = sqrt(x^2 + y^2)", "note": "A definition without parameters"},
    {"construct": "Comment", "written": "# …", "example": "x^2  # a parabola", "note": "In files and multi-line documents"}
  ],
  "forms": [
    {"name": "sum", "signature": "sum(k, from, to, term)", "example": "sum(k, 1, n, k^2)", "description": "Sum over the integers from ⌈from⌉ to ⌊to⌋; k is bound, to may be inf."},
    {"name": "product", "signature": "product(k, from, to, factor)", "example": "product(k, 1, inf, 4k^2 / (4k^2 - 1))", "description": "Product over a range; an empty range is 1."},
    {"name": "integral", "signature": "integral(t, lower, upper, integrand)", "example": "integral(t, 0, x, exp(-t^2))", "description": "Definite integral by adaptive quadrature; bounds may be infinite or depend on free names."},
    {"name": "diff", "signature": "diff(f, x) · diff(f, x, n)", "example": "diff(exp(-x^2), x, 2)", "description": "Exact symbolic derivative of order 1–8, taken once when the formula is read."},
    {"name": "if", "signature": "if(c, a, b) · if(c, a)", "example": "if(abs(x) <= 1, 1, 0)", "description": "A choice; without the third argument the value is undefined where c fails."},
    {"name": "piecewise", "signature": "piecewise(c₁, v₁, c₂, v₂, …, otherwise)", "example": "piecewise(x < 0, -1, x < 1, 0, 1)", "description": "The first branch whose condition holds; an odd last argument is the otherwise."}
  ],
  "precedence": ["postfix  n!", "power  ^ **", "unary  -x", "multiplicative  * / % and juxtaposition", "additive  + -", "relation  < <= > >= == !=", "not  !", "and", "or", "ternary  ? :", "equation  ="],
  "functions": {
    "sin": "Sine", "cos": "Cosine", "tan": "Tangent", "cot": "Cotangent", "sec": "Secant", "csc": "Cosecant",
    "asin": "Inverse sine", "acos": "Inverse cosine", "atan": "Inverse tangent", "atan2": "Angle of the point (x, y) — atan2(y, x)",
    "sinh": "Hyperbolic sine", "cosh": "Hyperbolic cosine", "tanh": "Hyperbolic tangent",
    "asinh": "Inverse hyperbolic sine", "acosh": "Inverse hyperbolic cosine", "atanh": "Inverse hyperbolic tangent",
    "exp": "Exponential eˣ", "ln": "Natural logarithm", "log10": "Logarithm base 10", "log2": "Logarithm base 2",
    "sqrt": "Square root", "cbrt": "Cube root", "abs": "Absolute value, or modulus of a complex number",
    "sign": "Sign: −1, 0 or 1", "floor": "Greatest integer not above", "ceil": "Least integer not below", "round": "Nearest integer",
    "step": "Heaviside step: 1 for x ≥ 0", "min": "Smaller of two", "max": "Larger of two", "mod": "Remainder, non-negative for a positive divisor",
    "hypot": "√(a² + b²) without overflow", "pow": "Power aᵇ", "re": "Real part", "im": "Imaginary part", "arg": "Argument (phase)",
    "conj": "Complex conjugate", "gamma": "Gamma function Γ(x)", "factorial": "Factorial Γ(x + 1)", "binomial": "Binomial coefficient",
    "erf": "Error function"
  },
  "constants": {
    "pi": "Ratio of a circle's circumference to its diameter", "tau": "Full turn, 2π", "e": "Base of the natural logarithm",
    "phi": "Golden ratio (1 + √5) / 2", "inf": "Infinity, for bounds of sums and integrals"
  },
  "objectKinds": [
    {"variables": "x", "kind": "EXPLICIT_CURVE", "description": "y = f(x) over an interval"},
    {"variables": "x, y", "kind": "EXPLICIT_SURFACE", "description": "z = f(x, y) over a rectangle"},
    {"variables": "x, y, z", "kind": "IMPLICIT_SURFACE", "description": "The zero set f(x, y, z) = 0"},
    {"variables": "x, y, z, w", "kind": "IMPLICIT_HYPERSURFACE", "description": "A 4-D zero set, seen through 3-D slices"},
    {"variables": "z  or  i", "kind": "COMPLEX_MAPPING", "description": "A mapping of the complex plane"},
    {"variables": "n", "kind": "SEQUENCE", "description": "Terms aₙ of a sequence"},
    {"variables": "none", "kind": "VALUE", "description": "One number; its other names become sliders"}
  ]
}
