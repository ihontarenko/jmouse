<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-spring</artifactId>
        <version>1.0.0-b20260802</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jmouse-storage-management</artifactId>
    <packaging>jar</packaging>
    <name>jMouse - Storage Management</name>
    <description>jMouse Framework - The file endpoints and the storage administration surface, shipped once instead of per product</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-spring/jmouse-storage-management</url>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- Compiled against Boot 4, which is what the products adopting this run. Every Spring type
             used here — @AutoConfiguration, the @ConditionalOn* family, Environment, MultipartFile,
             ResponseEntity — is unchanged between 3.3 and 4.x, so the jar still works on a Boot 3
             application. Boot's own Flyway classes are deliberately NOT referenced: those did move
             package in 4, and ordering is expressed by bean name instead. -->
        <spring-boot.version>4.0.7</spring-boot.version>
        <flyway.version>11.7.2</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The library being integrated. Only the core is required; the rest are optional so a
             product pays for exactly the pieces it configures. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-storage-spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-files-jpa</artifactId>
        </dependency>
        <!-- The authorization vocabulary these controllers are gated in.

             ⚠️ NOT optional any more. It was, on the reasoning that a product using this module from its
             own controllers need not carry the engine — but every product that adopts files then has to
             write the directory scope, its hierarchy and the composite for two trees by hand, and each
             one lands on the same two startup failures getting there. Carrying the engine is cheaper
             than three products rediscovering that. Ivan's call, 2026-08-19. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-enforcement</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Transaction demarcation for the scheduled sweep, and scheduling itself. Optional: an
             application with no transaction manager gets every other bean and simply no sweep. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Servlet API, for reading a delivery intent off a request. Provided by the container. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
