  <description>jMouse Framework - Every Parallax REST route (catalogue, computation, documents, formulas, subjects, scenes, collections and the machinery's administration) at /jmouse/parallax/api, with the access rules a product gates them by and the problem documents they answer with</description>
  <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-spring/jmouse-parallax-management</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>http://www.opensource.org/licenses/mit-license.php</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ihontarenko</id>
      <name>Ivan Hontarenko</name>
      <email>ihontarenko@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ihontarenko/jmouse.git/jmouse-spring/jmouse-parallax-management</connection>
    <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git/jmouse-spring/jmouse-parallax-management</developerConnection>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-core/jmouse-spring/jmouse-parallax-management</url>
