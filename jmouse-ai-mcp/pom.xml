<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.0-b20260802</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <packaging>jar</packaging>
    <artifactId>jmouse-ai-mcp</artifactId>
    <name>jMouse - AI MCP</name>
    <description>jMouse Framework - Model Context Protocol server and client over the tool catalogue</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-ai-mcp</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ihontarenko</id>
            <name>Ivan Hontarenko</name>
            <email>ihontarenko@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
        <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
        <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-ai-mcp</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>

    <!--
      The one module allowed to see the Model Context Protocol SDK, so that every other module can be
      used by a product that has never heard of MCP.

      SETTLED (ticket 07): the raw SDK, not Spring AI's starter. Spring AI's would drag Spring Boot 4
      and a servlet stack in with it; this one is transport-agnostic and Spring-free, so the module can
      be pinned independently and used outside Spring. It also ships the servlet transports, so
      "wire a transport ourselves" turned out to mean choose one - which jmouse-ai-spring-boot does in
      ticket 10 - rather than write one.
    -->
    <dependencies>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!--
          ⚠️ LOAD-BEARING FOR AUTHENTICATION, despite reading as an observability extra, and NOT optional
          for the same reason: it has to reach the product, and the product is exactly who must not have
          to know about it.

          The SDK's servlet transports answer a request through Reactor, so a tool runs on a different
          thread than the one the product authenticated on. reactor-core declares this artifact OPTIONAL,
          which makes Hooks.enableAutomaticContextPropagation() a SILENT NO-OP without it — the caller
          stays behind, every tool call is refused as NO_CALLER, and the credential looks at fault.
          See McpCallerPropagation.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Architecture rules only, and this is the module they are all about: the protocol SDK is
             confined here, so the rule stating it lives beside the one module allowed to see it. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
