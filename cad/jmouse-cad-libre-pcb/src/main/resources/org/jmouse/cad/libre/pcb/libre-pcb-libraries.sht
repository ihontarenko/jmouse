# How a drawing converted from a LibrePCB project is filed, and where each of its layers goes.
# A LibrePCB project carries its library inside it: a converted drawing is the project's, it names no holder and no terms.
# A layer not named here — a part's names and values, grab areas — says nothing of what is made, and is left out.
sheet "LibrePCB libraries" as libre-pcb-libraries {
    description "Where a LibrePCB project's converted documents are filed, and what each of its layers is to us."

    # Where a converted drawing is filed, and the tags it carries.
    category circuits
    # The symbols, footprints, 3D models and components an import brings of this program's library: filed apart, as its own.
    library-category librepcb
    symbol-tags electronics, schematic, librepcb
    footprint-tags electronics, librepcb, footprint
    component-tags electronics, librepcb
    circuit-tags electronics, librepcb

    # The symbol each mark of a sheet is drawn with — where its terminal stands.
    mark-symbols ground = ground-symbol, common = common-symbol, label = net-label-symbol, port = port-label-symbol, global = global-label-symbol

    # The net that is a design's reference ground, node 0.
    ground GND

    # How far apart a project's sheets are laid, side by side on the one circuit their nets make.
    sheet-gap 50.8 mm

    # LibrePCB's grid on a sheet, 0.1 inch: a sheet's edge stays on it, so every pin does.
    sheet-grid 2.54 mm

    # How far apart the lines of a board's words stand, as a share of their height: LibrePCB's own for its stroke font.
    text-line-spacing 1.48

    # How long a sheet's transient runs until its author says.
    transient 20 ms

    # The way of making a pcb a board's design rules change, and which of their checks is which of our rules.
    pcb-rules standard
    pcb-rule-names clearance = min_copper_copper_clearance, edge-clearance = min_copper_board_clearance, least-track-width = min_copper_width, least-drill = min_pth_drill_diameter, least-via-ring = min_annular_ring, hole-clearance = min_drill_drill_clearance
    pcb-class-opening class_

    silkscreen "What is printed on the pcb, front and back" {
        libre-pcb "top_legend", "bot_legend"
    }
    fabrication "What the assembly drawing shows" {
        libre-pcb "top_documentation", "bot_documentation", "top_package_outlines", "bot_package_outlines"
    }
    courtyard "The space the part keeps clear around it" {
        libre-pcb "top_courtyard", "bot_courtyard"
    }
    mask "A window in the solder mask, besides what the pads open" {
        libre-pcb "top_stop_mask", "bot_stop_mask"
    }
    paste "Solder paste, besides what the pads take" {
        libre-pcb "top_solder_paste", "bot_solder_paste"
    }
    adhesive "The glue that holds a part while it is soldered" {
        libre-pcb "top_glue", "bot_glue"
    }
    documentation "A drawing of the pcb, which no factory makes" {
        libre-pcb "brd_documentation", "brd_measures", "brd_alignment", "brd_guide"
    }
    comments "A note on the pcb, which no factory makes" {
        libre-pcb "brd_comments"
    }
    copper "Copper drawn besides the pads" {
        libre-pcb "top_cu", "bot_cu"
    }
}
