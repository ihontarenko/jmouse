symbol:capacitor-symbol("Capacitor") {
    meta {
        summary: "Capacitor, as drawn on a schematic: a level between its plates says how charged it is against its rating, warming close to it"
        code: "SY.CAPACITOR:FIXED"
        category: capacitors
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(120 x 80)
    input:charge(-1 .. 1, hold: 200 ms)
    input:failed

    group:body(live) {
        path("M-60 0H-10M10 0H60")
        live stroke = if(failed > 0.5, burned, signal)
    }

    # How full it is: between its plates, a level as high as the voltage across against its rating — which, at its
    # capacitance, is its charge against the charge it is made to hold. It warms close to the rating.
    box:charge_level(live, at: 0 0, size: 18 x 52) {
        live level = absolute(charge)
        live fill = if(absolute(charge) > 0.8, warm, signal)
    }

    path:plate_a(live, "M-10-28V28") {
        live stroke = if(failed > 0.5, burned, signal)
    }

    path:plate_b(live, "M10-28V28") {
        live stroke = if(failed > 0.5, burned, signal)
    }

    layer(live, failed > 0.5) {
        path:scorch("M-14-18L-6-6M12-16L4-4M-12 16L-4 6M14 18L6 6M-20 0H-10M20 0H10")
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin:a(at: -60 0)
    pin:b(at: 60 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
