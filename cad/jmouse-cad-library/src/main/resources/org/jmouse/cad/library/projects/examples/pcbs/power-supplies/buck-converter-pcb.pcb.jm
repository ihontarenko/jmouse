# Buck converter laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:buck-converter-pcb("Buck converter — pcb") {
    meta {
        summary: "Buck converter laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: power-supplies
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(buck-converter)
    layers(2)
    edge("M1 0H34A1 1 0 0 1 35 1V24A1 1 0 0 1 34 25H1A1 1 0 0 1 0 24V1A1 1 0 0 1 1 0Z")
    place(Q1, at: 13.5 9, rotate: 90)
    place(D1, at: 20 14.5, rotate: 90)
    place(L1, at: 26 8.5)
    place(C1, at: 26.5 14.5, rotate: 270)
    place(RL, at: 30.5 14.5, rotate: 270)
    place(J1, footprint: "FP.HDR:1X5-P2.54-V", nets: [0: 1, gate: 2, out: 3, switch: 4, vin: 5], at: 5.5 11.5)
    track(top, width: 0.25, from: 26.5 15.35, to: 30.35 15.35, to: 30.5 15.5)
    track(top, width: 0.25, from: 26.5 13.65, to: 30.35 13.65, to: 30.5 13.5)
    track(top, width: 0.25, from: 26.85 8.5, to: 26.85 13.3, to: 26.5 13.65)
    track(top, width: 0.25, from: 13.5 9, to: 5.54 9, to: 5.5 8.96)
    track(top, width: 0.25, from: 13.5 11.54, to: 8 11.54, to: 5.5 14.04)
    track(top, width: 0.25, from: 20 9.42, to: 20.57 9.42, to: 26.5 15.35)
    track(bottom, width: 0.25, from: 13.5 11.54, to: 13.5 13.08, to: 20 19.58)
    track(top, width: 0.25, from: 13.5 11.54, to: 17.1 7.94, to: 24.59 7.94, to: 25.15 8.5)
    track(bottom, width: 0.25, from: 13.5 6.46, to: 7.2 12.76, to: 7.2 14.88, to: 5.5 16.58)
    track(top, width: 0.25, from: 26.5 13.65, to: 30.55 13.65, to: 32.35 15.45, to: 29.65 18.15, to: 4 18.15, to: 4 13, to: 5.5 11.5)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H34.5V24.5H0.5Z")
}
