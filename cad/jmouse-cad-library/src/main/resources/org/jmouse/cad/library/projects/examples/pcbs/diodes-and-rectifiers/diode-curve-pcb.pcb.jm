# Diode and resistor laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:diode-curve-pcb("Diode and resistor — pcb") {
    meta {
        summary: "Diode and resistor laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: diodes-and-rectifiers
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(diode-curve)
    layers(2)
    edge("M1 0H25A1 1 0 0 1 26 1V17A1 1 0 0 1 25 18H1A1 1 0 0 1 0 17V1A1 1 0 0 1 1 0Z")
    place(R1, at: 16 5.5)
    place(D1, at: 21.5 9, rotate: 270)
    place(J1, footprint: "HDR:1X3-P2.54-V:F", nets: [0: 1, anode: 2, top: 3], at: 5.5 7.5)
    track(top, width: 0.25, from: 17 5.5, to: 21.5 10, to: 21.5 12.81)
    track(top, width: 0.25, from: 15 5.5, to: 10.04 5.5, to: 5.5 10.04)
    track(top, width: 0.25, from: 17 5.5, to: 15.65 4.15, to: 9.35 4.15, to: 6 7.5, to: 5.5 7.5)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H25.5V17.5H0.5Z")
}
