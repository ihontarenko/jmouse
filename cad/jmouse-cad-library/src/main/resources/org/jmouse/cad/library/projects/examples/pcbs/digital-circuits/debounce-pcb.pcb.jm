# RC and Schmitt trigger: debouncing laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:debounce-pcb("RC and Schmitt trigger: debouncing — pcb") {
    meta {
        summary: "RC and Schmitt trigger: debouncing laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: digital-circuits
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(debounce)
    layers(2)
    edge("M1 0H24A1 1 0 0 1 25 1V14A1 1 0 0 1 24 15H1A1 1 0 0 1 0 14V1A1 1 0 0 1 1 0Z")
    place(R1, at: 13 4)
    place(C1, at: 15 8.5, rotate: 270)
    place(U1, at: 19.5 5)
    place(J1, footprint: "FP.HDR:1X3-P2.54-V", nets: [0: 1, raw: 2, vcc: 3], at: 5.5 7.5)
    track(top, width: 0.25, from: 14 4, to: 14 6.65, to: 15 7.65)
    track(top, width: 0.25, from: 15 7.65, to: 17.65 5, to: 18.65 5)
    track(top, width: 0.25, from: 15 9.35, to: 15 9.3, to: 18.65 5.65)
    track(top, width: 0.25, from: 12 4, to: 9.3 4, to: 5.65 7.65, to: 5.5 7.5)
    track(top, width: 0.25, from: 15 9.35, to: 10.05 9.35)
    track(bottom, width: 0.25, from: 10.05 9.35, to: 9.89 9.35, to: 5.5 4.96)
    track(top, width: 0.25, from: 20.35 4.35, to: 21.7 5.7, to: 16.75 10.65, to: 6.11 10.65, to: 5.5 10.04)
    via(at: 10.05 9.35, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H24.5V14.5H0.5Z")
}
