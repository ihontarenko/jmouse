# MOSFET as a switch laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:mosfet-switch-pcb("MOSFET as a switch — pcb") {
    meta {
        summary: "MOSFET as a switch laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: transistors-as-switches
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(mosfet-switch)
    layers(2)
    edge("M1 0H33A1 1 0 0 1 34 1V20A1 1 0 0 1 33 21H1A1 1 0 0 1 0 20V1A1 1 0 0 1 1 0Z")
    place(RG, at: 20 9)
    place(RL, at: 25.5 6, rotate: 270)
    place(Q1, at: 24.5 14.5)
    place(J1, footprint: "FP.HDR:1X4-P2.54-V", nets: [0: 1, drain: 2, drive: 3, top: 4], at: 5.5 9)
    track(top, width: 0.25, from: 21 9, to: 24.5 12.5, to: 24.5 14.5)
    track(top, width: 0.25, from: 25.5 7, to: 27.04 8.54, to: 27.04 14.5)
    track(top, width: 0.25, from: 19 9, to: 6.77 9, to: 5.5 10.27)
    track(top, width: 0.25, from: 25.5 7, to: 24.77 7.73, to: 5.5 7.73)
    track(top, width: 0.25, from: 25.5 5, to: 13.35 5)
    track(bottom, width: 0.25, from: 13.35 5, to: 13.31 5, to: 5.5 12.81)
    via(at: 13.35 5, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H33.5V20.5H0.5Z")
}
