model:to-126-3-vertical-model("TO-126 (SOT-32), standing") {
    meta {
        summary: "TO-126 (SOT-32), standing — its body drawn by jmCAD from the footprint and its package table"
        code: "TO126:3-V:M3D"
        category: through-hole-transistor-outline
        tags: electronics, model, inline
        source: "JEDEC TO-126"
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    box(plastic, size: [8, 3, 10], at: [0, 0, 6])
    box(tin, size: [0.91, 0.91, 2.6], at: [-2.28, 0, -0.3])
    box(tin, size: [0.91, 0.91, 2.6], at: [0, 0, -0.3])
    box(tin, size: [0.91, 0.91, 2.6], at: [2.28, 0, -0.3])
    marking(name, on: flat, size: [6.4, 3], at: [0, 1.51, 6], rotate: [90, 0, 180], ink: marking)
}
