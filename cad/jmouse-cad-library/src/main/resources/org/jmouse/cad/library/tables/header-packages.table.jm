# A terminal block's pin is round: `thickness 0`, its hole drilled for its diameter.
# Pin headers, sockets and screw terminal blocks by pitch: square leads on a grid, every row count with every pin count of the ranges. A member
# is named `<name>-<rows>x<pins>-pitch-<pitch in hundredths of a millimetre>-vertical`.
# `body-height` is the most a header, a socket or a terminal block stands over the pcb: its housing with the pins
# over it, as the makers' standard parts are (a 2.54 mm header 8.5 mm: 2.5 mm of housing, 6 mm of pin).
table:header-packages("Header packages") {
    meta {
        summary: "Pin headers and sockets, square leads on a grid."
        category: tables
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }

    form header

    pin-header "Pin header, 2.54 mm pitch" source standard "IEC 60603-13 grid" {
        body-height 8.5 mm
        name pin-header
        pitch 2.54 mm
        lead 0.64 mm
        thickness 0.64 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "HDR:{rows}X{pins}-P{pitch|mm}-{standing|initial}"
    }

    pin-socket "Pin socket, 2.54 mm pitch" source standard "IEC 60603-13 grid" {
        body-height 8.5 mm
        name pin-socket
        pitch 2.54 mm
        lead 0.64 mm
        thickness 0.64 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "SKT:{rows}X{pins}-P{pitch|mm}-{standing|initial}"
    }

    pin-header-2-00 "Pin header, 2.00 mm pitch" source standard "IEC 60603-13 grid" {
        body-height 6.1 mm
        name pin-header
        pitch 2 mm
        lead 0.5 mm
        thickness 0.5 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "HDR:{rows}X{pins}-P{pitch|mm}-{standing|initial}"
    }

    pin-socket-2-00 "Pin socket, 2.00 mm pitch" source standard "IEC 60603-13 grid" {
        body-height 6.4 mm
        name pin-socket
        pitch 2 mm
        lead 0.5 mm
        thickness 0.5 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "SKT:{rows}X{pins}-P{pitch|mm}-{standing|initial}"
    }

    pin-header-1-27 "Pin header, 1.27 mm pitch" source standard "IEC 60603-13 grid" {
        body-height 4.4 mm
        name pin-header
        pitch 1.27 mm
        lead 0.4 mm
        thickness 0.4 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "HDR:{rows}X{pins}-P{pitch|mm}-{standing|initial}"
    }

    pin-socket-1-27 "Pin socket, 1.27 mm pitch" source standard "IEC 60603-13 grid" {
        body-height 4.4 mm
        name pin-socket
        pitch 1.27 mm
        lead 0.4 mm
        thickness 0.4 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "SKT:{rows}X{pins}-P{pitch|mm}-{standing|initial}"
    }

    terminal-block-5-00 "Screw terminal block, 5.00 mm pitch" source standard "IEC 60947-7-1 terminal blocks, the makers' pin sizes" {
        body-height 10 mm
        name terminal-block
        pitch 5 mm
        lead 1.1 mm
        thickness 0 mm
        rows 1
        pins 2 .. 12
        body-depth 7.6 mm
        standing horizontal
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "TB:{pins}-P{pitch|mm}"
    }

    terminal-block-5-08 "Screw terminal block, 5.08 mm pitch" source standard "IEC 60947-7-1 terminal blocks, the makers' pin sizes" {
        body-height 10 mm
        name terminal-block
        pitch 5.08 mm
        lead 1.1 mm
        thickness 0 mm
        rows 1
        pins 2 .. 12
        body-depth 7.6 mm
        standing horizontal
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "TB:{pins}-P{pitch|mm}"
    }

    terminal-block-3-50 "Screw terminal block, 3.50 mm pitch" source standard "IEC 60947-7-1 terminal blocks, the makers' pin sizes" {
        body-height 8.5 mm
        name terminal-block
        pitch 3.5 mm
        lead 0.9 mm
        thickness 0 mm
        rows 1
        pins 2 .. 12
        body-depth 7 mm
        standing horizontal
        folder "electromechanical/connectors/through-hole"
        category connectors-through-hole
        designation "TB:{pins}-P{pitch|mm}"
    }
}
