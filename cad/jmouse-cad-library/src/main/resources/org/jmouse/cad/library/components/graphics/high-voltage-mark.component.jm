component:high-voltage-mark("High voltage mark") {
    meta {
        designator: G
        summary: "A warning triangle with a bolt: dangerous voltage on this part of the board: printed on the board, nothing to buy"
        category: graphics
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    footprint("GRAPHIC:HIGH-VOLTAGE-10:F")
    footprint("GRAPHIC:HIGH-VOLTAGE-5:F")
    footprint("GRAPHIC:HIGH-VOLTAGE-20:F")

    symbol(uses: "GRAPHIC:HIGH-VOLTAGE:S") {
    }
}
