symbol:polarized-capacitor-symbol("Polarized capacitor") {
    meta {
        summary: "Electrolytic capacitor, as drawn on a schematic: a level between its plates says how charged it is against its rating, burning hot if charged the wrong way round"
        code: "SY.CAPACITOR:POLARIZED"
        category: capacitors
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(120 x 80)
    input:charge(-1 .. 1, hold: 200 ms)
    input:failed

    group:body(live) {
        path("M-60 0H-10M8 0H60M-36-26H-20M-28-34V-18")
        live stroke = if(failed > 0.5, burned, signal)
    }

    # How charged it is, as a capacitor holds a charge: on its plates — each in its sign's colour, thicker as it fills, the charge
    # being the voltage across against its rating —, and in the field between them, its lines coming in with the charge, warming
    # close to the rating. Charged the wrong way round, an electrolytic is hurt: its plates and its field light hot at once.
    path:field(live, "M-6-18H6M-6 0H3M-6 18H6") {
        live opacity = absolute(charge)
        live stroke = if(charge < -0.02, hot, if(absolute(charge) > 0.8, warm, signal))
        thickness = 0.5
    }

    path:plate_a(live, "M-10-28V28") {
        live stroke = if(failed > 0.5, burned, if(charge < -0.02, hot, if(charge > 0.02, positive, signal)))
        live thickness = 1 + 0.9 * absolute(charge)
    }

    path:plate_b(live, "M14-28Q0 0 14 28") {
        live stroke = if(failed > 0.5, burned, if(charge < -0.02, hot, if(charge > 0.02, negative, signal)))
        live thickness = 1 + 0.9 * absolute(charge)
    }

    layer(live, failed > 0.5) {
        path:scorch("M-14-18L-6-6M12-16L4-4M-12 16L-4 6M14 18L6 6M-20 0H-10M20 0H10")
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin:a(at: -60 0)
    pin:b(at: 60 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
