# Series resonance laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:series-resonance-pcb("Series resonance — pcb") {
    meta {
        summary: "Series resonance laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: resonance
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(series-resonance)
    layers(2)
    edge("M1 0H24A1 1 0 0 1 25 1V12A1 1 0 0 1 24 13H1A1 1 0 0 1 0 12V1A1 1 0 0 1 1 0Z")
    place(L1, at: 11 5.5)
    place(C1, at: 16.5 5.5)
    place(R1, at: 21 8, rotate: 270)
    place(J1, footprint: "FP.HDR:1X2-P2.54-V", nets: [0: 1, in: 2], at: 5.5 6.5)
    track(top, width: 0.25, from: 21 9, to: 21 10.05)
    track(top, width: 0.25, from: 11.85 5.5, to: 15.65 5.5)
    track(top, width: 0.25, from: 17.35 5.5, to: 19.5 5.5, to: 21 7)
    track(top, width: 0.25, from: 10.15 5.5, to: 7.9 5.5, to: 5.65 7.75, to: 5.52 7.75, to: 5.5 7.77)
    via(at: 21 10.05, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H24.5V12.5H0.5Z")
}
