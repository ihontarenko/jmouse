footprint:static-sensitive-5mm-footprint("Static sensitive, 5 mm") {
    meta {
        summary: "A warning triangle with a struck-out hand: handle against electrostatic discharge, printed 5 mm wide"
        code: "FP.GRAPHIC:STATIC-SENSITIVE-5"
