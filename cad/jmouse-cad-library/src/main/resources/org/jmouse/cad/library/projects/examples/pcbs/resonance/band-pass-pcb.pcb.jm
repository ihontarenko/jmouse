# RLC band-pass filter laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:band-pass-pcb("RLC band-pass filter — pcb") {
    meta {
        summary: "RLC band-pass filter laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: resonance
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(band-pass)
    layers(2)
    edge("M1 0H23A1 1 0 0 1 24 1V12A1 1 0 0 1 23 13H1A1 1 0 0 1 0 12V1A1 1 0 0 1 1 0Z")
    place(R1, at: 11 5)
    place(L1, at: 16 7.5, rotate: 270)
    place(C1, at: 20 7.5, rotate: 270)
    place(J1, footprint: "HDR:1X2-P2.54-V:F", nets: [0: 1, in: 2], at: 5.5 6.5)
    track(top, width: 0.25, from: 16 8.35, to: 16 9.55)
    track(top, width: 0.25, from: 20 8.35, to: 20 9.55)
    track(top, width: 0.25, from: 16 6.65, to: 20 6.65)
    track(top, width: 0.25, from: 12 5, to: 14.35 5, to: 16 6.65)
    track(top, width: 0.25, from: 10 5, to: 7.23 7.77, to: 5.5 7.77)
    via(at: 16 9.55, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    via(at: 20 9.55, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H23.5V12.5H0.5Z")
}
