component:lead-free-mark("Lead free mark") {
    meta {
        designator: G
        summary: "Pb struck out: made without lead: printed on the board, nothing to buy"
        category: graphics
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    footprint("GRAPHIC:LEAD-FREE-10:F")
    footprint("GRAPHIC:LEAD-FREE-5:F")
    footprint("GRAPHIC:LEAD-FREE-20:F")

    symbol(uses: "GRAPHIC:LEAD-FREE:S") {
    }
}
