model:pin-header-2x2-pitch-200-vertical-model("Pin header, 2.00 mm pitch, 2 × 2, vertical") {
    meta {
        summary: "Pin header, 2.00 mm pitch, 2 × 2, vertical — its body drawn by jmCAD from the footprint and its package table"
        code: "MD.HDR:2X2-P2-V"
        category: connectors-through-hole
        tags: electronics, model, header
        source: "IEC 60603-13 grid"
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    box(housing, size: [4, 4, 2.5], at: [0, 0, 1.25])
    box(gold, size: [0.64, 0.64, 9.1], at: [-1, 1, 1.55])
    box(gold, size: [0.64, 0.64, 9.1], at: [1, 1, 1.55])
    box(gold, size: [0.64, 0.64, 9.1], at: [-1, -1, 1.55])
    box(gold, size: [0.64, 0.64, 9.1], at: [1, -1, 1.55])
}
