model:sot-23-model("SOT-23, 1.3 mm body") {
    meta {
        summary: "SOT-23, 1.3 mm body — its body drawn by jmCAD from the footprint and its package table"
        code: "MD.SOT23:3"
        category: surface-transistor-outline
        tags: electronics, model, gull-wing
        source: "JEDEC TO-236 AB, the makers' tighter outline (Nexperia SOT23)"
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    box(plastic, size: [1.3, 2.92, 0.5], at: [0, 0, 0.35])
    box(plastic, size: [1.14, 2.76, 0.5], at: [0, 0, 0.85])
    cylinder(dimple, radius: 0.25, length: 0.01, at: [-0.07, 0.88, 1.105])
    marking(name, on: flat, size: [0.91, 0.39], at: [0, 0, 1.11], ink: marking)
    box(tin, size: [0.25, 0.36, 0.2], at: [-0.775, 0.95, 0.6])
    box(tin, size: [0.2, 0.36, 0.6], at: [-0.9, 0.95, 0.3])
    box(tin, size: [0.375, 0.36, 0.2], at: [-1.087, 0.95, 0.1])
    box(tin, size: [0.25, 0.36, 0.2], at: [-0.775, -0.95, 0.6])
    box(tin, size: [0.2, 0.36, 0.6], at: [-0.9, -0.95, 0.3])
    box(tin, size: [0.375, 0.36, 0.2], at: [-1.087, -0.95, 0.1])
    box(tin, size: [0.25, 0.36, 0.2], at: [0.775, 0, 0.6])
    box(tin, size: [0.2, 0.36, 0.6], at: [0.9, 0, 0.3])
    box(tin, size: [0.375, 0.36, 0.2], at: [1.088, 0, 0.1])
}
