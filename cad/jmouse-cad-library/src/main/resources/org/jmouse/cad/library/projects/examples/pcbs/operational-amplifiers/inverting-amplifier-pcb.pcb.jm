# Inverting amplifier laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:inverting-amplifier-pcb("Inverting amplifier — pcb") {
    meta {
        summary: "Inverting amplifier laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: operational-amplifiers
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(inverting-amplifier)
    layers(2)
    edge("M1 0H29A1 1 0 0 1 30 1V17A1 1 0 0 1 29 18H1A1 1 0 0 1 0 17V1A1 1 0 0 1 1 0Z")
    place(RI, at: 11.5 9)
    place(RF, at: 18.5 4)
    place(U1, at: 19.5 9.5)
    place(RL, at: 26 12.5, rotate: 270)
    place(J1, footprint: "HDR:1X4-P2.54-V:F", nets: [0: 1, in: 2, vn: 3, vp: 4], at: 5.5 9)
    track(top, width: 0.25, from: 17.05 10.135, to: 18.65 10.135)
    track(top, width: 0.25, from: 26 13.5, to: 26 14.55)
    track(top, width: 0.25, from: 19.5 4, to: 17.05 6.45, to: 17.05 7.595)
    track(top, width: 0.25, from: 12.5 9, to: 16.915 9, to: 17.05 8.865)
    track(top, width: 0.25, from: 17.05 8.865, to: 15.7 8.865, to: 15.7 5.8, to: 17.5 4)
    track(top, width: 0.25, from: 10.5 9, to: 6.77 9, to: 5.5 7.73)
    track(top, width: 0.25, from: 17.05 7.595, to: 17.95 6.695, to: 22.9 6.695, to: 26 9.795, to: 26 11.5)
    track(top, width: 0.25, from: 17.05 11.405, to: 6.635 11.405, to: 5.5 10.27)
    track(top, width: 0.25, from: 21.95 7.595, to: 20.6 7.595, to: 20.6 9.845, to: 17.635 12.81, to: 5.5 12.81)
    via(at: 18.65 10.135, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    via(at: 26 14.55, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H29.5V17.5H0.5Z")
}
