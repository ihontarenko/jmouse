# Series resistors laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:series-resistors-pcb("Series resistors — pcb") {
    meta {
        summary: "Series resistors laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: ohms-and-kirchhoffs-laws
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(series-resistors)
    layers(2)
    edge("M1 0H23A1 1 0 0 1 24 1V17A1 1 0 0 1 23 18H1A1 1 0 0 1 0 17V1A1 1 0 0 1 1 0Z")
    place(R1, at: 12 8)
    place(R2, at: 17.5 7.5)
    place(R3, at: 20 12, rotate: 270)
    place(J1, footprint: "HDR:1X4-P2.54-V:F", nets: [0: 1, first: 2, second: 3, third: 4], at: 5.5 9)
    track(top, width: 0.25, from: 20 13, to: 20 14.05)
    track(top, width: 0.25, from: 13 8, to: 16 8, to: 16.5 7.5)
    track(top, width: 0.25, from: 18.5 7.5, to: 18.5 9.5, to: 20 11)
    track(top, width: 0.25, from: 11 8, to: 5.77 8, to: 5.5 7.73)
    track(top, width: 0.25, from: 13 8, to: 10.73 10.27, to: 5.5 10.27)
    track(top, width: 0.25, from: 18.5 7.5, to: 13.19 12.81, to: 5.5 12.81)
    via(at: 20 14.05, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H23.5V17.5H0.5Z")
}
