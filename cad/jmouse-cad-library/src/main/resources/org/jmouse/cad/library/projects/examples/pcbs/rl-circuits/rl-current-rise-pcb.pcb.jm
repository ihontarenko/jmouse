# Current rising in an RL circuit laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:rl-current-rise-pcb("Current rising in an RL circuit — pcb") {
    meta {
        summary: "Current rising in an RL circuit laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: rl-circuits
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(rl-current-rise)
    layers(2)
    edge("M1 0H31A1 1 0 0 1 32 1V19A1 1 0 0 1 31 20H1A1 1 0 0 1 0 19V1A1 1 0 0 1 1 0Z")
    place(SW1, at: 14.5 7.5)
    place(R1, at: 24 7.5)
    place(L1, at: 27.5 12, rotate: 270)
    place(J1, footprint: "HDR:1X5-P2.54-V:F", nets: [0: 1, coil: 2, feed: 3, in: 4, top: 5], at: 5.5 10)
    track(top, width: 0.25, from: 27.5 12.85, to: 27.5 14.05)
    track(top, width: 0.25, from: 25 7.5, to: 25 8.65, to: 27.5 11.15)
    track(top, width: 0.25, from: 10.69 7.5, to: 10.54 7.5, to: 5.5 12.54)
    track(top, width: 0.25, from: 18.31 7.5, to: 16.96 6.15, to: 9.35 6.15, to: 5.5 10)
    track(top, width: 0.25, from: 23 7.5, to: 15.42 15.08, to: 5.5 15.08)
    track(top, width: 0.25, from: 25 7.5, to: 23.2 5.7, to: 7.45 5.7, to: 5.595 7.555, to: 5.5 7.46)
    via(at: 27.5 14.05, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H31.5V19.5H0.5Z")
}
