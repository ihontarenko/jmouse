# Linear regulator: Zener and emitter follower laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:linear-regulator-pcb("Linear regulator: Zener and emitter follower — pcb") {
    meta {
        summary: "Linear regulator: Zener and emitter follower laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: power-supplies
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(linear-regulator)
    layers(2)
    edge("M1 0H41A1 1 0 0 1 42 1V25A1 1 0 0 1 41 26H1A1 1 0 0 1 0 25V1A1 1 0 0 1 1 0Z")
    place(RZ, at: 14.5 5, rotate: 270)
    place(D1, at: 13 15.5, rotate: 90)
    place(Q1, at: 22.5 11.5)
    place(RL, at: 26.5 18, rotate: 270)
    place(SW1, at: 36 16.5, rotate: 270)
    place(RL2, at: 30.5 20.5, rotate: 270)
    place(J1, footprint: "FP.HDR:1X4-P2.54-V", nets: [0: 1, collector: 2, out: 3, vin: 4], at: 5.5 12)
    track(top, width: 0.25, from: 26.5 19, to: 28 19, to: 30.5 21.5)
    track(top, width: 0.25, from: 36 20.31, to: 31.31 20.31, to: 30.5 19.5)
    track(top, width: 0.25, from: 25.04 11.5, to: 25.04 15.54, to: 26.5 17)
    track(top, width: 0.25, from: 14.5 6, to: 14.5 6.04, to: 19.96 11.5)
    track(top, width: 0.25, from: 26.5 17, to: 31.69 17, to: 36 12.69)
    track(bottom, width: 0.25, from: 19.96 11.5, to: 19.96 12.35, to: 13 19.31)
    track(top, width: 0.25, from: 14.5 4, to: 7.3 11.2, to: 7.3 14.01, to: 5.5 15.81)
    track(top, width: 0.25, from: 13 11.69, to: 20.31 19, to: 26.5 19)
    track(bottom, width: 0.25, from: 22.5 11.5, to: 22.5 9.7, to: 6.53 9.7, to: 5.5 10.73)
    track(top, width: 0.25, from: 25.04 11.5, to: 23.24 13.3, to: 16.04 13.3)
    track(bottom, width: 0.25, from: 16.04 13.3, to: 5.53 13.3, to: 5.5 13.27)
    via(at: 16.04 13.3, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H41.5V25.5H0.5Z")
}
