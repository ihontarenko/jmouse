# DC-07. Two sources feeding one node through three branches. The current law: what flows into the node through R1
# and R3 leaves it through R2 — the three ammeters show 3.6 + 0.6 = 4.2 mA. The voltage law: round the left loop the
# drops across R1 and R2 add up to V1, round the right loop the drops across R3 and R2 add up to V2.
circuit:kirchhoff-laws("Kirchhoff's laws") {
    meta {
        summary: "Two sources, three branches, one node: the currents into it balance, the drops round each loop add up."
        description: """
            Idea: two laws solve any network. The current law: charge does not pile up, so the currents flowing into
            a node equal those flowing out. The voltage law: going round any closed loop, the rises and the drops
            add up to zero.

            Try: raise V2 until the ammeter A3 reads zero — the right source then gives nothing. Raise it further:
            A3 grows positive and A1 shrinks. Lower V2 below the node: A3 turns negative, the current runs into V2
            and charges it. Whatever you do, A2 stays A1 + A3.

            Watch: the three ammeters — A1 + A3 = A2 at every setting. The voltmeters across R1 and R2 add up to V1
            (12 V); those across R3 and R2 add up to V2 (9 V).

            Ask: with V1 = 12 V, V2 = 9 V, R1 = R3 = 1 kΩ and R2 = 2 kΩ, what is the node's voltage? Write the
            current law at the node in terms of it and solve. Which V2 makes A3 read zero?
            """
        category: ohms-and-kirchhoffs-laws
        tags: ohm, example, dc-07
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    parameter:U_left(12 V, in: 0 V .. 24 V, step: 0.5 V, "V1, the left source")
    parameter:U_right(9 V, in: 0 V .. 24 V, step: 0.5 V, "V2, the right source")
    parameter:R_left(1 kΩ, in: 100 Ω .. 10 kΩ, step: 100 Ω, "R1, the left branch")
    parameter:R_middle(2 kΩ, in: 100 Ω .. 10 kΩ, step: 100 Ω, "R2, the middle branch")
    parameter:R_right(1 kΩ, in: 100 Ω .. 10 kΩ, step: 100 Ω, "R3, the right branch")
    part:V1(voltage-source, [left, 0], U_output: U_left)
    part:R1(resistor, [left, left_branch], resistance: R_left)
    part:A1(ammeter, [in: left_branch, out: node])
    part:A2(ammeter, [in: node, out: middle])
    part:R2(resistor, [middle, 0], resistance: R_middle)
    part:A3(ammeter, [in: right_branch, out: node])
    part:R3(resistor, [right, right_branch], resistance: R_right)
    part:V2(voltage-source, [right, 0], U_output: U_right)
    part:VM1(voltmeter, [plus: left, minus: left_branch])
    part:VM2(voltmeter, [plus: middle, minus: 0])
    part:VM3(voltmeter, [plus: right, minus: right_branch])
    place:V1(at: 240 640, rotate: 90)
    place:R1(at: 480 320)
    place:VM1(at: 480 160)
    place:A1(at: 800 320)
    place:A2(at: 1040 480, rotate: 90)
    place:R2(at: 1040 720, rotate: 90)
    place:VM2(at: 1240 720, rotate: 90)
    place:A3(at: 1280 320, rotate: 180)
    place:R3(at: 1520 320, rotate: 180)
    place:VM3(at: 1520 160, rotate: 180)
    place:V2(at: 1840 640, rotate: 90)
    mark:J1(junction, at: 320 320)
    mark:J2(junction, at: 640 320)
    mark:Jx(junction, at: 1040 320)
    mark:Jm(junction, at: 1040 600)
    mark:J3(junction, at: 1400 320)
    mark:J4(junction, at: 1680 320)
    mark:Jb1(junction, at: 1040 880)
    mark:Jb2(junction, at: 1240 880)
    mark:GND1(ground, at: 1040 960)
    wire:W1(V1.positive, to: J1.j, via: 240 320)
    wire:W2(J1.j, to: R1.positive)
    wire:W3(R1.negative, to: J2.j)
    wire:W4(J2.j, to: A1.in)
    wire:W5(A1.out, to: Jx.j)
    wire:W6(Jx.j, to: A2.in)
    wire:W7(A2.out, to: Jm.j)
    wire:W8(Jm.j, to: R2.positive)
    wire:W9(Jm.j, to: VM2.plus, via: 1240 600)
    wire:W10(A3.out, to: Jx.j)
    wire:W11(A3.in, to: J3.j)
    wire:W12(J3.j, to: R3.negative)
    wire:W13(R3.positive, to: J4.j)
    wire:W14(J4.j, to: V2.positive, via: 1840 320)
    wire:W15(VM1.plus, to: J1.j, via: 320 160)
    wire:W16(VM1.minus, to: J2.j, via: 640 160)
    wire:W17(VM3.plus, to: J4.j, via: 1680 160)
    wire:W18(VM3.minus, to: J3.j, via: 1400 160)
    wire:W19(V1.negative, to: Jb1.j, via: 240 880)
    wire:W20(R2.negative, to: Jb1.j)
    wire:W21(Jb1.j, to: Jb2.j)
    wire:W22(VM2.minus, to: Jb2.j)
    wire:W23(V2.negative, to: Jb2.j, via: 1840 880)
    wire:W24(Jb1.j, to: GND1.ground)
    probe:CH1(left, 5 V/div)
    probe:CH2(middle, 5 V/div)
    probe:CH3(right, 5 V/div)
    expect("the node settles at 8.4 V", from: "current law at the node: (12 − U)/1 kΩ + (9 − U)/1 kΩ = U/2 kΩ, so U = 8.4 V") {
        measure(final, middle)
        near(8.4 V, +- 0.5%)
    }
    expect("in from the left: 3.6 mA", from: "I1 = (V1 − U) / R1 = (12 V − 8.4 V) / 1 kΩ; and V1 = U_R1 + U_R2 = 3.6 V + 8.4 V") {
        measure(final, current: A1)
        near(3.6 mA, +- 0.5%)
    }
    expect("in from the right: 0.6 mA", from: "I3 = (V2 − U) / R3 = (9 V − 8.4 V) / 1 kΩ") {
        measure(final, current: A3)
        near(0.6 mA, +- 0.5%)
    }
    expect("out through the middle: the sum, 4.2 mA", from: "current law: I2 = I1 + I3 = 3.6 mA + 0.6 mA = 8.4 V / 2 kΩ") {
        measure(final, current: A2)
        near(4.2 mA, +- 0.5%)
    }
    analysis(transient, for: 10 ms)
    view:transient_response(primary)
    view:operating_point
    view:dc_sweep(parameter: U_right, from: 0, to: 24, points: 49)
}
