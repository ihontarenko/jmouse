component:open-hardware-mark("Open hardware mark") {
    meta {
        designator: G
        summary: "The open hardware gear, for a design that is shared as open hardware: printed on the board, nothing to buy"
        category: graphics
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    footprint("GRAPHIC:OPEN-HARDWARE-10:F")
    footprint("GRAPHIC:OPEN-HARDWARE-5:F")
    footprint("GRAPHIC:OPEN-HARDWARE-20:F")

    symbol(uses: "GRAPHIC:OPEN-HARDWARE:S") {
    }
}
