# Half-wave rectifier laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:half-wave-rectifier-pcb("Half-wave rectifier — pcb") {
    meta {
        summary: "Half-wave rectifier laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: diodes-and-rectifiers
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(half-wave-rectifier)
    layers(2)
    edge("M1 0H26A1 1 0 0 1 27 1V15A1 1 0 0 1 26 16H1A1 1 0 0 1 0 15V1A1 1 0 0 1 1 0Z")
    place(D1, at: 16 5)
    place(R1, at: 22.5 11, rotate: 270)
    place(J1, footprint: "FP.HDR:1X2-P2.54-V", nets: [0: 1, in: 2], at: 5.5 8)
    track(top, width: 0.25, from: 22.5 12, to: 22.5 13.05)
    track(top, width: 0.25, from: 10.92 5, to: 15.92 10, to: 22.5 10)
    track(bottom, width: 0.25, from: 21.08 5, to: 16.81 9.27, to: 5.5 9.27)
    via(at: 22.5 13.05, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H26.5V15.5H0.5Z")
}
