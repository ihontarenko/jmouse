# R-2R digital-to-analog converter laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:r2r-dac-pcb("R-2R digital-to-analog converter — pcb") {
    meta {
        summary: "R-2R digital-to-analog converter laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: digital-circuits
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(r2r-dac)
    layers(2)
    edge("M1 0H29A1 1 0 0 1 30 1V26A1 1 0 0 1 29 27H1A1 1 0 0 1 0 26V1A1 1 0 0 1 1 0Z")
    place(RT, at: 6.5 4, rotate: 180)
    place(R0, at: 11.5 11.5, rotate: 270)
    place(R1, at: 15.5 12, rotate: 270)
    place(R2, at: 20.5 12, rotate: 270)
    place(R3, at: 25.5 11, rotate: 270)
    place(R01, at: 12.5 6.5)
    place(R12, at: 18 6.5)
    place(R23, at: 23.5 6.5)
    place(J1, footprint: "HDR:1X6-P2.54-V:F", nets: [0: 1, bit0: 2, bit1: 3, bit2: 4, bit3: 5, out: 6], at: 5.5 15)
    track(top, width: 0.25, from: 5.5 4, to: 4.45 4)
    track(top, width: 0.25, from: 17 6.5, to: 13.5 6.5)
    track(top, width: 0.25, from: 19 6.5, to: 22.5 6.5)
    track(top, width: 0.25, from: 25.5 10, to: 25.5 7.5, to: 24.5 6.5)
    track(top, width: 0.25, from: 11.5 6.5, to: 11.5 10.5)
    track(top, width: 0.25, from: 7.5 4, to: 9 4, to: 11.5 6.5)
    track(top, width: 0.25, from: 15.5 11, to: 15.5 8, to: 17 6.5)
    track(top, width: 0.25, from: 20.5 11, to: 20.5 8, to: 19 6.5)
    track(top, width: 0.25, from: 11.5 12.5, to: 6.81 12.5, to: 5.5 11.19)
    track(top, width: 0.25, from: 15.5 13, to: 14.77 13.73, to: 5.5 13.73)
    track(top, width: 0.25, from: 20.5 13, to: 17.23 16.27, to: 5.5 16.27)
    track(top, width: 0.25, from: 25.5 12, to: 18.69 18.81, to: 5.5 18.81)
    track(top, width: 0.25, from: 25.5 10, to: 27.3 11.8, to: 17.75 21.35, to: 5.5 21.35)
    via(at: 4.45 4, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H29.5V26.5H0.5Z")
}
