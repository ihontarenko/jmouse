component:static-sensitive-mark("Static sensitive mark") {
    meta {
        designator: G
        summary: "A warning triangle with a struck-out hand: handle against electrostatic discharge: printed on the board, nothing to buy"
        category: graphics
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    footprint("GRAPHIC:STATIC-SENSITIVE-10:F")
    footprint("GRAPHIC:STATIC-SENSITIVE-5:F")
    footprint("GRAPHIC:STATIC-SENSITIVE-20:F")

    symbol(uses: "GRAPHIC:STATIC-SENSITIVE:S") {
    }
}
