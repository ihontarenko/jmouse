# Kirchhoff's laws laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:kirchhoff-laws-pcb("Kirchhoff's laws — pcb") {
    meta {
        summary: "Kirchhoff's laws laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: ohms-and-kirchhoffs-laws
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(kirchhoff-laws)
    layers(2)
    edge("M1 0H27A1 1 0 0 1 28 1V22A1 1 0 0 1 27 23H1A1 1 0 0 1 0 22V1A1 1 0 0 1 1 0Z")
    place(R1, at: 11 10)
    place(R2, at: 17 14.5, rotate: 270)
    place(R3, at: 23 10, rotate: 180)
    place(J1, footprint: "HDR:1X6-P2.54-V:F", nets: [0: 1, left: 2, left_branch: 3, middle: 4, right: 5, right_branch: 6], at: 5.5 11.5)
    track(top, width: 0.25, from: 17 15.5, to: 17 16.55)
    track(top, width: 0.25, from: 10 10, to: 7.81 10, to: 5.5 7.69)
    track(top, width: 0.25, from: 12 10, to: 10.65 11.35, to: 6.62 11.35, to: 5.5 10.23)
    track(top, width: 0.25, from: 17 13.5, to: 6.23 13.5, to: 5.5 12.77)
    track(top, width: 0.25, from: 22 10, to: 17.5 14.5, to: 8.85 14.5, to: 5.5 17.85)
    track(top, width: 0.25, from: 24 10, to: 22.65 8.65, to: 12.3 8.65)
    track(bottom, width: 0.25, from: 12.3 8.65, to: 12.16 8.65, to: 5.5 15.31)
    via(at: 17 16.55, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    via(at: 12.3 8.65, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H27.5V22.5H0.5Z")
}
