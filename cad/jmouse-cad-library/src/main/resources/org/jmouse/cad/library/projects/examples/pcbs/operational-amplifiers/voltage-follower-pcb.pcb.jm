# Voltage follower laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:voltage-follower-pcb("Voltage follower — pcb") {
    meta {
        summary: "Voltage follower laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: operational-amplifiers
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(voltage-follower)
    layers(2)
    edge("M1 0H30A1 1 0 0 1 31 1V18A1 1 0 0 1 30 19H1A1 1 0 0 1 0 18V1A1 1 0 0 1 1 0Z")
    place(RS1, at: 12.5 8)
    place(U1, at: 20 7.5)
    place(RL1, at: 26.5 10, rotate: 270)
    place(RS2, at: 15 13.5)
    place(RL2, at: 20 14, rotate: 270)
    place(J1, footprint: "HDR:1X4-P2.54-V:F", nets: [0: 1, in: 2, vn: 3, vp: 4], at: 5.5 9)
    track(top, width: 0.25, from: 17.55 5.595, to: 17.55 6.865)
    track(top, width: 0.25, from: 16 13.5, to: 19.5 13.5, to: 20 13)
    track(top, width: 0.25, from: 13.5 8, to: 17.415 8, to: 17.55 8.135)
    track(top, width: 0.25, from: 11.5 8, to: 5.77 8, to: 5.5 7.73)
    track(top, width: 0.25, from: 11.5 8, to: 11.5 11, to: 14 13.5)
    track(top, width: 0.25, from: 26.5 11, to: 24 11, to: 20 15)
    track(top, width: 0.25, from: 17.55 6.865, to: 18 6.865, to: 21.6 10.465, to: 25.035 10.465, to: 26.5 9)
    track(top, width: 0.25, from: 17.55 9.405, to: 14.85 12.105, to: 14.85 14.805, to: 10.035 14.805, to: 5.5 10.27)
    track(top, width: 0.25, from: 20 15, to: 15.95 15)
    track(bottom, width: 0.25, from: 15.95 15, to: 15.31 15, to: 5.5 5.19)
    track(top, width: 0.25, from: 22.45 5.595, to: 20.2 3.345, to: 4 3.345, to: 4 11.31, to: 5.5 12.81)
    via(at: 15.95 15, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H30.5V18.5H0.5Z")
}
