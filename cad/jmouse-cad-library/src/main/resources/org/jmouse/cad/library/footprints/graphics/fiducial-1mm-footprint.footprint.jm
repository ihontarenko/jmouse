footprint:fiducial-1mm-footprint("Fiducial, 1 mm") {
    meta {
        summary: "A placement machine's reference mark: a bare copper dot 1 mm wide in a 2 mm opening of the solder mask, no paste"
        code: "GRAPHIC:FIDUCIAL-1:F"
        category: graphics
        tags: electronics, footprint, graphic, fiducial
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    pad:1(surface, circle, at: 0 0, size: 1 x 1, mask-margin: 0.5, paste-margin: -0.5)
}
