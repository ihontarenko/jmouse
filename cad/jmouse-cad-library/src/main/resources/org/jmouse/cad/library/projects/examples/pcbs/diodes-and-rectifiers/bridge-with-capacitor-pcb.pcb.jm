# Bridge rectifier with a smoothing capacitor laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:bridge-with-capacitor-pcb("Bridge rectifier with a smoothing capacitor — pcb") {
    meta {
        summary: "Bridge rectifier with a smoothing capacitor laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: diodes-and-rectifiers
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(bridge-with-capacitor)
    layers(2)
    edge("M1 0H30A1 1 0 0 1 31 1V16A1 1 0 0 1 30 17H1A1 1 0 0 1 0 16V1A1 1 0 0 1 1 0Z")
    place(BR1, at: 15 8.5)
    place(C1, at: 23 8.5, rotate: 270)
    place(R1, at: 27 8.5, rotate: 270)
    place(J1, footprint: "HDR:1X2-P2.54-V:F", nets: [a: 1, b: 2], at: 5.5 8.5)
    track(top, width: 0.25, from: 23 9.35, to: 23 10.55)
    track(top, width: 0.25, from: 27 9.5, to: 27 10.55)
    track(top, width: 0.25, from: 23 7.65, to: 26.85 7.65, to: 27 7.5)
    track(top, width: 0.25, from: 12.46 11.04, to: 9.31 11.04, to: 5.5 7.23)
    track(top, width: 0.25, from: 12.46 5.96, to: 14.15 7.65, to: 23 7.65)
    track(bottom, width: 0.25, from: 17.54 5.96, to: 15.29 5.96, to: 11.48 9.77, to: 5.5 9.77)
    via(at: 23 10.55, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    via(at: 27 10.55, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H30.5V16.5H0.5Z")
}
