# Comparator laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:comparator-pcb("Comparator — pcb") {
    meta {
        summary: "Comparator laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: operational-amplifiers
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(comparator)
    layers(2)
    edge("M1 0H33A1 1 0 0 1 34 1V19A1 1 0 0 1 33 20H1A1 1 0 0 1 0 19V1A1 1 0 0 1 1 0Z")
    place(RV1, at: 14.5 8.5, rotate: 270)
    place(U1, at: 23 12.5)
    place(RP, at: 29.5 9.5, rotate: 270)
    place(J1, footprint: "FP.HDR:1X3-P2.54-V", nets: [0: 1, in: 2, vcc: 3], at: 5.5 12.5)
    track(top, width: 0.25, from: 25.45 10.595, to: 27.405 10.595, to: 29.5 8.5)
    track(top, width: 0.25, from: 14.5 8.5, to: 17.865 11.865, to: 20.55 11.865)
    track(top, width: 0.25, from: 20.55 10.595, to: 23.7 7.445, to: 30 7.445, to: 31.277 8.723, to: 29.5 10.5)
    track(top, width: 0.25, from: 14.5 11.04, to: 9.5 11.04, to: 5.5 15.04)
    track(bottom, width: 0.25, from: 14.5 5.96, to: 19 10.46, to: 19 14.51)
    track(top, width: 0.25, from: 19 14.51, to: 20.445 14.51, to: 20.55 14.405)
    track(top, width: 0.25, from: 14.5 11.04, to: 19 15.54, to: 21.25 15.54, to: 23.95 12.84, to: 23.95 10.595, to: 25.45 10.595)
    track(top, width: 0.25, from: 20.55 13.135, to: 17.85 13.135, to: 17.4 12.685)
    track(bottom, width: 0.25, from: 17.4 12.685, to: 5.685 12.685, to: 5.5 12.5)
    via(at: 19 14.51, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    via(at: 17.4 12.685, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H33.5V19.5H0.5Z")
}
