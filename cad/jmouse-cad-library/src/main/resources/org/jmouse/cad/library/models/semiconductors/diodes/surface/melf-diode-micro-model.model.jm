model:melf-diode-micro-model("MELF diode MicroMELF") {
    meta {
        summary: "MELF diode MicroMELF — its body drawn by jmCAD from the footprint and its package table"
        code: "MELF:D-MICRO:M3D"
        category: diodes-surface
        tags: electronics, model, chip
        source: "JEDEC DO-213 and the makers' MELF outlines, MicroMELF"
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    box(ceramic, size: [2.05, 1.2, 1.3], at: [0, 0, 0.65])
    box(tin, size: [0.41, 1.22, 1.32], at: [-0.82, 0, 0.65])
    box(tin, size: [0.41, 1.22, 1.32], at: [0.82, 0, 0.65])
}
