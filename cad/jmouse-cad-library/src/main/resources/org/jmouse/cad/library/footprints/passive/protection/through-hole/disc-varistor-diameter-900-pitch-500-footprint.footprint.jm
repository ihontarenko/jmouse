    pad:1(through-hole, rectangle, at: -2.5 0, size: 1.8 x 1.8, drill: 0.8)
    pad:2(through-hole, circle, at: 2.5 0, size: 1.8 x 1.8, drill: 0.8)
    outline(fabrication, width: 0.1, "M-4.5 -2.25H4.5V2.25H-4.5Z")
