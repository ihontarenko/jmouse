footprint:disc-varistor-diameter-900-pitch-500-footprint("Metal-oxide disc varistor, 7 mm disc") {
    meta {
        summary: "Metal-oxide disc varistor, 7 mm disc, leads 5 mm apart"
        code: "RV:D9-P5:F"
        category: protection-through-hole
