    }
    box(ceramic, size: [3.5, 1.5, 1.6], at: [0, 0, 0.8])
    box(tin, size: [0.7, 1.52, 1.62], at: [-1.4, 0, 0.8])
    box(tin, size: [0.7, 1.52, 1.62], at: [1.4, 0, 0.8])
}
