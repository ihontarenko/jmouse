# Parallel resonance laid out by the engine (circuitBoard + autoroute, 2026-11-06): every part where the sheet
# puts it, the bench's nets on J1, the bottom poured with the ground; every connection laid, the checks clean.
pcb:parallel-resonance-pcb("Parallel resonance — pcb") {
    meta {
        summary: "Parallel resonance laid out on a two-layer pcb by the engine: parts where the sheet puts them, the bench's nets on a header, a ground plane under it all."
        category: resonance
        tags: pcb, example
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    circuit(parallel-resonance)
    layers(2)
    edge("M1 0H23A1 1 0 0 1 24 1V15A1 1 0 0 1 23 16H1A1 1 0 0 1 0 15V1A1 1 0 0 1 1 0Z")
    place(R1, at: 11.5 7.5, rotate: 270)
    place(C1, at: 15.5 7.5, rotate: 270)
    place(L1, at: 19.5 5, rotate: 270)
    place(R2, at: 19.5 10.5, rotate: 270)
    place(J1, footprint: "FP.HDR:1X2-P2.54-V", nets: [0: 1, top: 2], at: 5.5 6.5)
    track(top, width: 0.25, from: 19.5 5.85, to: 19.5 9.5)
    track(top, width: 0.25, from: 11.5 6.5, to: 15.35 6.5, to: 15.5 6.65)
    track(top, width: 0.25, from: 11.5 8.5, to: 15.35 8.5, to: 15.5 8.35)
    track(top, width: 0.25, from: 15.5 6.65, to: 17 6.65, to: 19.5 4.15)
    track(top, width: 0.25, from: 15.5 8.35, to: 16.35 8.35, to: 19.5 11.5)
    track(top, width: 0.25, from: 11.5 6.5, to: 7 6.5, to: 5.615 7.885, to: 5.5 7.77)
    track(top, width: 0.25, from: 11.5 8.5, to: 8.8 8.5)
    track(bottom, width: 0.25, from: 8.8 8.5, to: 8.77 8.5, to: 5.5 5.23)
    via(at: 8.8 8.5, drill: 0.4, diameter: 0.8, from: top, to: bottom)
    zone(bottom, net: 0, clearance: 0.4, "M0.5 0.5H23.5V15.5H0.5Z")
}
