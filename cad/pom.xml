        <module>jmouse-cad-eagle</module>
        <module>jmouse-cad-libre-pcb</module>
        <module>jmouse-cad-altium</module>
        <module>jmouse-cad-nexar</module>
        <module>jmouse-cad-suppliers</module>
        <module>jmouse-cad-library</module>
        <module>jmouse-cad-exchange</module>
