<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-spring</artifactId>
        <version>1.0.1</version>
        <relativePath>../../../jmouse-spring/pom.xml</relativePath>
    </parent>

    <artifactId>jmouse-cad-plugin-git</artifactId>
    <packaging>jar</packaging>
    <name>jMouse - CAD Plugin Git</name>
    <description>Git for the explorer: a mounted folder made a repository, its changes reviewed and committed with a message, its history and every change of a file shown — only where the explorer runs, through its mounts and its decisions.</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/cad/spring/jmouse-cad-plugin-git</url>

    <properties>
        <!-- what a reader is told of the plugin: one line, and the kind it is -->
        <plugin.summary>Repositories: review, commit, history</plugin.summary>
        <plugin.category>Workspace</plugin.category>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <spring-boot.version>4.0.7</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The folders it works in are the explorer's mounts, and who may read or change them is the explorer's decision -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-plugin-explorer</artifactId>
        </dependency>
        <!-- Git itself, in-process: no git binary, no hooks -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-git</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-management</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-plugin-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>

</project>
