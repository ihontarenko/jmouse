<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-spring</artifactId>
        <version>1.0.1</version>
        <relativePath>../../../jmouse-spring/pom.xml</relativePath>
    </parent>

    <artifactId>jmouse-cad-plugin-mesh</artifactId>
    <packaging>jar</packaging>
    <name>jMouse - CAD Plugin Mesh</name>
    <description>The model document in the language, the models of a fetched footprint taken from every place that holds them, and a model served as GLB — the PCB's 3D view stands on it</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/cad/spring/jmouse-cad-plugin-mesh</url>

    <properties>
        <!-- what a reader is told of the plugin: one line, and the kind it is -->
        <plugin.summary>3D models, a PCB's view as GLB</plugin.summary>
        <plugin.category>3D</plugin.category>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <spring-boot.version>4.0.7</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Its settings, read from the engine's one settings tree -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-settings</artifactId>
        </dependency>
        <!-- The engine's routes it stands beside: their prefix, the problems, the catalogue a model is read from -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-management</artifactId>
        </dependency>
        <!-- The model document, where models come from, and a model read into a mesh -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-mesh</artifactId>
        </dependency>
        <!-- The PCB written in 3D: its artwork, its layers, the formats a document is written in -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-exchange</artifactId>
        </dependency>
        <!-- A model's files, kept as the files a document holds -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-storage-management</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-plugin-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
