<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-spring</artifactId>
        <version>1.0.1</version>
        <relativePath>../../../jmouse-spring/pom.xml</relativePath>
    </parent>

    <artifactId>jmouse-cad-plugin-ipc2581</artifactId>
    <packaging>jar</packaging>
    <name>jMouse - CAD Plugin IPC-2581</name>
    <description>A PCB written as one IPC-2581 revision C file: its layers and stackup, its profile, packages, components, nets and bill of materials, and every layer's copper, mask, paste, silkscreen and holes.</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/cad/spring/jmouse-cad-plugin-ipc2581</url>

    <properties>
        <!-- what a reader is told of the plugin: one line, and the kind it is -->
        <plugin.summary>The PCB as one IPC-2581 file</plugin.summary>
        <plugin.category>Fabrication</plugin.category>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <spring-boot.version>4.0.7</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Its settings, read from the engine's one settings tree -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-settings</artifactId>
        </dependency>
        <!-- The format the file is written in -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-ipc2581</artifactId>
        </dependency>
        <!-- What is written: the PCB, its footprints, its circuit; the edge as a path -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-pcb</artifactId>
        </dependency>
        <!-- The rules a PCB is made by: its thickness -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-library</artifactId>
        </dependency>
        <!-- The letters of the silkscreen: NewStroke, laid out as strokes -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-stroke-fonts</artifactId>
        </dependency>
        <!-- The point it brings its format to -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-cad-exchange</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-plugin-spring</artifactId>
        </dependency>
        <!-- The export's data: the layers' names, who the file is from -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
