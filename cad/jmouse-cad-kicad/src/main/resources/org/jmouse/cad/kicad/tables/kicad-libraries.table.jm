# What a drawing converted from KiCad's own libraries says of itself — whose it is, under what terms — and where each of
# a KiCad footprint's layers lands among ours. A footprint's lines on any layer not named here — its edge cuts, its user
# layers, its texts — are not a part's, and are left out.
table:kicad-libraries("KiCad libraries") {
    meta {
        summary: "Who holds KiCad's own libraries, their licence, and what each KiCad layer is for."
        category: tables
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }

    holder "KiCad Libraries Team"
    license "CC-BY-SA-4.0 WITH KiCad-libraries-exception"
    home "https://gitlab.com/kicad/libraries"

    # Whose a footprint is travels with it into KiCad and back, as fields of the footprint KiCad keeps and shows in its
    # properties: the word of our meta each part of its provenance is, and the field it is written as. A footprint that
    # names a holder or a licence so is read back as theirs.
    provenance-fields source = Source, authors = Author, license = License

    # The tags a converted drawing carries; a circuit or a pcb is filed in no category, for the project it is imported into is its
    # place. A symbol, a footprint, a 3D model or a component is filed by what it is — the entries at the end of this table, by the
    # KiCad library it comes from —; whose it is stays in its provenance. What no entry names is filed here:
    unfiled-category general
    symbol-tags electronics, schematic, kicad
    footprint-tags electronics, kicad, footprint
    model-tags electronics, kicad, model

    # Where KiCad's own model files keep another convention than their format's standard, by format: its VRML is written
    # in tenths of an inch (2.54 mm a unit) and stands up along Z, as its pcbs do.
    model-scales vrml = 2.54
    model-ups vrml = z
    component-tags electronics, kicad
    circuit-tags electronics, kicad

    # The library a component with no KiCad counterpart is written under, and the symbol each mark of a sheet is drawn
    # with — where its terminal stands.
    own-library jmCAD
    # What a project's tables say of that library, written beside the project: the footprints and symbols it draws.
    own-library-description "The footprints and symbols of this design that no KiCad library holds, as jmCAD draws them"
    mark-symbols ground = ground-symbol, common = common-symbol, label = net-label-symbol, port = port-label-symbol, global = global-label-symbol

    # The way of making a pcb a board is set against, and which of its rules each of KiCad's design rules is. KiCad's
    # usual clearance and sizes come from its Default net class.
    pcb-rules standard
    pcb-rule-names least-track-width = min_track_width, least-drill = min_through_hole_diameter, least-via-drill = min_through_hole_diameter, least-via-ring = min_via_annular_width, hole-clearance = min_hole_clearance, edge-clearance = min_copper_edge_clearance

    # What a footprint only the board has is called when it has no reference, and what a net class's name opens with
    # where KiCad's opens with no letter.
    pcb-own-part PCB
    pcb-class-opening class_

    # How far apart a board's lines of words stand, as a share of their height, as KiCad's own font sets them.
    text-line-spacing 1.62

    # How far an area written as points — a pour's outline, a filled shape — may stray from the arcs and curves it steps:
    # as far as KiCad's own steps stray when it fills one.
    area-step 0.005 mm

    # The file a board's footprint names a model of KiCad's own model libraries by: its place there, under the path KiCad
    # resolves to the installed libraries, as the VRML KiCad's own footprints name.
    model-file "${KICAD8_3DMODEL_DIR}/%s.wrl"

    # The width a board's edge is drawn with on Edge.Cuts, as KiCad draws a new one: the router cuts along its middle.
    edge-width 0.05 mm

    # What the footprint of a hole the board drills of its own — no part's — is named in the own library, by its drill.
    hole-footprint "MountingHole_%s"

    # How long a sheet's transient runs until its author says, and the time a division the oscilloscope opens on.
    transient 20 ms

    silkscreen "What is printed on the pcb, front and back" {
        kicad "F.SilkS", "B.SilkS"
    }
    fabrication "What the assembly drawing shows" {
        kicad "F.Fab", "B.Fab"
    }
    courtyard "The space the part keeps clear around it" {
        kicad "F.CrtYd", "B.CrtYd"
    }
    mask "A window in the solder mask, besides what the pads open" {
        kicad "F.Mask", "B.Mask"
    }
    paste "Solder paste, besides what the pads take" {
        kicad "F.Paste", "B.Paste"
    }
    adhesive "The glue that holds a part while it is soldered" {
        kicad "F.Adhes", "B.Adhes"
    }
    documentation "A drawing of the pcb, which no factory makes" {
        kicad "Dwgs.User", "Eco1.User", "Eco2.User", "User.1", "User.2", "User.3", "User.4", "User.5", "User.6", "User.7", "User.8", "User.9"
    }
    comments "A note on the pcb, which no factory makes" {
        kicad "Cmts.User"
    }
    copper "Copper drawn besides the pads" {
        kicad "F.Cu", "B.Cu"
    }

    # Where each of KiCad's parts is filed, by what it is: the KiCad words filed in each of our categories, a symbol's LIBRARY:NAME
    # or a library's name, '*' any run of characters. A part is filed by the first entry naming its symbol or footprint, else its
    # library; nothing named, it is unfiled.
    resistors-surface "Resistors, surface mount" {
        sources "Resistor_SMD"
    }
    resistors-through-hole "Resistors, through-hole" {
        sources "Resistor_THT"
    }
    resistors "Resistors" {
        sources "Device:R", "Device:R_*", "Device:RN*", "Device:R_Pack*", "Resistor_*"
    }
    potentiometers-through-hole "Potentiometers, through-hole" {
        sources "Potentiometer_THT"
    }
    potentiometers "Potentiometers" {
        sources "Device:R_Pot*", "Device:R_Trim*", "Potentiometer_*"
    }
    thermistors "Thermistors" {
        sources "Device:Thermistor*"
    }
    capacitors-surface "Capacitors, surface mount" {
        sources "Capacitor_SMD", "Capacitor_Tantalum_SMD"
    }
    capacitors-through-hole "Capacitors, through-hole" {
        sources "Capacitor_THT"
    }
    capacitors "Capacitors" {
        sources "Device:C", "Device:C_*", "Device:CP*", "Capacitor_*"
    }
    inductors-surface "Inductors, surface mount" {
        sources "Inductor_SMD"
    }
    inductors "Inductors" {
        sources "Device:L", "Device:L_*", "Device:Ferrite*", "Inductor_*"
    }
    crystals "Crystals and oscillators" {
        sources "Device:Crystal*", "Device:Resonator*", "Crystal", "Oscillator", "Oscillator_*"
    }
    fuses "Fuses" {
        sources "Device:Fuse*", "Device:Polyfuse*", "Fuse"
    }
    protection-through-hole "Protection, through-hole" {
        sources "Varistor"
    }
    protection "Protection" {
        sources "Device:Varistor*", "Device:Thermistor_PTC*", "Power_Protection"
    }
    transformers "Transformers" {
        sources "Device:Transformer*", "Transformer", "Transformer_*"
    }
    diodes-surface "Diodes, surface mount" {
        sources "Diode_SMD"
    }
    diodes-through-hole "Diodes, through-hole" {
        sources "Diode_THT"
    }
    optoelectronics-surface "Optoelectronics, surface mount" {
        sources "LED_SMD"
    }
    optoelectronics-through-hole "Optoelectronics, through-hole" {
        sources "LED_THT"
    }
    optoelectronics "Optoelectronics" {
        sources "Device:LED*", "LED", "LED_*", "Isolator", "Isolator_*", "OptoDevice", "Optocoupler*"
    }
    diodes "Diodes" {
        sources "Device:D", "Device:D_*", "Diode", "Diode_*"
    }
    transistors "Transistors" {
        sources "Device:Q_*", "Transistor_*"
    }
    thyristors "Thyristors" {
        sources "Device:Thyristor*", "Device:Triac*", "Triac_Thyristor"
    }
    surface-transistor-outline "Transistor outlines, surface mount" {
        sources "Package_TO_SOT_SMD"
    }
    through-hole-transistor-outline "Transistor outlines, through-hole" {
        sources "Package_TO_SOT_THT"
    }
    small-outline "Small outline packages" {
        sources "Package_SO", "Package_SO_*", "Package_SON"
    }
    no-lead "No-lead packages" {
        sources "Package_DFN_QFN"
    }
    quad-flat "Quad flat packages" {
        sources "Package_QFP", "Package_LCC"
    }
    dual-inline "Dual in-line packages" {
        sources "Package_DIP"
    }
    packages-through-hole "Packages, through-hole" {
        sources "Package_SIP", "Package_DIP_*"
    }
    packages-surface "Packages, surface mount" {
        sources "Package_BGA", "Package_CSP", "Package_LGA", "Package_DirectFET", "Package_*"
    }
    microcontrollers "Microcontrollers" {
        sources "MCU_*"
    }
    memory "Memory" {
        sources "Memory_*"
    }
    logic "Logic" {
        sources "74xx", "74xGxx", "4xxx", "4xxx_IEEE", "Logic_*"
    }
    amplifiers "Amplifiers" {
        sources "Amplifier_*"
    }
    comparators "Comparators" {
        sources "Comparator"
    }
    converters "Converters" {
        sources "Analog_ADC", "Analog_DAC", "Converter_*"
    }
    references "References" {
        sources "Reference_*"
    }
    power "Power" {
        sources "Regulator_*", "Battery_Management", "Driver_*", "Power_Management"
    }
    timers "Timers" {
        sources "Timer", "Timer_*"
    }
    interface "Interface" {
        sources "Interface_*"
    }
    sensors "Sensors" {
        sources "Sensor", "Sensor_*"
    }
    displays "Displays" {
        sources "Display", "Display_*"
    }
    relays "Relays" {
        sources "Relay", "Relay_*"
    }
    switches "Switches" {
        sources "Switch", "Button_Switch_*", "Rotary_Encoder"
    }
    connectors "Connectors" {
        sources "Connector", "Connector_*", "TerminalBlock*"
    }
    mounting-holes "Mounting holes" {
        sources "MountingHole", "Mechanical"
    }
    test-points "Test points" {
        sources "TestPoint"
    }
    electromechanical "Electromechanical" {
        sources "Buzzer_Beeper", "Motor", "Device:Buzzer*", "Device:Speaker*", "Device:Motor*"
    }
    marks "Marks and labels" {
        sources "power", "Graphic"
    }
    passive "Passive" {
        sources "Device"
    }
}
