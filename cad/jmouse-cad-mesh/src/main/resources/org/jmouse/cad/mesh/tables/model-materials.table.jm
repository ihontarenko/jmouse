# What a model drawn from shapes is made of: each material's colour (sRGB, `#rrggbb`), how metallic and how rough it is
# (glTF's metallic-roughness), and how opaque. A shape names its material by its id; a new material is a new row.
#
# `steps` is how many flat sides the round of a cylinder is drawn with.
table:model-materials("Model materials") {
    meta {
        summary: "The materials a drawn 3D model's shapes are made of, and how finely their rounds are drawn."
        category: tables
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }

    drawing "How a drawn model is drawn" {
        steps 32
    }
    plastic "Black moulded plastic — an IC's or a transistor's body" {
        colour "#1d1d1f"
        metallic 0
        roughness 0.55
        opacity 1
    }
    dimple "A moulding's dimple or notch: its pin-one mark, a shade off its body" {
        colour "#3b3b40"
        metallic 0
        roughness 0.85
        opacity 1
    }
    ceramic "Ceramic — a chip resistor's or capacitor's body" {
        colour "#cbbf9a"
        metallic 0
        roughness 0.7
        opacity 1
    }
    tantalum "Tantalum capacitor moulding" {
        colour "#c99a2e"
        metallic 0
        roughness 0.5
        opacity 1
    }
    tin "Tin-plated leads and terminations" {
        colour "#c7c9cc"
        metallic 1
        roughness 0.35
        opacity 1
    }
    copper "Bare copper — a heat tab" {
        colour "#c8913f"
        metallic 1
        roughness 0.3
        opacity 1
    }
    lacquer "An axial resistor's lacquered body" {
        colour "#d9c49b"
        metallic 0
        roughness 0.6
        opacity 1
    }
    glass "A glass diode's body" {
        colour "#b3462e"
        metallic 0
        roughness 0.15
        opacity 0.8
    }
    sleeve "An electrolytic capacitor's printed sleeve" {
        colour "#24408e"
        metallic 0
        roughness 0.45
        opacity 1
    }
    aluminium "An electrolytic capacitor's can" {
        colour "#bfc3c7"
        metallic 1
        roughness 0.4
        opacity 1
    }
    vent "The vent cross scored in an electrolytic can's top" {
        colour "#8d9297"
        metallic 1
        roughness 0.6
        opacity 1
    }
    marking "A printed band or a pin-one mark" {
        colour "#e9e6dc"
        metallic 0
        roughness 0.6
        opacity 1
    }
    housing "A connector's or a switch's housing" {
        colour "#2b2b2e"
        metallic 0
        roughness 0.6
        opacity 1
    }
    lens "A light-emitting diode's clear lens" {
        colour "#e6efe9"
        metallic 0
        roughness 0.1
        opacity 0.6
    }
    gold "Gold-plated pins" {
        colour "#d8b45a"
        metallic 1
        roughness 0.25
        opacity 1
    }
    laminations "A transformer's stack of steel laminations and its moulded bobbin" {
        colour "#5b5f63"
        metallic 0.6
        roughness 0.5
        opacity 1
    }
}
