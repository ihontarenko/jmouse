# How a drawing converted from an Eagle design is filed, and where each of an Eagle package's layers lands among ours.
# An Eagle design carries its libraries inside it: a converted drawing is the design's, its holder and terms the design's.
# A package's lines on any layer not named here — its names, values, keepouts, documentation of the other kind — are not
# a part's, and are left out.
table:eagle-libraries("Eagle libraries") {
    meta {
        summary: "Where an Eagle design's converted documents are filed, and what each Eagle layer is for."
        category: tables
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }

    # The tags a converted drawing carries; a circuit or a pcb is filed in no category, for the project it is imported into is its
    # place. A symbol, a footprint, a 3D model or a component is filed by what it is — by the library it comes from, the entries at
    # the end of this table —; whose it is stays in its provenance. What no entry names is filed here:
    unfiled-category general
    symbol-tags electronics, schematic, eagle
    footprint-tags electronics, eagle, footprint
    component-tags electronics, eagle
    circuit-tags electronics, eagle

    # The symbol each mark of a sheet is drawn with — where its terminal stands.
    mark-symbols ground = ground-symbol, common = common-symbol, power = power-symbol, label = net-label-symbol, port = port-label-symbol, global = global-label-symbol, entry = bus-entry-symbol

    # The net that is a design's reference ground, node 0: what Eagle's supply libraries name it.
    ground GND

    # How far apart a design's sheets are laid, side by side on the one circuit Eagle's shared nets make them.
    sheet-gap 50.8 mm

    # How long a sheet's transient runs until its author says.
    transient 20 ms

    # A pad or a via whose ring Eagle leaves to the design rules: the rules' default restring, a share of the drill kept
    # between a least and a most — Eagle's own defaults.
    ring-share 0.25
    ring-least 0.254 mm
    ring-most 0.508 mm

    # tNames and bNames print with the silkscreen, as Eagle's own CAM job prints them; tValues and bValues are the assembly
    # drawing's.
    silkscreen "What is printed on the pcb, front and back" {
        eagle "21", "22", "25", "26"
    }
    fabrication "What the assembly drawing shows" {
        eagle "51", "52", "27", "28"
    }
    mask "What the solder mask leaves open: tStop and bStop" {
        eagle "29", "30"
    }
    paste "What takes solder paste: tCream and bCream" {
        eagle "31", "32"
    }
    copper "Copper drawn besides the pads" {
        eagle "1", "16"
    }

    # Where each part is filed, by the library it comes from — '*' any run of characters. Nothing named, it is unfiled.
    resistors "Resistors" {
        sources "resistor*", "res*"
    }
    capacitors "Capacitors" {
        sources "capacitor*", "cap*"
    }
    inductors "Inductors" {
        sources "inductor*", "ferrite*"
    }
    passive "Passive" {
        sources "rcl", "discrete"
    }
    crystals "Crystals and oscillators" {
        sources "crystal*", "oscillator*"
    }
    fuses "Fuses" {
        sources "fuse*"
    }
    transformers "Transformers" {
        sources "trafo*", "transformer*"
    }
    optoelectronics "Optoelectronics" {
        sources "led*", "optocoupler*", "opto*"
    }
    diodes "Diodes" {
        sources "diode*", "rectifier*"
    }
    transistors "Transistors" {
        sources "transistor*", "fet*", "mosfet*"
    }
    logic "Logic" {
        sources "74xx*", "40xx*", "logic*"
    }
    amplifiers "Amplifiers" {
        sources "linear", "op-amp*", "opamp*"
    }
    power "Power" {
        sources "v-reg*", "regulator*", "power_ic*"
    }
    memory "Memory" {
        sources "memory*", "eeprom*"
    }
    microcontrollers "Microcontrollers" {
        sources "microchip*", "atmel*", "avr*", "st-microelectronics*", "stm32*", "pic*"
    }
    interface "Interface" {
        sources "interface*", "maxim*", "ftdi*"
    }
    displays "Displays" {
        sources "display*", "lcd*"
    }
    relays "Relays" {
        sources "relay*"
    }
    switches "Switches" {
        sources "switch*", "button*"
    }
    connectors "Connectors" {
        sources "con-*", "pinhead*", "jumper*", "connector*"
    }
    test-points "Test points" {
        sources "testpad*", "solpad*", "wirepad*"
    }
    mounting-holes "Mounting holes" {
        sources "holes*", "mounting*"
    }
    packages "Packages" {
        sources "ic-package*", "ref-packages*", "package*"
    }
    marks "Marks and labels" {
        sources "supply*"
    }
    frames "Sheet frames" {
        sources "frames*"
    }
}
