{
  "plugins": ["prettier-plugin-java", "@prettier/plugin-xml"],
  "tabWidth": 4,
  "printWidth": 110,
  "endOfLine": "lf",
  "singleQuote": true,
  "trailingComma": "none",
  "htmlWhitespaceSensitivity": "ignore",
  "xmlWhitespaceSensitivity": "ignore",
  "overrides": [{ "files": "*.json", "options": { "tabWidth": 2 } }]
}
