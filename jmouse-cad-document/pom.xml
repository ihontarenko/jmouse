<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <packaging>jar</packaging>
    <artifactId>jmouse-cad-document</artifactId>
    <name>jMouse - CAD Document</name>
    <description>jMouse Framework - jmCAD documents: the jM document language on the jME engine. The language itself knows no kind of document: every kind, and every block a kind holds, is brought by a DocumentModule — a symbol by the schematic's module, a footprint by the board's, a circuit by the simulation's.</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-cad-document</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ihontarenko</id>
            <name>Ivan Hontarenko</name>
            <email>ihontarenko@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
        <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
        <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-cad-document</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- plugins: the language takes its modules from the point a plugin may contribute to -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Slugifier: a document's slug is minted by the one rule every jmouse tree uses -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- jMF: a document's expressions, and the notation of its symbols -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-formula</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- jME and jMS: the lexer and the parsers a document is read with -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-script-el</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- units: a document's quantities -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-units</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- the grammar a document's lines are said in -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-el-grammar</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SVG path data, read into its tree wherever a document draws -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-svg-path</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
