<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jmouse</groupId>
        <artifactId>jmouse-parent</artifactId>
        <version>1.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmouse</groupId>
                <artifactId>jmouse-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <packaging>jar</packaging>
    <artifactId>jmouse-odb</artifactId>
    <name>jMouse - ODB++</name>
    <description>jMouse Framework - ODB++: a printed board as the ODB++ product model writes it — its matrix of layers, its profile, every layer's features, the drill layer — as a job's tree of files in one tgz. Only the format, no board model</description>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-odb</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>ihontarenko</id>
            <name>Ivan Hontarenko</name>
            <email>ihontarenko@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
        <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
        <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-odb</url>
    </scm>
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>
    <dependencies>
        <!-- What a reader is shown a value of its settings as (@Label): the settings library, which depends on nothing. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-settings</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Compiled with the descriptions processor, so a record a settings section reads carries its Javadoc; nothing at run time -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-descriptions</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- A job is a tree of files handed over as one tar, gzip'ed: Apache Commons Compress writes the archive -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
