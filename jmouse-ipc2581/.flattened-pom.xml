<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jmouse</groupId>
  <artifactId>jmouse-ipc2581</artifactId>
  <version>1.0.1</version>
  <name>jMouse - IPC-2581</name>
  <description>jMouse Framework - IPC-2581: a printed board and its assembly described in one XML file — layers, stackup, profile, packages, components, nets, BOM, every layer's features and holes —, as revision C of the IPC standard writes it. Only the format, no board model</description>
  <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-ipc2581</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>http://www.opensource.org/licenses/mit-license.php</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ihontarenko</id>
      <name>Ivan Hontarenko</name>
      <email>ihontarenko@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ihontarenko/jmouse.git</connection>
    <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git</developerConnection>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-ipc2581</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jmouse</groupId>
      <artifactId>jmouse-settings</artifactId>
      <version>1.0.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jmouse</groupId>
      <artifactId>jmouse-descriptions</artifactId>
      <version>1.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.2</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.7.0</version>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
