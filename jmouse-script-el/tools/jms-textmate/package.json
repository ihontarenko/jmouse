{
  "name": "jms-textmate",
  "displayName": "jMouse Script (.jms)",
  "description": "Syntax highlighting for jMS — jMouse Script.",
  "version": "1.0.0",
  "publisher": "jmouse",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
