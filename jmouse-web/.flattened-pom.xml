<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jmouse</groupId>
  <artifactId>jmouse-web</artifactId>
  <version>1.0.0-Stable1</version>
  <name>jMouse - Web (Servlet)</name>
  <description>jMouse Framework</description>
  <url>https://github.com/ihontarenko/jmouse/jmouse-web</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>http://www.opensource.org/licenses/mit-license.php</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ihontarenko</id>
      <name>Ivan Hontarenko</name>
      <email>ihontarenko@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ihontarenko/jmouse.git/jmouse-web</connection>
    <developerConnection>scm:git:ssh://github.com:ihontarenko/jmouse.git/jmouse-web</developerConnection>
    <url>https://github.com/ihontarenko/jmouse/tree/master/jmouse-core/jmouse-web</url>
