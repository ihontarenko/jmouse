  <dependencies>
    <dependency>
      <groupId>org.jmouse</groupId>
      <artifactId>jmouse-core</artifactId>
      <version>1.0.0-Stable1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jmouse</groupId>
      <artifactId>jmouse-security</artifactId>
      <version>1.0.0-Stable1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jmouse</groupId>
      <artifactId>jmouse-jdbc</artifactId>
      <version>1.0.0-Stable1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jmouse</groupId>
      <artifactId>jmouse-context</artifactId>
      <version>1.0.0-Stable1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jmouse</groupId>
      <artifactId>jmouse-validation</artifactId>
      <version>1.0.0-Stable1</version>
      <scope>compile</scope>
