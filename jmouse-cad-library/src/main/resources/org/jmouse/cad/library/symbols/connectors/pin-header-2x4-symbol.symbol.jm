symbol:pin-header-2x4-symbol("Pin header, 2 x 4") {
    meta {
        summary: "A two-row pin header of 8, as drawn on a schematic: odd contacts on the left, even on the right, numbered as on the board"
        code: "SY.HDR:2X4"
        category: circuits
        tags: electronics, schematic, connector
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    # Generated from symbol-standards/connector-symbols.sht; regenerate, never edit.
    size(120 x 180)
    path("M-20 -50H20V90H-20ZM-60 -40H-20M20 -40H60M-60 0H-20M20 0H60M-60 40H-20M20 40H60M-60 80H-20M20 80H60")
    pin:pin1(at: -60 -40, "1")
    pin:pin2(at: 60 -40, "2")
    pin:pin3(at: -60 0, "3")
    pin:pin4(at: 60 0, "4")
    pin:pin5(at: -60 40, "5")
    pin:pin6(at: 60 40, "6")
    pin:pin7(at: -60 80, "7")
    pin:pin8(at: 60 80, "8")
    label(name, at: 0 -64)
    label(value, at: 0 108)
}
