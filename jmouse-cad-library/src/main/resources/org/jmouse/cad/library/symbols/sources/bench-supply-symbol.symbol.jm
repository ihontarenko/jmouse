symbol:bench-supply-symbol("Bench power supply") {
    meta {
        summary: "A DC supply with a current limit, as drawn on a schematic: a source with the DC mark and a limit bar"
        code: "SY.SOURCE:SUPPLY-LIMITED"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 80)
    path("M-80 0H-32M32 0H80M-32 0A32 32 0 1 0 32 0A32 32 0 1 0-32 0M-16-6H16M-16 6H-8M-2 6H4M10 6H16M-12 18H12M-52-18V-6M-58-12H-46")
    pin:a(at: -80 0)
    pin:b(at: 80 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
