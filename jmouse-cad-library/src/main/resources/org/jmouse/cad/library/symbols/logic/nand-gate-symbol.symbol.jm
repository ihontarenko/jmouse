symbol:nand-gate-symbol("NAND gate") {
    meta {
        summary: "A two-input NAND gate, as drawn on a schematic (ANSI): the AND body and the bubble that inverts"
        code: "SY.GATE:NAND"
        category: circuits
        tags: electronics, schematic, logic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 120)
    path("M-40-40H0A40 40 0 0 1 0 40H-40ZM40 0A8 8 0 1 0 56 0A8 8 0 1 0 40 0M-80-20H-40M-80 20H-40M56 0H80M-20-40V-60M-20 40V60")
    # The body, filled as the drawing theme fills a part's body.
    path:body_fill("M-40-40H0A40 40 0 0 1 0 40H-40Z") {
        fill = body
    }
    pin:a(at: -80 -20)
    pin:b(at: -80 20)
    pin:output(at: 80 0)
    pin:Vcc(at: -20 -60)
    pin:GND(at: -20 60)
    label(name, at: 28 -60)
    label(value, at: 28 72)
}
