# A bridge rectifier as its makers model one: four identical junctions in one package, each behind its own bulk
# resistance, with its capacitance, its breakdown and its drift with temperature. Whichever input is higher, current
# leaves at + and comes back at −: the load sees |V_in| less two forward drops.

component:bridge-rectifier("Bridge rectifier, 1 A 400 V", type: rectifier-bridge) {
    meta {
        designator: BR
        summary: "Four junctions in one package: + and − out of two alternating inputs, two forward drops in the path"
        source: "typical 1 A, 400 V glass-passivated bridge (W04M class): VF 1.0 V max at 1 A per element"
        package: "WOM"
        category: circuits
        failure: short
    }
    use:smooth-transitions

    parameter:I_saturation(1.2 nA, "each junction's saturation current")
    parameter:emission_coefficient(1.8, "each junction's emission coefficient")
    parameter:R_series(50 mOhm, "each element's bulk resistance")
    parameter:C_junction(15 pF, "each junction's capacitance")
    parameter:V_breakdown(400 V, "each element's reverse breakdown")
    parameter:I_breakdown(10 uA, "current at V_breakdown")
    parameter:I_forward_maximum(1.5 A, "IF(AV): the average current it is rated to carry (W04M)")
    parameter:T_nominal(298.15 K, "the temperature the figures above are measured at")
    parameter:saturation_temperature_exponent(3, "XTI: how steeply I_saturation follows the temperature")
    parameter:E_gap(1.11 V, "silicon's band gap, in volts")
    # How it warms and where it gives up (WOM on a board: RθJA about 40 K/W, TJ max 150 °C).
    parameter:thermal_resistance(40 K/W, "kelvin above the bench per watt it takes")
    parameter:thermal_time_constant(5 s, "how fast it warms to that")
    parameter:T_maximum(150 °C, "past this it fails on a realistic bench")

    pin:ac1(analog, 1, "first alternating input")
    pin:ac2(analog, 2, "second alternating input")
    pin:plus(analog, 3, "rectified output, +")
    pin:minus(analog, 4, "rectified output, −")

    node:j1("junction from ac1 to +")
    node:j2("junction from ac2 to +")
    node:j3("junction from − to ac1")
    node:j4("junction from − to ac2")

    symbol(uses: bridge-rectifier-symbol) {
        bind:failed(failed)
        # Current into ac1 is carried by one diagonal, current into ac2 by the other: each against the rating.
        bind:pair_a(max(0, ac1.current) / I_forward_maximum)
        bind:pair_b(max(0, ac2.current) / I_forward_maximum)
        bind:a(pin: ac1)
        bind:b(pin: ac2)
        bind:p(pin: plus)
        bind:m(pin: minus)
    }

    equations {
        let V_thermal : voltage = thermal_voltage(temperature)
        let slope : voltage = emission_coefficient * V_thermal
        let warmth : ratio = temperature / T_nominal
        let I_saturation_now : current = I_saturation * warmth ^ (saturation_temperature_exponent / emission_coefficient) * exp((warmth - 1) * E_gap / slope)

        let V1 : voltage = j1 - plus
        let V2 : voltage = j2 - plus
        let V3 : voltage = j3 - ac1
        let V4 : voltage = j4 - ac2

        current ac1 -> j1 = (ac1 - j1) / R_series
        current j1 -> plus = I_saturation_now * (limit_exponential(V1 / slope) - 1) - I_breakdown * limit_exponential((0 - V1 - V_breakdown) / slope) + d(C_junction * V1)/dt
        current ac2 -> j2 = (ac2 - j2) / R_series
        current j2 -> plus = I_saturation_now * (limit_exponential(V2 / slope) - 1) - I_breakdown * limit_exponential((0 - V2 - V_breakdown) / slope) + d(C_junction * V2)/dt
        current minus -> j3 = (minus - j3) / R_series
        current j3 -> ac1 = I_saturation_now * (limit_exponential(V3 / slope) - 1) - I_breakdown * limit_exponential((0 - V3 - V_breakdown) / slope) + d(C_junction * V3)/dt
        current minus -> j4 = (minus - j4) / R_series
        current j4 -> ac2 = I_saturation_now * (limit_exponential(V4 / slope) - 1) - I_breakdown * limit_exponential((0 - V4 - V_breakdown) / slope) + d(C_junction * V4)/dt
    }

    expect("two forward drops between input and output", from: "VF per element, about 0.8 V at 100 mA: 12 V in, 100 Ohm load") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [in, 0], U_output: 12 V)
            part:R1(resistor, [out, ret], resistance: 100 Ohm)
            part:U1(self, [ac1: in, ac2: 0, plus: out, minus: ret])
        }
        measure(final, out - ret)
        within(10.0 V .. 10.7 V)
    }

    expect("the output keeps its polarity when the input is reversed", from: "full-wave rectification") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [in, 0], U_output: 12 V)
            part:R1(resistor, [out, ret], resistance: 100 Ohm)
            part:U1(self, [ac1: 0, ac2: in, plus: out, minus: ret])
        }
        measure(final, out - ret)
        within(10.0 V .. 10.7 V)
    }

    expect("two drops of at most 1 V at the rated current", from: "VF max 1.0 V per element at 1 A: 12 V in, about 1 A out") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [in, 0], U_output: 12 V)
            part:R1(resistor, [out, ret], resistance: 10 Ohm)
            part:U1(self, [ac1: in, ac2: 0, plus: out, minus: ret])
        }
        measure(final, out - ret)
        within(10.0 V .. 10.6 V)
    }
}
