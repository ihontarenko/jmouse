symbol:resistor-symbol("Resistor") {
    meta {
        summary: "Resistor, as drawn on a schematic: its body fills with the share of its rated power it takes, warming in colour as it nears the rating"
        code: "SY.RESISTOR:FIXED"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(120 x 80)
    input:load(0 .. 1)
    input:failed

    # How hard it works: the body fills from its first end with the power it takes against the power it is rated for,
    # and its colour warms as the share nears the rating — the heat it turns the current into, before it burns. Drawn
    # under the outline, so the outline stays as drawn.
    box:loading(live, at: 0 0, size: 64 x 28) {
        live level = load
        live fill = curve(load, 0 -> positive, 0.6 -> warm, 1 -> hot)
    }

    group:body(live) {
        path("M-60 0H-32V-14H32V14H-32V0M32 0H60")
        live stroke = if(failed > 0.5, burned, signal)
    }

    layer(live, failed > 0.5) {
        path:scorch("M-14-18L-6-6M12-16L4-4M-12 16L-4 6M14 18L6 6M-20 0H-10M20 0H10")
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin:a(at: -60 0)
    pin:b(at: 60 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
