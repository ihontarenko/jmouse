# A PNP transistor at the bipolar model's neutral defaults: what an imported `.model … PNP(…)` becomes, the model's
# numbers set on it. A datasheet PNP part is a member of this family.

component:pnp-transistor("PNP transistor", type: bjt) {
    meta {
        designator: Q
        summary: "PNP bipolar transistor, the Gummel–Poon model at its defaults"
        category: circuits
        failure: open
    }
    extends:bipolar-transistor

    parameter:polarity(-1, "PNP")

    symbol(uses: pnp-transistor-symbol) {
        bind:failed(failed)
    }

    expect("on: 10 µA drawn out of the base drives a milliampere", from: "BF 100 at the defaults") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [0, collector], U_output: 5 V)
            part:I1(current-source, [0, base], I_output: 10 uA)
            part:U1(self, [base: base, collector: collector, emitter: 0])
        }
        measure(operating, current: V1)
        within(-1.05 mA .. -0.95 mA)
    }
}
