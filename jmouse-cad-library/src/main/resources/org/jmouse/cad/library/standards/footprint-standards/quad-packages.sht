# Square packages with leads on all four sides, one entry a package: its lead count, pitch, square body, the leads'
# span tip to tip (for a QFN, the body's own edges), the length of a lead's foot and its width, the thermal pad when
# there is one, and which fillets its leads take — gull-wing for a QFP, no-lead for a QFN.
sheet "Quad packages" as quad-packages {
    description "QFP and QFN packages, leads on four sides."
    form quad

    lqfp-32 "LQFP-32, 7 mm body" source standard "JEDEC MS-026 BBA" {
        name lqfp-32
        fillets gull-wing
        leads 32
        pitch 0.8 mm
        body 7 mm
        span 8.8 mm .. 9.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.3 mm .. 0.45 mm
        folder "packages/surface/quad-flat"
        designation "LQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    lqfp-48 "LQFP-48, 7 mm body" source standard "JEDEC MS-026 BBC" {
        name lqfp-48
        fillets gull-wing
        leads 48
        pitch 0.5 mm
        body 7 mm
        span 8.8 mm .. 9.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.17 mm .. 0.27 mm
        folder "packages/surface/quad-flat"
        designation "LQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    lqfp-64 "LQFP-64, 10 mm body" source standard "JEDEC MS-026 BCD" {
        name lqfp-64
        fillets gull-wing
        leads 64
        pitch 0.5 mm
        body 10 mm
        span 11.8 mm .. 12.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.17 mm .. 0.27 mm
        folder "packages/surface/quad-flat"
        designation "LQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    lqfp-100 "LQFP-100, 14 mm body" source standard "JEDEC MS-026 BED" {
        name lqfp-100
        fillets gull-wing
        leads 100
        pitch 0.5 mm
        body 14 mm
        span 15.8 mm .. 16.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.17 mm .. 0.27 mm
        folder "packages/surface/quad-flat"
        designation "LQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    lqfp-144 "LQFP-144, 20 mm body" source standard "JEDEC MS-026 BFB" {
        name lqfp-144
        fillets gull-wing
        leads 144
        pitch 0.5 mm
        body 20 mm
        span 21.8 mm .. 22.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.17 mm .. 0.27 mm
        folder "packages/surface/quad-flat"
        designation "LQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    tqfp-32 "TQFP-32, 7 mm body" source standard "JEDEC MS-026 ABA" {
        name tqfp-32
        fillets gull-wing
        leads 32
        pitch 0.8 mm
        body 7 mm
        span 8.8 mm .. 9.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.3 mm .. 0.45 mm
        folder "packages/surface/quad-flat"
        designation "TQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    tqfp-44 "TQFP-44, 10 mm body" source standard "JEDEC MS-026 ACB" {
        name tqfp-44
        fillets gull-wing
        leads 44
        pitch 0.8 mm
        body 10 mm
        span 11.8 mm .. 12.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.3 mm .. 0.45 mm
        folder "packages/surface/quad-flat"
        designation "TQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    tqfp-64 "TQFP-64, 10 mm body" source standard "JEDEC MS-026 ACD" {
        name tqfp-64
        fillets gull-wing
        leads 64
        pitch 0.5 mm
        body 10 mm
        span 11.8 mm .. 12.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.17 mm .. 0.27 mm
        folder "packages/surface/quad-flat"
        designation "TQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    tqfp-100 "TQFP-100, 14 mm body" source standard "JEDEC MS-026 AED" {
        name tqfp-100
        fillets gull-wing
        leads 100
        pitch 0.5 mm
        body 14 mm
        span 15.8 mm .. 16.2 mm
        foot 0.45 mm .. 0.75 mm
        lead 0.17 mm .. 0.27 mm
        folder "packages/surface/quad-flat"
        designation "TQFP:{leads}-P{pitch|mm}-{body|mm}"
    }

    qfn-16-exposed-pad "QFN-16, 3 mm body" source standard "JEDEC MO-220" {
        name qfn-16-exposed-pad
        fillets no-lead
        leads 16
        pitch 0.5 mm
        body 3 mm
        span 2.9 mm .. 3.1 mm
        foot 0.3 mm .. 0.5 mm
        lead 0.18 mm .. 0.3 mm
        exposed-pad 1.7 mm
        folder "packages/surface/no-lead"
        designation "QFN:{leads}-P{pitch|mm}-{body|mm}-EP{exposed-pad|mm}"
    }

    qfn-20-exposed-pad "QFN-20, 4 mm body" source standard "JEDEC MO-220" {
        name qfn-20-exposed-pad
        fillets no-lead
        leads 20
        pitch 0.5 mm
        body 4 mm
        span 3.9 mm .. 4.1 mm
        foot 0.3 mm .. 0.5 mm
        lead 0.18 mm .. 0.3 mm
        exposed-pad 2.6 mm
        folder "packages/surface/no-lead"
        designation "QFN:{leads}-P{pitch|mm}-{body|mm}-EP{exposed-pad|mm}"
    }

    qfn-24-exposed-pad "QFN-24, 4 mm body" source standard "JEDEC MO-220" {
        name qfn-24-exposed-pad
        fillets no-lead
        leads 24
        pitch 0.5 mm
        body 4 mm
        span 3.9 mm .. 4.1 mm
        foot 0.3 mm .. 0.5 mm
        lead 0.18 mm .. 0.3 mm
        exposed-pad 2.6 mm
        folder "packages/surface/no-lead"
        designation "QFN:{leads}-P{pitch|mm}-{body|mm}-EP{exposed-pad|mm}"
    }

    qfn-28-exposed-pad "QFN-28, 5 mm body" source standard "JEDEC MO-220" {
        name qfn-28-exposed-pad
        fillets no-lead
        leads 28
        pitch 0.5 mm
        body 5 mm
        span 4.9 mm .. 5.1 mm
        foot 0.3 mm .. 0.5 mm
        lead 0.18 mm .. 0.3 mm
        exposed-pad 3.25 mm
        folder "packages/surface/no-lead"
        designation "QFN:{leads}-P{pitch|mm}-{body|mm}-EP{exposed-pad|mm}"
    }

    qfn-32-exposed-pad "QFN-32, 5 mm body" source standard "JEDEC MO-220" {
        name qfn-32-exposed-pad
        fillets no-lead
        leads 32
        pitch 0.5 mm
        body 5 mm
        span 4.9 mm .. 5.1 mm
        foot 0.3 mm .. 0.5 mm
        lead 0.18 mm .. 0.3 mm
        exposed-pad 3.45 mm
        folder "packages/surface/no-lead"
        designation "QFN:{leads}-P{pitch|mm}-{body|mm}-EP{exposed-pad|mm}"
    }

    qfn-48-exposed-pad "QFN-48, 7 mm body" source standard "JEDEC MO-220" {
        name qfn-48-exposed-pad
        fillets no-lead
        leads 48
        pitch 0.5 mm
        body 7 mm
        span 6.9 mm .. 7.1 mm
        foot 0.3 mm .. 0.5 mm
        lead 0.18 mm .. 0.3 mm
        exposed-pad 5.15 mm
        folder "packages/surface/no-lead"
        designation "QFN:{leads}-P{pitch|mm}-{body|mm}-EP{exposed-pad|mm}"
    }

    qfn-64-exposed-pad "QFN-64, 9 mm body" source standard "JEDEC MO-220" {
        name qfn-64-exposed-pad
        fillets no-lead
        leads 64
        pitch 0.5 mm
        body 9 mm
        span 8.9 mm .. 9.1 mm
        foot 0.3 mm .. 0.5 mm
        lead 0.18 mm .. 0.3 mm
        exposed-pad 7.15 mm
        folder "packages/surface/no-lead"
        designation "QFN:{leads}-P{pitch|mm}-{body|mm}-EP{exposed-pad|mm}"
    }
}
