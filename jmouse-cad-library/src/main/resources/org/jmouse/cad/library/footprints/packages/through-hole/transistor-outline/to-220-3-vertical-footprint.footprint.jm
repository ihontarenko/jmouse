footprint:to-220-3-vertical-footprint("TO-220-3, standing") {
    meta {
        summary: "3-lead TO-220 standing upright, through-hole, 2.54 mm pitch, the tab at the back"
        code: "FP.TO220:3-V"
        category: circuits
        tags: electronics, footprint, through-hole
        source: "JEDEC TO-220AB"
    }
    # Drawn from TO-220AB: pitch 2.54, lead b 1.016 × c 0.61 at most, body 10.16 wide, 4.45 deep, the leads 2.4 in front of
    # the tab's back face, the tab 1.25 thick.
    # Our through-hole rule: drill = the lead's diagonal 1.19 + 0.2, up to 1.4; pad = drill + 2 × 0.5 = 2.4 high, narrowed
    # to pitch − 0.25 = 2.25 wide; pin 1 square. Courtyard 0.5 past copper and body. Origin at the middle lead, Y down,
    # the marked face towards −Y.
    pad:1(through-hole, rectangle, at: -2.54 0, size: 2.25 x 2.4, drill: 1.4)
    pad:2(through-hole, oval, at: 0 0, size: 2.25 x 2.4, drill: 1.4)
    pad:3(through-hole, oval, at: 2.54 0, size: 2.25 x 2.4, drill: 1.4)
    outline(fabrication, width: 0.1, "M-5.08 -2.05H5.08V2.4H-5.08ZM-5.08 1.15H5.08")
    outline(silkscreen, width: 0.12, "M-5.19 -2.16H5.19V2.51H-5.19Z")
    outline(silkscreen, filled, "M-2.74 -1.75A0.2 0.2 0 1 0 -2.34 -1.75A0.2 0.2 0 1 0 -2.74 -1.75Z")
    outline(courtyard, width: 0.05, "M-5.6 -2.55H5.6V2.9H-5.6Z")
}
