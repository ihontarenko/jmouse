symbol:jumper-symbol("Jumper") {
    meta {
        summary: "Open jumper, as drawn on a schematic: two contacts and the cap that would bridge them, lifted off"
        code: "SY.JUMPER:OPEN"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 80)
    input:closed

    path("M-80 0H-24M24 0H80")
    path("M-28 0A4 4 0 1 0-20 0A4 4 0 1 0-28 0M20 0A4 4 0 1 0 28 0A4 4 0 1 0 20 0")

    # The cap: lifted while the jumper is open, down on both contacts once it is closed.
    path:cap(live, "M-24-8A24 24 0 0 1 24-8") {
        live move = 0, between(-12, 0, smooth(closed, 60 ms))
    }

    pin:a(at: -80 0)
    pin:b(at: 80 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
