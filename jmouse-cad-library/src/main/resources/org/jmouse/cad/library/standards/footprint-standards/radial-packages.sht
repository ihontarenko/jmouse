# Bodies standing over two leads in one row: aluminium cans and round LEDs seen from above as circles, ceramic discs and
# film boxes as rectangles. A kind writes the name template, the outline, which pin is marked and the folder; a size its
# body and its pitch — or, for a box family of one length and pitch, every width it is made in.
sheet "Radial packages" as radial-packages {
    description "Bodies standing over two leads in a row."
    form radial

    electrolytic-capacitors "Radial electrolytic capacitor" source standard "IEC 60384-4 can sizes, IEC 60286-2 lead spacing" {
        name "radial-electrolytic-capacitor-diameter-{diameter}-pitch-{pitch}"
        outline circle
        polarity positive
        folder "passive/capacitors/through-hole"
        designation "RADIAL:CP-D{diameter|mm}-P{pitch|mm}"

        can-4 "4 mm can" {
            diameter 4 mm
            pitch 1.5 mm
            lead 0.45 mm
        }
        can-5 "5 mm can" {
            diameter 5 mm
            pitch 2 mm
            lead 0.5 mm
        }
        can-6-3 "6.3 mm can" {
            diameter 6.3 mm
            pitch 2.5 mm
            lead 0.5 mm
        }
        can-8 "8 mm can" {
            diameter 8 mm
            pitch 3.5 mm
            lead 0.6 mm
        }
        can-10 "10 mm can" {
            diameter 10 mm
            pitch 5 mm
            lead 0.6 mm
        }
        can-12-5 "12.5 mm can" {
            diameter 12.5 mm
            pitch 5 mm
            lead 0.6 mm
        }
        can-16 "16 mm can" {
            diameter 16 mm
            pitch 7.5 mm
            lead 0.8 mm
        }
        can-18 "18 mm can" {
            diameter 18 mm
            pitch 7.5 mm
            lead 0.8 mm
        }
        can-22 "22 mm can" {
            diameter 22 mm
            pitch 10 mm
            lead 1 mm
        }
        can-25 "25 mm can" {
            diameter 25 mm
            pitch 10 mm
            lead 1 mm
        }
    }

    round-leds "Round LED" source standard "T-1 and T-1¾ lamp bodies, 2.54 mm lead spacing" {
        name "round-led-diameter-{body}"
        outline circle
        polarity cathode
        folder "semiconductors/optoelectronics/through-hole"
        designation "LED:D{body|mm}"

        led-3 "3 mm (T-1)" {
            diameter 3.8 mm
            body 3 mm
            pitch 2.54 mm
            lead 0.5 mm
        }
        led-5 "5 mm (T-1¾)" {
            diameter 5.8 mm
            body 5 mm
            pitch 2.54 mm
            lead 0.5 mm
        }
    }

    disc-capacitors "Ceramic disc capacitor" source standard "IEC 60286-2 lead spacing, makers' disc sizes" {
        name "disc-capacitor-diameter-{length}-width-{width}-pitch-{pitch}"
        outline rectangle
        polarity none
        folder "passive/capacitors/through-hole"
        designation "RADIAL:CD-{length|mm}X{width|mm}-P{pitch|mm}"

        disc-3-2-5 "3 mm disc, 2.5 mm pitch" {
            length 3 mm
            width 1.6 mm
            pitch 2.5 mm
            lead 0.5 mm
        }
        disc-4-3-5 "4.3 mm disc, 5 mm pitch" {
            length 4.3 mm
            width 1.9 mm
            pitch 5 mm
            lead 0.5 mm
        }
        disc-5-2-5 "5 mm disc, 2.5 mm pitch" {
            length 5 mm
            width 2.5 mm
            pitch 2.5 mm
            lead 0.5 mm
        }
        disc-5-5 "5 mm disc, 5 mm pitch" {
            length 5 mm
            width 2.5 mm
            pitch 5 mm
            lead 0.5 mm
        }
        disc-7-5-5 "7.5 mm disc, 5 mm pitch" {
            length 7.5 mm
            width 2.5 mm
            pitch 5 mm
            lead 0.6 mm
        }
        disc-10-7-5 "10 mm disc, 7.5 mm pitch" {
            length 10 mm
            width 2.5 mm
            pitch 7.5 mm
            lead 0.6 mm
        }
    }

    box-capacitors "Film box capacitor" source standard "IEC 60286-2 lead spacing, makers' box sizes" {
        name "box-capacitor-length-{length}-width-{width}-pitch-{pitch}"
        outline rectangle
        polarity none
        folder "passive/capacitors/through-hole"
        designation "RADIAL:CB-{length|mm}X{width|mm}-P{pitch|mm}"

        box-5 "5 mm pitch" {
            length 7.2 mm
            widths 2.5 mm, 3 mm, 3.5 mm, 4.5 mm, 5.5 mm, 7.2 mm
            pitch 5 mm
            lead 0.5 mm
        }
        box-7-5 "7.5 mm pitch" {
            length 10 mm
            widths 3 mm, 4 mm, 5 mm
            pitch 7.5 mm
            lead 0.6 mm
        }
        box-10 "10 mm pitch" {
            length 13 mm
            widths 4 mm, 5 mm, 6 mm
            pitch 10 mm
            lead 0.6 mm
        }
        box-15 "15 mm pitch" {
            length 18 mm
            widths 5 mm, 6 mm, 7 mm, 8 mm, 9 mm
            pitch 15 mm
            lead 0.8 mm
        }
        box-22-5 "22.5 mm pitch" {
            length 26.5 mm
            widths 6 mm, 7 mm, 8.5 mm, 10.5 mm, 11 mm
            pitch 22.5 mm
            lead 0.8 mm
        }
        box-22-5-long "22.5 mm pitch, long body" {
            length 28 mm
            widths 10 mm, 12 mm
            pitch 22.5 mm
            lead 0.8 mm
        }
        box-27-5 "27.5 mm pitch" {
            length 31.5 mm
            widths 9 mm, 11 mm, 13 mm
            pitch 27.5 mm
            lead 0.8 mm
        }
    }
}
