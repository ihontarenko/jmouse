symbol:pin-header-1x1-symbol("Pin header, 1 contact") {
    meta {
        summary: "A single-row pin header of 1, as drawn on a schematic: each contact a pin leaving to the right, numbered as on the board"
        code: "SY.HDR:1X1"
        category: circuits
        tags: electronics, schematic, connector
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    # Generated from symbol-standards/connector-symbols.sht; regenerate, never edit.
    size(60 x 60)
    path("M-4 0H40M-8 -2H-4V2H-8Z")
    pin:pin1(at: 40 0, "1")
    label(name, at: -4 -16)
    label(value, at: -4 20)
}
