# A voltage source whose voltage is a gain times the voltage between two other nodes — SPICE's E. The control pins
# draw no current. What a vendor op-amp macromodel builds its gain stages and its output from.

component:voltage-controlled-voltage-source("Voltage-controlled voltage source", type: source) {
    meta {
        designator: E
        summary: "Ideal voltage-controlled voltage source: V(positive, negative) = gain · V(control_positive, control_negative)"
        source: "SPICE E element, linear form"
        category: circuits
        failure: open
    }

    parameter:gain(1, "the output voltage over the controlling voltage")

    pin:positive(analog, output, 1, "output, positive")
    pin:negative(analog, output, 2, "output, negative")
    pin:control_positive(analog, input, 3, "controlling voltage, positive")
    pin:control_negative(analog, input, 4, "controlling voltage, negative")

    symbol(box) {
        left([control_positive, control_negative])
        right([positive, negative])
    }

    equations {
        voltage positive -> negative = gain * (control_positive - control_negative)
    }

    expect("ten times the control", from: "gain 10: 0.5 V in, 5 V out") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [input, 0], U_output: 0.5 V)
            part:R1(resistor, [output, 0], resistance: 1 kOhm)
            part:U1(self, [positive: output, negative: 0, control_positive: input, control_negative: 0], gain: 10)
        }
        measure(operating, output)
        near(5 V, +- 0.1%)
    }
}
