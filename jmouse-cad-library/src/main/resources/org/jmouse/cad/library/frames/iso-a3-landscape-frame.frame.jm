# Generated by the frames generator; a frame is drawn in millimetres about the paper's centre.
frame:iso-a3-landscape-frame("ISO A3, landscape") {
    meta {
        summary: "An ISO 216 A3 sheet, landscape (420 × 297 mm): a 10 mm margin, 8 × 6 zones and a title block filled from the drawing"
        code: "FR.ISO:A3-L"
        category: circuits
        tags: electronics, frame
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(420 x 297)
    # The fields the drawing fills: what the sheet is, whose, which revision of it, and where it stands among its sheets.
    input:company(text)
    input:title(text)
    input:project(text)
    input:date(text)
    input:revision(text)
    input:sheet(text)
    input:file(text)

    # The border: the paper's edge less 10 mm, and inside it the 2 mm band the zones are named in.
    path("M-200 -138.5H200V138.5H-200Z")
    path("M-198 -136.5H198V136.5H-198Z")
    # The zones: 8 columns numbered across, 6 rows lettered down — "B3" finds a part on the sheet.
    path("M-148.5 -138.5V-136.5M-148.5 136.5V138.5M-99 -138.5V-136.5M-99 136.5V138.5M-49.5 -138.5V-136.5M-49.5 136.5V138.5M0 -138.5V-136.5M0 136.5V138.5M49.5 -138.5V-136.5M49.5 136.5V138.5M99 -138.5V-136.5M99 136.5V138.5M148.5 -138.5V-136.5M148.5 136.5V138.5M-200 -91H-198M198 -91H200M-200 -45.5H-198M198 -45.5H200M-200 0H-198M198 0H200M-200 45.5H-198M198 45.5H200M-200 91H-198M198 91H200")
    glyph:column_1_top(at: -173.25 -137.5, size: 3 x 1.6) {
        fill = signal
        text = "1"
    }
    glyph:column_1_bottom(at: -173.25 137.5, size: 3 x 1.6) {
