symbol:fuse-symbol("Fuse") {
    meta {
        summary: "Fuse, as drawn on a schematic"
        code: "SY.FUSE:FIXED"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(120 x 80)
    path("M-60 0H60M-34-14H34V14H-34Z")
    pin:a(at: -60 0)
    pin:b(at: 60 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
