# An SPI controller for the bench: it selects its target, once or over and over, clocks its bytes out on MOSI and as
# many in on MISO, and lets the target go — one transaction at a set moment and a set clock, in mode 0: the clock idles
# low, both sides change their data as it falls and read it as it rises. The last byte read stands on its data outputs;
# the one before it is its display too, since a converter answers in two.
#
# What it sends is one text of bytes, decimal or 0x hexadecimal, parted by spaces or commas: `bytes = "1 128 0"` is the
# MCP3008's usual three-byte exchange. A repetition that falls due while the target is still selected waits for it to
# be let go; it never cuts a transfer short.

component:spi-controller("SPI controller", type: controller) {
    meta {
        designator: BUS
        summary: "Drives one SPI transaction in mode 0 — its bytes out, as many in — and shows the last two bytes read"
        source: "Motorola SPI block guide, V04.01: mode 0 (CPOL 0, CPHA 0) — data valid on the rising clock edge, shifted on the falling one, most significant bit first"
        category: circuits
    }
    use:cmos-hc

    parameter:bytes("1 128 0", "the bytes sent, up to 16, decimal or 0x hexadecimal; as many are read")
    parameter:clock_frequency(1 MHz, "SCK")
    parameter:start_at(10 us, "when the target is selected")
    parameter:repeat_every(0 s, "the transaction again this long after it began; 0 runs it once")

    pin:sck(digital, output, 1, "serial clock")
    pin:mosi(digital, output, 2, "controller out, target in")
    pin:miso(digital, input, 3, "controller in, target out")
    pin:cs(digital, output, 4, "chip select, active low")
    pin:data[0..7](digital, output, [5, 6, 7, 8, 9, 10, 11, 12], "the last byte read, D0 the least significant bit")
    pin:GND(ground, 13)
    pin:Vcc(power, 14)

    symbol(box) {
        left([sck, mosi, miso, cs bubble])
        right(data)
        power([Vcc, GND])
    }

    state:sent[16](0, discrete, "the bytes of this transaction")
    state:sending(0, discrete, "how many bytes it is")
    state:clocked(0, discrete, "bits clocked so far")
    state:incoming(0, discrete, "the byte being read")
    state:selected(0, discrete, "1 from the select to the release")
    state:waiting(0, discrete, "1 when a repetition fell due while the target was selected")
    state:previous_read(0, discrete, "the byte read before the last one")
    state:last_read(0, discrete, "the last byte read")

    figure:word_read(previous_read * 256 + last_read, "the last two bytes read, as one number")

    behaviour {
        final let MOST_BYTES = 16

        function half_period()
            return 1 / (2 * clock_frequency)
        end

        function put_bit()
            drive('mosi', bit(item(sent, floor(clocked / 8)), 7 - clocked % 8))
        end

        # The bytes it was told to send, read once a transaction; with none it selects and lets go.
        function select_target()
            let written = bytes_of(bytes)
            if written | length > MOST_BYTES then
                refuse('bytes holds ' ~ (written | length) ~ ' bytes; it sends up to ' ~ MOST_BYTES)
            end
            sending = 0
            for value in written do
                sent = with(sent, sending, value)
                sending = sending + 1
            end
            selected = 1
            clocked = 0
            incoming = 0
            drive('cs', 0)
            if sending == 0 then
                schedule('release', half_period())
                return
            end
            put_bit()
            schedule('rise', half_period())
        end

        on start do
            drive('cs', 1)
            drive('sck', 0)
            drive('mosi', 0)
            drive('data', 0)
            schedule('select', start_at)
            if repeat_every > 0 then
                schedule('repeat', start_at + repeat_every)
            end
        end

        on timer 'select' do
            select_target()
        end

        # The rising edge: the target's bit is read. A MISO no target drives yet is read as 0 — a target's "don't care"
        # bits before its answer, which a real controller reads as whatever the line floats at.
        on timer 'rise' do
            drive('sck', 1)
            incoming = incoming * 2 + level_or(miso, 0)
            schedule('fall', half_period())
        end

        # The falling edge: a byte is complete every eighth one, and the next bit goes out.
        on timer 'fall' do
            drive('sck', 0)
            clocked = clocked + 1
            if clocked % 8 == 0 then
                previous_read = last_read
                last_read = incoming
                drive('data', incoming)
                incoming = 0
            end
            if clocked < 8 * sending then
                put_bit()
                schedule('rise', half_period())
            else
                schedule('release', half_period())
            end
        end

        on timer 'release' do
            drive('cs', 1)
            selected = 0
            if waiting == 1 then
                waiting = 0
                schedule('select', half_period())
            end
        end

        # Every repetition is counted from the moment the first transaction began.
        on timer 'repeat' do
            schedule('repeat', repeat_every)
            if selected == 1 then
                waiting = 1
            else
                select_target()
            end
        end
    }
}
