# Generated by the frames generator; a frame is drawn in millimetres about the paper's centre.
frame:iso-a4-landscape-frame("ISO A4, landscape") {
    meta {
        summary: "An ISO 216 A4 sheet, landscape (297 × 210 mm): a 10 mm margin, 6 × 4 zones and a title block filled from the drawing"
        code: "FR.ISO:A4-L"
        category: circuits
        tags: electronics, frame
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(297 x 210)
    # The fields the drawing fills: what the sheet is, whose, which revision of it, and where it stands among its sheets.
    input:company(text)
    input:title(text)
    input:project(text)
    input:date(text)
    input:revision(text)
    input:sheet(text)
    input:file(text)

    # The border: the paper's edge less 10 mm, and inside it the 2 mm band the zones are named in.
    path("M-138.5 -95H138.5V95H-138.5Z")
    path("M-136.5 -93H136.5V93H-136.5Z")
    # The zones: 6 columns numbered across, 4 rows lettered down — "B3" finds a part on the sheet.
    path("M-91 -95V-93M-91 93V95M-45.5 -95V-93M-45.5 93V95M0 -95V-93M0 93V95M45.5 -95V-93M45.5 93V95M91 -95V-93M91 93V95M-138.5 -46.5H-136.5M136.5 -46.5H138.5M-138.5 0H-136.5M136.5 0H138.5M-138.5 46.5H-136.5M136.5 46.5H138.5")
    glyph:column_1_top(at: -113.75 -94, size: 3 x 1.6) {
        fill = signal
        text = "1"
    }
    glyph:column_1_bottom(at: -113.75 94, size: 3 x 1.6) {
        fill = signal
        text = "1"
    }
