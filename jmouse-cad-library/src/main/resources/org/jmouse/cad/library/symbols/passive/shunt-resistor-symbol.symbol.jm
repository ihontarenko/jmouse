symbol:shunt-resistor-symbol("Shunt resistor, four terminals") {
    meta {
        summary: "A current-sense shunt with Kelvin terminals, as drawn on a schematic: the current runs top to bottom, the voltage is taken from the right"
        code: "SY.RESISTOR:SHUNT-KELVIN"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 160)
    input:load(0 .. 1)
    input:failed

    box:loading(live, at: 0 0, size: 28 x 56) {
        live level = load
        live fill = curve(load, 0 -> positive, 0.6 -> warm, 1 -> hot)
    }

    group:body(live) {
        path("M0-80V-32M-14-32H14V32H-14ZM0 32V80M0-40H80M0 40H80")
        live stroke = if(failed > 0.5, burned, signal)
    }

    pin:force_one(at: 0 -80)
    pin:sense_one(at: 80 -40)
    pin:sense_two(at: 80 40)
    pin:force_two(at: 0 80)
    label(name, at: -48 -16)
    label(value, at: -48 24)
}
