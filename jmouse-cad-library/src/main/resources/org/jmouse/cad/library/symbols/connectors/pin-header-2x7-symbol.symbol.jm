symbol:pin-header-2x7-symbol("Pin header, 2 x 7") {
    meta {
        summary: "A two-row pin header of 14, as drawn on a schematic: odd contacts on the left, even on the right, numbered as on the board"
        code: "SY.HDR:2X7"
        category: circuits
        tags: electronics, schematic, connector
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    # Generated from symbol-standards/connector-symbols.sht; regenerate, never edit.
    size(120 x 300)
    path("M-20 -130H20V130H-20ZM-60 -120H-20M20 -120H60M-60 -80H-20M20 -80H60M-60 -40H-20M20 -40H60M-60 0H-20M20 0H60M-60 40H-20M20 40H60M-60 80H-20M20 80H60M-60 120H-20M20 120H60")
    pin:pin1(at: -60 -120, "1")
    pin:pin2(at: 60 -120, "2")
    pin:pin3(at: -60 -80, "3")
    pin:pin4(at: 60 -80, "4")
    pin:pin5(at: -60 -40, "5")
    pin:pin6(at: 60 -40, "6")
    pin:pin7(at: -60 0, "7")
    pin:pin8(at: 60 0, "8")
    pin:pin9(at: -60 40, "9")
    pin:pin10(at: 60 40, "10")
    pin:pin11(at: -60 80, "11")
    pin:pin12(at: 60 80, "12")
    pin:pin13(at: -60 120, "13")
    pin:pin14(at: 60 120, "14")
    label(name, at: 0 -144)
    label(value, at: 0 148)
}
