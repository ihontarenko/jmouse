footprint:pin-header-2x3-pitch-200-vertical-footprint("Pin header, 2.00 mm pitch, 2 × 3, vertical") {
    meta {
        summary: "Pin header, 2.00 mm pitch, 2 rows of 3, upright, through-hole"
        code: "FP.HDR:2X3-P2-V"
        category: circuits
        tags: electronics, footprint, through-hole
        source: "IEC 60603-13 grid"
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    # Generated from footprint-standards/header-packages.sht#pin-header-2-00 and the land pattern rules; regenerate, never edit.
    # Square lead 0.5: drill 0.95, pad 1.75, pin 1 square.
    pad:1(through-hole, rectangle, at: -1 -2, size: 1.75 x 1.75, drill: 0.95)
    pad:2(through-hole, circle, at: 1 -2, size: 1.75 x 1.75, drill: 0.95)
    pad:3(through-hole, circle, at: -1 0, size: 1.75 x 1.75, drill: 0.95)
    pad:4(through-hole, circle, at: 1 0, size: 1.75 x 1.75, drill: 0.95)
    pad:5(through-hole, circle, at: -1 2, size: 1.75 x 1.75, drill: 0.95)
    pad:6(through-hole, circle, at: 1 2, size: 1.75 x 1.75, drill: 0.95)
    outline(fabrication, width: 0.1, "M-1 -3H2V3H-2V-2Z")
    outline(silkscreen, width: 0.12, "M-2.11 -3.11H2.11V3.11H-2.11Z")
    outline(silkscreen, filled, "M-2.91 -2A0.3 0.3 0 1 0 -2.31 -2A0.3 0.3 0 1 0 -2.91 -2Z")
    outline(courtyard, width: 0.05, "M-2.5 -3.5H2.5V3.5H-2.5Z")
}
