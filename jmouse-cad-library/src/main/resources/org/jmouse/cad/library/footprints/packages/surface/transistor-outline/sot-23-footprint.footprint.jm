footprint:sot-23-footprint("SOT-23, 1.3 mm body") {
    meta {
        summary: "3-lead SOT-23, 3 leads, gull-wing, 0.95 mm pitch, body 1.3 × 2.92 mm"
        code: "FP.SOT23:3"
        category: circuits
        tags: electronics, footprint, surface
        source: "JEDEC TO-236 AB, the makers' tighter outline (Nexperia SOT23)"
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    # Generated from footprint-standards/small-outline-packages.sht#sot-23 and the land pattern rules; regenerate, never edit.
    # Leads span 2.2…2.5, foot 0.3…0.5, width 0.3…0.5; fillets toe 0.35, heel 0.35, side 0.03.
    # Z = 3.22, G = 0.629, X = 0.589; pad 1.3 × 0.6 centred at ±0.95.
    pad:1(surface, rounded-rectangle, at: -0.95 -0.95, size: 1.3 x 0.6, roundness: 0.25)
    pad:2(surface, rounded-rectangle, at: -0.95 0.95, size: 1.3 x 0.6, roundness: 0.25)
    pad:3(surface, rounded-rectangle, at: 0.95 0, size: 1.3 x 0.6, roundness: 0.25)
    outline(fabrication, width: 0.1, "M-0.217 -1.46H0.65V1.46H-0.65V-1.027Z")
    outline(silkscreen, width: 0.12, "M-1.6 -1.57H0.65M-0.65 1.57H0.65")
    outline(courtyard, width: 0.05, "M-1.85 -1.7H1.85V1.7H-1.85Z")
}
