# The 2N5457 is the general-purpose n-channel JFET: a few milliamperes at zero gate voltage, a pinch-off anywhere
# between -0.5 and -6 V from part to part — the spread that makes a JFET bias network need adjusting.

component:2n5457("2N5457", type: jfet) {
    meta {
        designator: J
        summary: "N-channel general-purpose JFET, 25 V, IDSS 1 … 5 mA"
        source: "onsemi 2N5457 datasheet, electrical characteristics"
        package: "TO-92"
        category: circuits
        failure: open
    }
    extends:n-jfet

    parameter:V_threshold(-1.372 V, "VTO: inside VGS(off) -0.5 … -6 V")
    parameter:transconductance(1.125 mA/V^2, "BETA: IDSS about 2.1 mA")
    parameter:channel_length_modulation(0.0023, "LAMBDA")
    parameter:R_drain(1 Ohm, "RD")
    parameter:R_source(1 Ohm, "RS")
    parameter:I_saturation(181.3 fA, "IS")
    parameter:C_gate_source(4.5 pF, "CGS")
    parameter:C_gate_drain(6 pF, "CGD")
    parameter:V_junction(0.5 V, "PB")
    parameter:T_nominal(298.15 K, "the temperature the figures above are measured at")
    parameter:threshold_temperature_coefficient(0.002, "VTO moves towards zero by about 2 mV per kelvin")
    parameter:V_threshold_spread(1 V, "VGS(off) -0.5 ... -6 V")
    parameter:transconductance_spread(0.5, "IDSS 1 ... 5 mA")

    pin:source(analog, 1, "source")
    pin:gate(analog, input, 2, "gate")
    pin:drain(analog, output, 3, "drain")

    footprint(to-92-inline-footprint)

    symbol(uses: n-channel-jfet-symbol) {
        bind:failed(failed)
    }

    expect("drain current at zero gate voltage", from: "IDSS 1 … 5 mA at VDS 15 V, VGS 0") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [drain, 0], U_output: 15 V)
            part:U1(self, [gate: 0, drain: drain, source: 0])
        }
        measure(operating, current: V1)
        within(-5 mA .. -1 mA)
    }

    expect("a self-biased stage settles where the source resistor says", from: "source resistor 1 kΩ: VGS = -ID · RS on the transfer curve") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [supply, 0], U_output: 15 V)
            part:R1(resistor, [supply, drain], resistance: 2.2 kOhm)
            part:R2(resistor, [source, 0], resistance: 1 kOhm)
            part:U1(self, [gate: 0, drain: drain, source: source])
        }
        measure(operating, source)
        within(0.3 V .. 1.0 V)
    }

    # How it looks in the hand: its TO-92 package from the front, wired by its pin numbers and printed with its name.
    portrait(uses: to-92-portrait) {
        bind:marking("2N5457")
    }
}
