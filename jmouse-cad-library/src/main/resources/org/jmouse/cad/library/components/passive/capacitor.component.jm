# A capacitor as it is: the charge its capacitance holds at the voltage across it — its value at the corner of its
# tolerance a bench sets, moved by its temperature coefficient from T_nominal. It stores and gives back; it takes no
# power, so it does not warm. Linear at any one temperature, it is integrated as every charge in the circuit is.

component:capacitor("Capacitor", type: capacitor) {
    meta {
        designator: C
        summary: "Two-terminal capacitor: its charge, tolerance and temperature drift"
        category: circuits
        value: capacitance
    }
    parameter:capacitance(100 nF, "capacitance")
    parameter:tolerance(10 %, "how far a part may be from its value, ±; a bench's corners use it")
    parameter:temperature_coefficient(200 ppm/K, "how its value moves per kelvin away from T_nominal; a bench's temperature uses it")
    parameter:T_nominal(298.15 K, "the temperature its value is given at")
    parameter:voltage_rating(50 V, "the most it is made to hold")
    pin:terminal_one(analog, 1, "first terminal")
    pin:terminal_two(analog, 2, "second terminal")
    # While it runs, beside it: how near its rating it is — the voltage across it against that rating, which is also
    # its charge against the charge it holds there. Past 100 % it fails.
    figure:overvoltage(100 * abs(terminal_one - terminal_two) / voltage_rating, unit: %, "of its rated voltage")

    equations {
        let C_now : capacitance = capacitance * (1 + tolerance_corner * tolerance) * (1 + temperature_coefficient * (temperature - T_nominal))
        current terminal_one -> terminal_two = d(C_now * (terminal_one - terminal_two))/dt
    }

    # Drawn plain, or as an electrolytic — the polarized drawing, its "+" on terminal_one — by a part's `symbol` choice.
    symbol(uses: [capacitor-symbol, polarized-capacitor-symbol]) {
        bind:failed(failed)
        bind:charge((terminal_one - terminal_two) / voltage_rating)
        bind:a(pin: terminal_one)
        bind:b(pin: terminal_two)
    }

    # How it looks in the hand: a ceramic disc printed with its picofarad code.
    portrait(uses: ceramic-disc-capacitor-portrait) {
        bind:capacitance(capacitance)
    }
}
