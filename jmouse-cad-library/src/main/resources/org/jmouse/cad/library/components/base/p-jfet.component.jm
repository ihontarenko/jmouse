# A p-channel JFET at the level-1 model's defaults: what an imported `.model … PJF(…)` is meant to become. A datasheet
# p-channel part is a member of this family.

component:p-jfet("P-channel JFET", type: jfet) {
    meta {
        designator: J
        summary: "P-channel JFET, the level-1 model at its defaults"
        category: circuits
        failure: open
    }
    extends:junction-field-effect-transistor

    parameter:polarity(-1, "p-channel")

    symbol(uses: p-channel-jfet-symbol) {
        bind:failed(failed)
    }
}
