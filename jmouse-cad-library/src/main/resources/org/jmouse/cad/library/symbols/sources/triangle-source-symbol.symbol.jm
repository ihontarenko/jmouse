symbol:triangle-source-symbol("Triangle voltage source") {
    meta {
        summary: "A voltage source that ramps up and down between two levels, as drawn on a schematic"
        code: "SY.SOURCE:VOLTAGE-TRIANGLE"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 80)
    path("M-80 0H-32M32 0H80M-32 0A32 32 0 1 0 32 0A32 32 0 1 0-32 0M-20 10L-10-10L0 10L10-10L20 10M-52-18V-6M-58-12H-46")
    pin:a(at: -80 0)
    pin:b(at: 80 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
