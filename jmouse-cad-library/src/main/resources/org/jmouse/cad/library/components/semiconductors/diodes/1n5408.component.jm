# The 1N5408 is the 1N4007 grown to 3 A: the same 1000 V standard-recovery rectifier with a junction three times the
# area — more saturation current, less series resistance, more capacitance, the same microseconds of stored charge.

component:1n5408("1N5408", type: diode) {
    meta {
        designator: D
        summary: "General-purpose rectifier, 1000 V, 3 A"
        source: "Vishay 1N5400 thru 1N5408 datasheet (DO-201AD), electrical characteristics at 25 °C"
        package: "DO-201AD"
        category: circuits
        failure: short
    }
    extends:diode
    parameter:I_saturation(10 nA, "IS: fitted to VF 1.0 V at 3 A with the series resistance below")
    parameter:emission_coefficient(1.9, "N")
    parameter:R_series(20 mOhm, "RS")
    parameter:C_junction_zero_bias(45 pF, "CJO: about 30 pF at 4 V")
    parameter:V_junction(0.7 V, "VJ")
    parameter:grading_coefficient(0.5, "M")
    parameter:transit_time(4 us, "TT: a standard-recovery rectifier stores microseconds of charge")
    parameter:V_breakdown(1200 V, "avalanche above the rated 1000 V")
    parameter:I_breakdown(10 uA, "current at V_breakdown")
    parameter:E_gap(1.11 V, "EG")
    parameter:saturation_temperature_exponent(3, "XTI")
    # How it warms and where it gives up (DO-201AD on 9.5 mm leads: RθJA about 20 K/W, TJ max 150 °C).
    parameter:power_rating(6 W, "what it is rated for")
    parameter:thermal_resistance(20 K/W, "kelvin above the bench per watt it takes")
    parameter:thermal_time_constant(5 s, "how fast it warms to that")
    parameter:T_maximum(150 °C, "past this it fails on a realistic bench")
    parameter:V_reverse_maximum(1000 V, "VRRM")
    parameter:I_forward_maximum(3 A, "IF(AV)")
    pin:anode(analog, 1, "anode")
    pin:cathode(analog, 2, "cathode, the banded end")
    symbol(uses: diode-symbol) {
        bind:failed(failed)
        bind:a(pin: anode)
        bind:b(pin: cathode)
    }

    expect("forward voltage at 3 A", from: "electrical characteristics, VF at most 1.2 V at 3 A") {
        bench(for: 1 ms) {
            part:X1(forward, current: 3 A)
        }
        measure(operating, anode)
        within(0.8 V .. 1.2 V)
    }

    expect("reverse current at 1000 V", from: "electrical characteristics, IR at most 5 uA at VRRM, 25 C") {
        bench(for: 1 ms) {
            part:X1(reverse, voltage: 1000 V)
        }
        measure(operating, current: V1)
        within(-5 uA .. 0 A)
    }
}
