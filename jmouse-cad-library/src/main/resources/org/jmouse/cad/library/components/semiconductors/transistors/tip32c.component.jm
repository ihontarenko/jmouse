# The TIP32C is the TIP31C's PNP complement: the same power-transistor figures — a large saturation current, a
# modest gain, a knee at amperes —, every sign reversed. At amperes the series resistances, not the junctions, set
# VCE(sat) and VBE(on).

component:tip32c("TIP32C", type: bjt) {
    meta {
        designator: Q
        summary: "PNP power transistor, -100 V, -3 A"
        source: "onsemi TIP32 series datasheet (the TIP31 complement)"
        package: "TO-220"
        category: circuits
        failure: short
    }
    extends:pnp-transistor

    parameter:I_saturation(1 pA, "IS: transport saturation current")
    parameter:beta_forward(80, "BF: ideal forward current gain")
    parameter:beta_reverse(5, "BR: ideal reverse current gain")
    parameter:V_early(100 V, "VAF: forward Early voltage")
    parameter:I_knee(2 A, "IKF: forward knee current: above it the gain falls")
    parameter:R_base(3 Ohm, "RB: part of VBE(on) at amperes")
    parameter:R_collector(0.15 Ohm, "RC: most of VCE(sat) at amperes")
    parameter:R_emitter(0.05 Ohm, "RE: emitter resistance and bond wire")
    parameter:C_base_emitter(300 pF, "CJE")
    parameter:C_base_collector(80 pF, "CJC")
    parameter:transit_time_forward(50 ns, "TF: from fT at least 3 MHz — an approximation, the datasheet gives no model")
    parameter:V_breakdown(100 V, "collector-emitter sustaining voltage: an inductive kick stops here")
    parameter:I_breakdown(1 mA, "avalanche current at V_breakdown")
    parameter:T_nominal(298.15 K, "the temperature the figures above are measured at")
    # How it warms and where it gives up (TO-220 without a heatsink: 2 W at 25 °C, RθJA 62.5 K/W, TJ max 150 °C).
    parameter:power_rating(2 W, "what it is rated for without a heatsink")
    parameter:thermal_resistance(62.5 K/W, "kelvin above the bench per watt it takes")
    parameter:thermal_time_constant(30 s, "how fast it warms to that")
    parameter:T_maximum(150 °C, "past this it fails on a realistic bench")
    parameter:V_collector_emitter_maximum(100 V, "VCEO")
    parameter:I_collector_maximum(3 A, "IC, continuous")

    pin:base(analog, input, 1, "base")
    pin:collector(analog, output, 2, "collector; the tab is collector too")
    pin:emitter(analog, 3, "emitter")

    footprint(to-220-3-vertical-footprint)

    symbol(uses: pnp-transistor-symbol) {
        bind:failed(failed)
    }

    expect("DC current gain at about -1 A", from: "hFE at least 25 at IC -1 A, VCE -4 V") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [0, collector], U_output: 4 V)
            part:I1(current-source, [0, base], I_output: 20 mA)
            part:U1(self, [base: base, collector: collector, emitter: 0])
        }
        measure(operating, current: V1)
        within(-2 A .. -0.5 A)
    }

    # How it looks in the hand: its TO-220 package from the front, wired by its pin numbers and printed with its name.
    portrait(uses: to-220-portrait) {
        bind:marking("TIP32C")
    }
}
