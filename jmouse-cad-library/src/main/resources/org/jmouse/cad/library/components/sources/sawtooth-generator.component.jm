# An ideal sawtooth voltage: a straight rise from the low level to the high one over the whole period, then back to
# the low level at once. The fall is an edge — the engine lands a step on it, where the `mod` wraps.

component:sawtooth-generator("Sawtooth generator", type: generator) {
    meta {
        designator: G
        summary: "An ideal sawtooth voltage: a straight rise over the whole period and an instant fall"
        category: circuits
    }

    parameter:high(5 V, "the level each ramp reaches")
    parameter:low(0 V, "the level each ramp starts from")
    parameter:frequency(1 kHz, "how many periods a second")

    pin:positive(analog, 1, "positive terminal")
    pin:negative(analog, 2, "negative terminal")

    symbol(uses: sawtooth-source-symbol) {
        bind:a(pin: positive)
        bind:b(pin: negative)
    }

    equations {
        voltage positive -> negative = low + (high - low) * mod(frequency * time, 1)
    }
}
