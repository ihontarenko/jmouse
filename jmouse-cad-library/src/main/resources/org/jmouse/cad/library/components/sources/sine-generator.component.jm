# An ideal sine voltage, written as what it is: one equation of the time. The engine sees a generator — one voltage
# between its two pins, no state, nothing read from the circuit — and holds its nodes as an ideal source does.

component:sine-generator("Sine generator", type: generator) {
    meta {
        designator: G
        summary: "An ideal sine voltage: offset + amplitude · sin(2π · frequency · time + phase)"
        category: circuits
    }

    parameter:amplitude(1 V, "peak voltage above the offset")
    parameter:frequency(50 Hz, "how many periods a second")
    parameter:phase(0 rad, "where the period stands at time 0")
    parameter:offset(0 V, "the voltage it swings around")

    pin:positive(analog, 1, "positive terminal")
    pin:negative(analog, 2, "negative terminal")

    symbol(uses: alternating-source-symbol) {
        bind:a(pin: positive)
        bind:b(pin: negative)
    }

    equations {
        voltage positive -> negative = offset + amplitude * sin(2 * pi * frequency * time + phase)
    }
}
