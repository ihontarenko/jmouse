# 74HC32: 4 gates of Y = A + B in one 14-pin package — the gates of a lesson's logic, each its own unit
# (A, B, C, D) with its own inputs and output, sharing the supply. Pinout as JEDEC numbers it (DIP-14, SOIC-14).

component:74hc32("74HC32", type: gate) {
    meta {
        designator: U
        summary: "Quad 2-input OR gate: each output high while either of its inputs is high"
        source: "TI SN74HC32: tpd about 10 ns typical at 4.5 V, CL = 50 pF — an approximation; the 18 ns maximum at 25 °C bounds it; pinout per the JEDEC 14-pin standard"
        package: "DIP-14, SOIC-14"
        category: circuits
        failure: short Vcc GND
    }
    extends:or-gate
    use:cmos-hc
    units:[A, B, C, D]

    parameter:propagation_delay(10 ns, "input to output at 4.5 V, typical")
    parameter:thermal_resistance(120 K/W, "kelvin above the bench per watt it takes (DIP-14 in still air)")
    parameter:thermal_time_constant(5 s, "how fast it warms to that")
    parameter:T_maximum(150 °C, "past this it fails on a realistic bench")

    pin:a(digital, input, 1 4 9 12, "input A")
    pin:b(digital, input, 2 5 10 13, "input B")
    pin:output(digital, output, 3 6 8 11, "output Y")
    pin:GND(ground, 7)
    pin:Vcc(power, 14)

    symbol(box) {
        left([a, b])
        right(output)
        power([Vcc, GND])
    }

    expect("gate A: A 0, B 0 gives 0", from: "function table: Y = A + B; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 0 V)
            part:V3(voltage-source, [b, 0], U_output: 0 V)
            part:U1(self, [A.a: a, A.b: b, A.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(0 V .. 0.1 V)
    }

    expect("gate A: A 0, B 1 gives 1", from: "function table: Y = A + B; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 0 V)
            part:V3(voltage-source, [b, 0], U_output: 5 V)
            part:U1(self, [A.a: a, A.b: b, A.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(4.4 V .. 5 V)
    }

    expect("gate A: A 1, B 0 gives 1", from: "function table: Y = A + B; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 5 V)
            part:V3(voltage-source, [b, 0], U_output: 0 V)
            part:U1(self, [A.a: a, A.b: b, A.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(4.4 V .. 5 V)
    }

    expect("gate A: A 1, B 1 gives 1", from: "function table: Y = A + B; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 5 V)
            part:V3(voltage-source, [b, 0], U_output: 5 V)
            part:U1(self, [A.a: a, A.b: b, A.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(4.4 V .. 5 V)
    }

    expect("gate D: A 1, B 1 gives 1", from: "function table: Y = A + B; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 5 V)
            part:V3(voltage-source, [b, 0], U_output: 5 V)
            part:U1(self, [D.a: a, D.b: b, D.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(4.4 V .. 5 V)
    }
}
