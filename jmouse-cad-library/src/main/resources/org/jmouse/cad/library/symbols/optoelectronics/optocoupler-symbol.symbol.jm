symbol:optocoupler-symbol("Optocoupler") {
    meta {
        summary: "Optocoupler, as drawn on a schematic: its LED lights with the current it is given, its light crosses the barrier, and the phototransistor conducts with what it receives"
        code: "SY.OPTOCOUPLER:TRANSISTOR"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(200 x 160)
    input:light(0 .. 1)
    input:conduction(0 .. 1)
    input:failed

    # The LED lights with its current against its rating — infrared in a PC817, drawn red so it can be seen — and its
    # rays across the barrier with it. Drawn under the outline, so the outline stays as drawn.
    path:led(live, "M-56-12H-24L-40 12Z") {
        stroke = clear
        fill = red
        live opacity = curve(light, 0 -> 0, 0.01 -> 0.35, 0.1 -> 0.75, 1 -> 0.95)
        live glow = curve(light, 0 -> 0, 0.1 -> 5, 1 -> 9)
    }

    group:body(live) {
        path("M-72-60H72V60H-72ZM-100-40H-40V-12M-40 12V40H-100M-56-12H-24L-40 12ZM-56 12H-24M28-24V24M28-10L56-28V-40H100M28 10L56 28V40H100M44 26L56 28L50 18")
        live stroke = if(failed > 0.5, burned, signal)
    }

    path:rays(live, "M-12-10H12M4-16L12-10L4-4M-12 10H12M4 4L12 10L4 16") {
        live stroke = if(failed > 0.5, burned, if(light > 0.01, red, signal))
        live glow = curve(light, 0 -> 0, 0.1 -> 3, 1 -> 6)
    }

    # The phototransistor carries what the light lets through: its channel lit with the collector current against its
    # rating, as an eye takes a light (`seen`).
    path:channel(live, "M28-10L56-28V-40M28 10L56 28V40") {
        stroke = positive
        live opacity = seen(conduction)
        live glow = 9 * seen(conduction)
    }

    layer(live, failed > 0.5) {
        path:scorch("M-14-18L-6-6M12-16L4-4M-12 16L-4 6M14 18L6 6M-20 0H-10M20 0H10")
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin:anode(at: -100 -40)
    pin:cathode(at: -100 40)
    pin:collector(at: 100 -40)
    pin:emitter(at: 100 40)
    label(name, at: 0 -80)
    label(value, at: 0 88)
}
