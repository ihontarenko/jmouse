# 74HC4017: a decade counter with ten decoded outputs — the one high output steps along Q0 to Q9 and round again, the
# running light of a lesson. It counts on CP0 rising while CP1 is low, or on CP1 falling while CP0 is high; MR high
# sends it to nought at once. Q5-9, the carry, is high for counts nought to four: a tenth of the clock, for the next
# decade.

component:74hc4017("74HC4017", type: counter) {
    meta {
        designator: U
        summary: "Decade counter with ten decoded outputs: one high output stepping Q0 to Q9 on each clock"
        source: "TI CD74HC4017 (SCLS550): function table; CP0 to Qn 19 ns typical at 5 V, CL = 15 pF, 46 ns maximum at 4.5 V, CL = 50 pF; pinout per the data sheet"
        package: "DIP-16, SOIC-16"
        category: circuits
        failure: short Vcc GND
    }
    use:cmos-hc

    parameter:propagation_delay(19 ns, "clock to an output, typical at 5 V, CL = 15 pF")
    parameter:thermal_resistance(120 K/W, "kelvin above the bench per watt it takes (DIP-16 in still air)")
    parameter:thermal_time_constant(5 s, "how fast it warms to that")
    parameter:T_maximum(150 °C, "past this it fails on a realistic bench")

    pin:output[0..9](digital, output, [3, 2, 4, 7, 10, 1, 5, 6, 9, 11], "Q0 to Q9, the one high output")
    pin:GND(ground, 8)
    pin:carry(digital, output, 12, "Q5-9, high for counts nought to four")
    pin:not_clock_enable(digital, input, 13, "CP1, clock enable, active low; its falling edge counts while CP0 is high")
    pin:clock(digital, input, 14, "CP0, counts on its rising edge while CP1 is low")
    pin:master_reset(digital, input, 15, "MR, back to nought at once, active high")
    pin:Vcc(power, 16)

    symbol(box) {
        left([clock edge, not_clock_enable bubble, master_reset])
        right([output, carry])
        power([Vcc, GND])
    }

    state:value(X, discrete, "which output is high, unknown until the counter is reset")

    behaviour {
        function advance()
            if known(value) then
                if value == 9 then
                    value = 0
                else
                    value = value + 1
                end
            end
            show()
        end

        function show()
            let delay : time = propagation_delay * delay_scale(Vcc - GND)
            if known(value) then
                drive('output', shift_left(1, value, 10), delay)
                if value < 5 then
                    drive('carry', 1, delay)
                else
                    drive('carry', 0, delay)
                end
            else
                drive('output', X, delay)
                drive('carry', X, delay)
            end
        end

        on start do
            if master_reset == 1 then
                value = 0
            end
            show()
        end

        on rising 'master_reset' do
            value = 0
            show()
        end

        on rising 'clock' when not_clock_enable == 0 and master_reset == 0 do
            advance()
        end

        on falling 'not_clock_enable' when clock == 1 and master_reset == 0 do
            advance()
        end
    }

    expect("reset, three clock edges light Q3", from: "function table: one high output, stepping on each rising CP0 edge") {
        bench(for: 3.5 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            # MR high for the first 0.5 µs: the counter starts at nought.
            part:V2(square-generator, [positive: master_reset, negative: 0], high: 5 V, low: 0 V, frequency: 20 kHz, duty: 0.01)
            part:V3(square-generator, [positive: clock, negative: 0], high: 5 V, frequency: 1 MHz)
            part:U1(self, [clock: clock, not_clock_enable: 0, master_reset: master_reset, output_2: q2, output_3: q3, output_4: q4, carry: carry, Vcc: Vcc, GND: 0])
        }
        measure(final, levels: [q2, q3, q4])
        is([0,1,0])
    }

    expect("past four the carry is low", from: "function table: Q5-9 low for counts five to nine") {
        bench(for: 7.5 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(square-generator, [positive: master_reset, negative: 0], high: 5 V, low: 0 V, frequency: 20 kHz, duty: 0.01)
            part:V3(square-generator, [positive: clock, negative: 0], high: 5 V, frequency: 1 MHz)
            part:U1(self, [clock: clock, not_clock_enable: 0, master_reset: master_reset, carry: carry, Vcc: Vcc, GND: 0])
        }
        measure(final, level: carry)
        near(0, +- 0.01)
    }

    expect("after Q9 it comes round to Q0", from: "function table: the count wraps after nine") {
        bench(for: 10.5 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(square-generator, [positive: master_reset, negative: 0], high: 5 V, low: 0 V, frequency: 20 kHz, duty: 0.01)
            part:V3(square-generator, [positive: clock, negative: 0], high: 5 V, frequency: 1 MHz)
            part:U1(self, [clock: clock, not_clock_enable: 0, master_reset: master_reset, output_0: q0, output_9: q9, Vcc: Vcc, GND: 0])
        }
        measure(final, levels: [q0, q9])
        is([1,0])
    }

    expect("CP1 high holds the count", from: "function table: CP1 high inhibits counting") {
        bench(for: 3.5 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(square-generator, [positive: master_reset, negative: 0], high: 5 V, low: 0 V, frequency: 20 kHz, duty: 0.01)
            part:V3(square-generator, [positive: clock, negative: 0], high: 5 V, frequency: 1 MHz)
            part:V4(voltage-source, [inhibit, 0], U_output: 5 V)
            part:U1(self, [clock: clock, not_clock_enable: inhibit, master_reset: master_reset, output_0: q0, Vcc: Vcc, GND: 0])
        }
        measure(final, levels: q0)
        is([1])
    }
}
