component:wattmeter("Wattmeter", type: meter) {
    meta {
        designator: WM
        summary: "Reads the power a load takes: its current through in and out, its voltage across plus and minus"
        category: circuits
    }
    parameter:R_input(10 MOhm, "voltage input resistance: what it draws through, on a realistic bench")
    pin:in(analog, 1, "current in")
    pin:out(analog, 2, "current out")
    pin:plus(analog, 3, "voltage, red lead")
    pin:minus(analog, 4, "voltage, black lead")
    equations {
        voltage in -> out = 0
        current plus -> minus = realistic * (plus - minus) / R_input
    }
    lead:in(yellow, stripes: black)
    lead:out(yellow)
    lead:plus(red, stripes: black)
    lead:minus(black, stripes: white)
    reading:reading((plus - minus) * in.current, unit: W, signal)
    symbol(uses: wattmeter-symbol) {
        bind:a(pin: in)
        bind:b(pin: out)
        bind:c(pin: plus)
        bind:d(pin: minus)
    }

    expect("neither drops nor draws on an ideal bench", from: "an ideal wattmeter on a 1 kOhm load leaves all 10 V across it") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [top, 0], U_output: 10 V)
            part:U1(self, [in: top, out: load, plus: load, minus: 0])
            part:R1(resistor, [load, 0], resistance: 1 kOhm)
        }
        measure(final, load)
        near(10 V, +- 0.1%)
    }
}
