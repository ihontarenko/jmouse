# A switch that is closed only while it is held.
component:push-button("Push button", type: button) {
    meta {
        designator: SW
        summary: "A momentary switch: closed while it is held, open when it is let go"
        category: circuits
    }

    parameter:closed(0, in: 0 .. 1, step: 1, integer, live, "Pressed")
    parameter:R_closed(10 mOhm, "contact resistance when pressed")
    parameter:R_open(100 MOhm, "leakage resistance when released")

    pin:a(analog, 1, "first contact")
    pin:b(analog, 2, "second contact")

    symbol(uses: [push-button-symbol, switch-symbol]) {
        bind:closed(closed)
    }

    equations {
        current a -> b = (a - b) / (closed * R_closed + (1 - closed) * R_open)
    }

    # How it looks in the hand: a tactile switch whose plunger sinks while it is held.
    portrait(uses: tactile-button-portrait) {
        bind:closed(closed)
    }
}
