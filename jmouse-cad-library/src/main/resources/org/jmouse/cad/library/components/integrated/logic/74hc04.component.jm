# 74HC04: 6 gates of Y = ¬A in one 14-pin package — the gates of a lesson's logic, each its own unit
# (A, B, C, D, E, F) with its own inputs and output, sharing the supply. Pinout as JEDEC numbers it (DIP-14, SOIC-14).

component:74hc04("74HC04", type: gate) {
    meta {
        designator: U
        summary: "Hex inverter: each output high while its input is low"
        source: "TI SN74HC04-Q1: tpd 9 ns typical, 19 ns maximum at 4.5 V, CL = 50 pF, 25 °C; pinout per the JEDEC 14-pin standard"
        package: "DIP-14, SOIC-14"
        category: circuits
        failure: short Vcc GND
    }
    extends:not-gate
    use:cmos-hc
    units:[A, B, C, D, E, F]

    parameter:propagation_delay(9 ns, "input to output at 4.5 V, typical")
    parameter:thermal_resistance(120 K/W, "kelvin above the bench per watt it takes (DIP-14 in still air)")
    parameter:thermal_time_constant(5 s, "how fast it warms to that")
    parameter:T_maximum(150 °C, "past this it fails on a realistic bench")

    pin:a(digital, input, 1 3 5 9 11 13, "input A")
    pin:output(digital, output, 2 4 6 8 10 12, "output Y")
    pin:GND(ground, 7)
    pin:Vcc(power, 14)

    symbol(box) {
        left(a)
        right(output)
        power([Vcc, GND])
    }

    expect("gate A: A 0 gives 1", from: "function table: Y = ¬A; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 0 V)
            part:U1(self, [A.a: a, A.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(4.4 V .. 5 V)
    }

    expect("gate A: A 1 gives 0", from: "function table: Y = ¬A; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 5 V)
            part:U1(self, [A.a: a, A.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(0 V .. 0.1 V)
    }

    expect("gate F: A 1 gives 0", from: "function table: Y = ¬A; VOH 4.4 V minimum, VOL 0.1 V maximum at 4.5 V") {
        bench(for: 1 us) {
            part:V1(voltage-source, [Vcc, 0], U_output: 5 V)
            part:V2(voltage-source, [a, 0], U_output: 5 V)
            part:U1(self, [F.a: a, F.output: output, Vcc: Vcc, GND: 0])
            part:R1(resistor, [output, 0], resistance: 100 kOhm)
        }
        measure(final, output)
        within(0 V .. 0.1 V)
    }
}
