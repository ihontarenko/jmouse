    pad:1(through-hole, rectangle, at: -1 -3, size: 1.75 x 1.75, drill: 0.95)
    pad:2(through-hole, circle, at: 1 -3, size: 1.75 x 1.75, drill: 0.95)
    pad:3(through-hole, circle, at: -1 -1, size: 1.75 x 1.75, drill: 0.95)
    pad:4(through-hole, circle, at: 1 -1, size: 1.75 x 1.75, drill: 0.95)
