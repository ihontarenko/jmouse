    pad:7(through-hole, circle, at: -1 3, size: 1.75 x 1.75, drill: 0.95)
    pad:8(through-hole, circle, at: 1 3, size: 1.75 x 1.75, drill: 0.95)
    outline(fabrication, width: 0.1, "M-1 -4H2V4H-2V-3Z")
    outline(silkscreen, width: 0.12, "M-2.11 -4.11H2.11V4.11H-2.11Z")
