footprint:pin-header-2x4-pitch-200-vertical-footprint("Pin header, 2.00 mm pitch, 2 × 4, vertical") {
    meta {
        summary: "Pin header, 2.00 mm pitch, 2 rows of 4, upright, through-hole"
        code: "FP.HDR:2X4-P2-V"
        category: circuits
        tags: electronics, footprint, through-hole
        source: "IEC 60603-13 grid"
