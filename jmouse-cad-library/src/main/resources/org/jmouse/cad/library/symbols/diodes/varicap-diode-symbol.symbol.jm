symbol:varicap-diode-symbol("Varicap diode") {
    meta {
        summary: "Variable-capacitance diode, as drawn on a schematic: a diode with a capacitor's second plate, its plates thickening as the reverse voltage narrows its capacitance"
        code: "SY.DIODE:VARICAP"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(120 x 80)
    input:forward(0 .. 1)
    input:reverse(0 .. 1)
    input:failed
    path:die(live, "M-24-24L24 0-24 24Z") {
        stroke = clear
        fill = positive
        live opacity = seen(forward)
        live glow = 9 * seen(forward)
    }
    group:body(live) {
        path("M-60 0H-24V-24L24 0-24 24V0M36 0H60")
        live stroke = if(failed > 0.5, burned, signal)
    }
    # Reversed, it is a capacitor: its two plates take the colour of − and thicken as the voltage across them rises.
    path:plates(live, "M24-24V24M36-24V24") {
        live stroke = if(failed > 0.5, burned, if(reverse > 0.005, negative, signal))
        live thickness = curve(reverse, 0 -> 1, 1 -> 2.2)
    }
    layer(live, failed > 0.5) {
        path:scorch("M-14-18L-6-6M12-16L4-4M-12 16L-4 6M14 18L6 6M-20 0H-10M20 0H10")
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin:a(at: -60 0)
    pin:b(at: 60 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
