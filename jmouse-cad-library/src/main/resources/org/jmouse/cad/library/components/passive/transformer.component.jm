# Two coupled windings on one core — what SPICE writes as two inductors and a K line, with what a real transformer has
# besides. The state is the flux each winding links: Φ1 = L1 · I1 + M · I2, Φ2 = M · I1 + L2 · I2, M = k · √(L1 · L2);
# the voltage behind a winding's copper is the rate of its flux, and its current is read back through the inverse of the
# inductance matrix. The turns ratio is √(L1 / L2); a coupling below 1 is the leakage inductance a real core has. The
# `_one` pins are the dotted ends: a current into both makes flux the same way.
#
#   primary_one ── R_primary ── primary_winding ──┬── (Φ1) ──┬── primary_two
#        │                                        └─ R_core ─┘       │
#        └────────────────────── C_primary ──────────────────────────┘
#   secondary_one ── R_secondary ── secondary_winding ── (Φ2) ── secondary_two, C_secondary across it
#   C_interwinding between the dotted ends: the capacitance between the two windings across their insulation.
#
#   - R_core, the core's iron loss (eddy currents and hysteresis), across the primary's flux: what a transformer takes
#     with no load beyond its magnetising current, and what damps it once a switch cuts that current;
#   - C_primary, C_secondary, each winding's self-capacitance: with the leakage they set where it rings;
#   - C_interwinding: what carries the primary's fast edges into an isolated secondary.
# Without them (as until 2026-10-20) a cut primary rang on whatever few picofarads the circuit offered, with a Q of
# thousands. The figures are a small mains transformer's; a datasheet gives the copper, the rest is typical.
# Not represented: the core's saturation and hysteresis loop.

component:transformer("Transformer", type: transformer) {
    meta {
        designator: T
        summary: "Two coupled windings: self and mutual inductance, leakage, winding resistance, core loss and winding capacitance"
        source: "coupled inductors as in Berkeley SPICE3 / ngspice 47 (L, L, K), with the core loss and capacitances of a small mains transformer"
        category: circuits
        failure: open
    }

    parameter:L_primary(10 H, "primary inductance: the magnetising inductance seen from the primary")
    parameter:L_secondary(0.1 H, "secondary inductance: turns ratio √(L1 / L2) = 10")
    parameter:coupling(0.999, "K: 1 is a perfect core; below it, leakage")
    parameter:R_primary(10 Ohm, "primary winding resistance")
    parameter:R_secondary(0.1 Ohm, "secondary winding resistance")
    parameter:R_core(100 kOhm, "core loss across the primary: about half a watt at 230 V, a small mains core's no-load loss")
    parameter:C_primary(1 nF, "the primary's self-capacitance, between its many turns and layers")
    parameter:C_secondary(1 nF, "the secondary's self-capacitance")
    parameter:C_interwinding(200 pF, "between the windings, across their insulation")
    parameter:copper_temperature_coefficient(0.00393, "copper: the windings' resistance rises 0.393 % per kelvin")
    parameter:T_nominal(298.15 K, "the temperature the resistances are given at")
    parameter:power_rating(10 W, "what it is rated for")
    parameter:thermal_resistance(10 K/W, "kelvin above the bench per watt it takes")
    parameter:thermal_time_constant(300 s, "how fast it warms to that")
    parameter:T_maximum(120 °C, "past this it fails on a realistic bench")

    pin:primary_one(analog, 1, "primary, dotted end")
    pin:primary_two(analog, 2, "primary")
    pin:secondary_one(analog, 3, "secondary, dotted end")
    pin:secondary_two(analog, 4, "secondary")

    node:primary_winding("behind the primary's copper")
    node:secondary_winding("behind the secondary's copper")

    state:flux_primary(0, continuous, "the flux the primary links, Φ1, in webers")
    state:flux_secondary(0, continuous, "the flux the secondary links, Φ2")

    symbol(uses: [transformer-symbol, transformer-air-core-symbol]) {
        bind:failed(failed)
    }

    equations {
        # temperature is the part's own: the bench's, and on a realistic bench raised by its own heat, which the engine keeps
        let T_winding : temperature = temperature
        let warming : ratio = 1 + copper_temperature_coefficient * (T_winding - T_nominal)
        # On a draft bench (detail 0) the windings store no charge, as a junction stores none there.
        let stored : ratio = min(detail, 1)
        # The inductance matrix inverted — each winding's current from the two fluxes. Its determinant is L1 · L2 · (1 − k²):
        # the leakage share, which is all that separates the windings' currents from one another.
        let L_mutual_scale : inductance = sqrt(L_primary * L_secondary)
        let leakage : ratio = 1 - coupling ^ 2
        let I_primary : current = (flux_primary / L_primary - coupling * flux_secondary / L_mutual_scale) / leakage
        let I_secondary : current = (flux_secondary / L_secondary - coupling * flux_primary / L_mutual_scale) / leakage

        current primary_one -> primary_winding = (primary_one - primary_winding) / (R_primary * warming)
        d(flux_primary)/dt = primary_winding - primary_two
        current primary_winding -> primary_two = I_primary + (primary_winding - primary_two) / R_core
        current primary_one -> primary_two = d(stored * C_primary * (primary_one - primary_two))/dt

        current secondary_one -> secondary_winding = (secondary_one - secondary_winding) / (R_secondary * warming)
        d(flux_secondary)/dt = secondary_winding - secondary_two
        current secondary_winding -> secondary_two = I_secondary
        current secondary_one -> secondary_two = d(stored * C_secondary * (secondary_one - secondary_two))/dt

        current primary_one -> secondary_one = d(stored * C_interwinding * (primary_one - secondary_one))/dt
    }

    expect("ten to one on a loaded secondary", from: "turns ratio √(L1 / L2) = 10: 100 V peak in, about 10 V peak out into 100 Ω") {
        bench(for: 60 ms) {
            part:V1(sine-generator, [positive: input, negative: 0], amplitude: 100 V, frequency: 50 Hz)
            part:U1(self, [primary_one: input, primary_two: 0, secondary_one: output, secondary_two: 0])
            part:R1(resistor, [output, 0], resistance: 100 Ohm)
        }
        measure(maximum, output, after: 40 ms)
        within(9 V .. 10.2 V)
    }
}
