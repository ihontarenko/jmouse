symbol:battery-cell-symbol("Battery cell") {
    meta {
        summary: "One battery cell, as drawn on a schematic: the long plate is its +, the bar under it as full as its charge"
        code: "SY.SOURCE:CELL"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 80)
    input:state_of_charge
    input:failed
    group:body(live) {
        path("M-80 0H-8M-8-30V30M8-16V16M8 0H80")
        live stroke = if(failed > 0.5, burned, signal)
    }
    box:charge(live, at: 0 44, size: 40 x 12) {
        live level = state_of_charge
        live fill = curve(state_of_charge, 0 -> hot, 0.2 -> warm, 0.5 -> positive)
    }
    layer(live, failed > 0.5) {
        path:scorch("M-14-18L-6-6M12-16L4-4M-12 16L-4 6M14 18L6 6M-20 0H-10M20 0H10")
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin:a(at: -80 0)
    pin:b(at: 80 0)
    label(name, at: 0 -52)
    label(value, at: 0 72)
}
