# The inverter every such logic part is a member of: its rule, Y = ¬A, and its delay. Its thresholds, its output's
# strength and how it slows at a low supply are its family's — 74HC CMOS unless a part says otherwise. An unknown
# input gives an unknown output.

component:not-gate("Inverter", type: gate) {
    meta {
        designator: U
        summary: "An inverter: high while its input is low"
        source: "the gate's function table: Y = ¬A"
        category: circuits
        failure: short Vcc GND
    }
    use:cmos-hc

    parameter:propagation_delay(10 ns, "input to output at the family's nominal supply")

    pin:a(digital, input, 2, "input A")
    pin:GND(ground, 3)
    pin:output(digital, output, 4, "output Y")
    pin:Vcc(power, 5)

    symbol(uses: not-gate-symbol)

    behaviour {
        function level()
            if a == 0 then
                return 1
            elseif a == 1 then
                return 0
            end
            return X
        end

        function show()
            drive('output', level(), propagation_delay * delay_scale(Vcc - GND))
        end

        on start do
            show()
        end

        on change 'a' do
            show()
        end
    }
}
