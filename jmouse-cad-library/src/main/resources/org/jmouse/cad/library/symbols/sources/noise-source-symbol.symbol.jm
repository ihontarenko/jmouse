symbol:noise-source-symbol("Noise source") {
    meta {
        summary: "A voltage source whose voltage is noise — a ragged line in the circle, as a schematic draws it"
        code: "SY.SOURCE:VOLTAGE-NOISE"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 80)
    path("M-80 0H-32M32 0H80M-32 0A32 32 0 1 0 32 0A32 32 0 1 0-32 0M-22 2L-16-12L-12 8L-6-16L0 14L6-8L10 10L16-6L22 2M-52-18V-6M-58-12H-46")
    pin:a(at: -80 0)
    pin:b(at: 80 0)
    label(name, at: 0 -52)
    label(value, at: 0 64)
}
