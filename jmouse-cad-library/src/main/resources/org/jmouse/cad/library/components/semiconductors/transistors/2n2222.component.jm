# The 2N2222A is the bipolar transistor with onsemi's published Gummel–Poon numbers. The collector and emitter
# resistances are fitted to the saturation table instead of the model's Rc 1 Ω, which overstates VCE(sat) at 150 mA.

component:2n2222("2N2222A", type: bjt) {
    meta {
        designator: Q
        summary: "NPN small-signal switching transistor, 40 V, 600 mA"
        source: "onsemi P2N2222A datasheet P2N2222A/D, Rev. 7, and its SPICE model"
        package: "TO-92"
        category: circuits
        failure: open
    }
    extends:npn-transistor

    parameter:I_saturation(14.34 fA, "IS: transport saturation current")
    parameter:beta_forward(255.9, "BF: ideal forward current gain")
    parameter:V_early(74.03 V, "VAF: forward Early voltage")
    parameter:I_knee(0.2847 A, "IKF: above it the gain falls")
    parameter:I_leakage_base_emitter(14.34 fA, "ISE: below a milliampere the gain falls")
    parameter:leakage_emission_base_emitter(1.307, "NE")
    parameter:beta_reverse(6.092, "BR: ideal reverse current gain")
    parameter:R_base(10 Ohm, "RB: base spreading resistance")
    parameter:R_collector(0.3 Ohm, "collector bulk resistance: most of VCE(sat) at high current")
    parameter:R_emitter(0.1 Ohm, "emitter resistance")
    parameter:C_base_emitter(22.01 pF, "CJE")
    parameter:grading_base_emitter(0.377, "MJE")
    parameter:C_base_collector(7.306 pF, "CJC")
    parameter:grading_base_collector(0.3416, "MJC")
    parameter:transit_time_forward(411.1 ps, "TF: fT about 300 MHz")
    parameter:transit_time_bias_dependence(3, "XTF")
    parameter:transit_time_bias_voltage(1.7 V, "VTF")
    parameter:transit_time_current(0.6 A, "ITF")
    parameter:transit_time_reverse(46.91 ns, "TR: the storage time of a saturated switch")
    parameter:beta_temperature_exponent(1.5, "XTB")
    parameter:T_nominal(298.15 K, "the temperature the figures above are measured at")
    parameter:V_breakdown(60 V, "avalanche onset: an approximation — VCEO is guaranteed to 40 V, a typical part holds more")
    # How it warms and where it gives up (TO-92: 625 mW at 25 °C, RθJA 200 K/W, TJ max 150 °C).
    parameter:power_rating(0.625 W, "what it is rated for")
    parameter:thermal_resistance(200 K/W, "kelvin above the bench per watt it takes")
    parameter:thermal_time_constant(2 s, "how fast it warms to that")
    parameter:T_maximum(150 °C, "past this it fails on a realistic bench")
    parameter:beta_forward_spread(0.5, "hFE 100 ... 300 at 150 mA: about half either way")
    parameter:V_collector_emitter_maximum(40 V, "VCEO")
    parameter:I_collector_maximum(600 mA, "IC, continuous")

    pin:emitter(analog, 1, "emitter")
    pin:base(analog, input, 2, "base")
    pin:collector(analog, output, 3, "collector")

    footprint(to-92-inline-footprint)
    # The same die in SOT-23 is the MMBT2222A, numbered as the onsemi MMBT2222A data sheet numbers it: base, emitter,
    # collector — not the TO-92 order of the pins.
    footprint(sot-23-footprint) {
        pad:1(base)
        pad:2(emitter)
        pad:3(collector)
    }

    symbol(uses: npn-transistor-symbol) {
        bind:failed(failed)
    }

    expect("gain at a tenth of a milliampere", from: "hFE at least 35 at IC 0.1 mA, VCE 10 V") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [collector, 0], U_output: 10 V)
            part:I1(current-source, [base, 0], I_output: 1 uA)
            part:U1(self, [base: base, collector: collector, emitter: 0])
        }
        measure(operating, current: V1)
        within(-0.3 mA .. -35 uA)
    }

    expect("gain at half an ampere", from: "hFE at least 40 at IC 500 mA, VCE 10 V") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [collector, 0], U_output: 10 V)
            part:I1(current-source, [base, 0], I_output: 5 mA)
            part:U1(self, [base: base, collector: collector, emitter: 0])
        }
        measure(operating, current: V1)
        within(-1.5 A .. -0.2 A)
    }

    expect("DC current gain at about 150 mA", from: "hFE 100 … 300 at IC 150 mA, VCE 10 V") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [collector, 0], U_output: 10 V)
            part:I1(current-source, [base, 0], I_output: 1 mA)
            part:U1(self, [base: base, collector: collector, emitter: 0])
        }
        measure(operating, current: V1)
        within(-0.3 A .. -0.1 A)
    }

    expect("saturated at 150 mA with 15 mA of base current", from: "VCE(sat) at most 0.3 V at IC 150 mA, IB 15 mA") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [Vcc, 0], U_output: 10 V)
            part:R1(resistor, [Vcc, collector], resistance: 64.7 Ohm)
            part:C1(capacitor, [collector, 0], capacitance: 1 nF)
            part:I1(current-source, [base, 0], I_output: 15 mA)
            part:U1(self, [base: base, collector: collector, emitter: 0])
        }
        measure(final, collector)
        within(0.06 V .. 0.3 V)
    }

    expect("base-emitter voltage in saturation", from: "VBE(sat) 0.6 … 1.2 V at IC 150 mA, IB 15 mA") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [Vcc, 0], U_output: 10 V)
            part:R1(resistor, [Vcc, collector], resistance: 64.7 Ohm)
            part:C1(capacitor, [collector, 0], capacitance: 1 nF)
            part:I1(current-source, [base, 0], I_output: 15 mA)
            part:U1(self, [base: base, collector: collector, emitter: 0])
        }
        measure(final, base)
        within(0.6 V .. 1.2 V)
    }

    expect("off when the base is at the emitter", from: "collector cut-off current at most 10 nA") {
        bench(for: 1 ms) {
            part:V1(voltage-source, [collector, 0], U_output: 40 V)
            part:U1(self, [base: 0, collector: collector, emitter: 0])
        }
        measure(operating, current: V1)
        within(-10 nA .. 0 A)
    }

    # How it looks in the hand: its TO-92 package from the front, wired by its pin numbers and printed with its name.
    portrait(uses: to-92-portrait) {
        bind:marking("2N2222A")
    }
}
