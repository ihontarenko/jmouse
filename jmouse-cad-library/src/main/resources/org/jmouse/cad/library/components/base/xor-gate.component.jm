# The XOR gate every such logic part is a member of: its rule, Y = A ⊕ B, and its delay. Its thresholds, its output's
# strength and how it slows at a low supply are its family's — 74HC CMOS unless a part says otherwise. An unknown
# input gives an unknown output unless the other input decides it alone.

component:xor-gate("XOR gate", type: gate) {
    meta {
        designator: U
        summary: "A two-input exclusive-OR gate: high while the inputs differ"
        source: "the gate's function table: Y = A ⊕ B"
        category: circuits
        failure: short Vcc GND
    }
    use:cmos-hc

    parameter:propagation_delay(10 ns, "input to output at the family's nominal supply")

    pin:a(digital, input, 1, "input A")
    pin:b(digital, input, 2, "input B")
    pin:GND(ground, 3)
    pin:output(digital, output, 4, "output Y")
    pin:Vcc(power, 5)

    symbol(uses: xor-gate-symbol)

    behaviour {
        function level()
            if (a == 0 or a == 1) and (b == 0 or b == 1) then
                if a == b then
                    return 0
                end
                return 1
            end
            return X
        end

        function show()
            drive('output', level(), propagation_delay * delay_scale(Vcc - GND))
        end

        on start do
            show()
        end

        on change 'a, b' do
            show()
        end
    }
}
