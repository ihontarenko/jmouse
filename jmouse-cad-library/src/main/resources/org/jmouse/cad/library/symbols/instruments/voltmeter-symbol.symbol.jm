symbol:voltmeter-symbol("Voltmeter") {
    meta {
        summary: "Voltmeter, as drawn on a schematic: a dial marked V"
        code: "SY.METER:VOLTMETER"
        category: circuits
        tags: electronics, schematic, instrument
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 80)
    path("M-80 0H-36M36 0H80M-36 0A36 36 0 1 0 36 0A36 36 0 1 0-36 0")
    path("M-14-16L0 16L14-16", upright)
    pin:a(at: -80 0)
    pin:b(at: 80 0)
    label(name, at: 0 -56)
    label(value, at: 0 64)
}
