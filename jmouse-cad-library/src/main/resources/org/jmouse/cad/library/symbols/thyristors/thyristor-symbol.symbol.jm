symbol:thyristor-symbol("Thyristor") {
    meta {
        summary: "Thyristor (SCR), as drawn on a schematic: a diode with a gate at its cathode"
        code: "SY.THYRISTOR:SCR"
        category: circuits
        tags: electronics, schematic
        authors: "jMouse"
        license: "CERN-OHL-W-2.0"
    }
    size(160 x 120)
    input:conduction
    input:failed

    group:body(live) {
        path("M-80 0H-24V-20L20 0-24 20V0M20-20V20M20 0H80M20 12L40 40V60")
        live stroke = if(failed > 0.5, burned, signal)
    }

    path:channel(live, "M-80 0H-24M-24-20L20 0-24 20ZM20 0H80") {
        stroke = positive
        live opacity = smooth(conduction, 40 ms)
        live glow = 6 * conduction
    }

    layer(live, failed > 0.5) {
        path:scorch("M-14-18L-6-6M12-16L4-4M-12 16L-4 6M14 18L6 6M-20 0H-10M20 0H10")
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin:a(at: -80 0)
    pin:b(at: 80 0)
    pin:gate(at: 40 60)
    label(name, at: 0 -36)
    label(value, at: 0 80)
}
