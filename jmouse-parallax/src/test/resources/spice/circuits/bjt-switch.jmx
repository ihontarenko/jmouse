# A 2N2222A switching a 100 Ω load from 12 V, its base driven by a square wave through a base resistor. At 1 kΩ
# the base gets about 4 mA, far more than the 0.65 mA the load needs at an hFE of 185: the transistor saturates,
# a tenth of a volt across it, and the collector swings cleanly between 12 V and 0.1 V. Turn the base resistor
# up past about 7 kΩ and it no longer can: the collector stops reaching the bottom, the load gets less, and the
# transistor itself starts to warm — the active region a switch must stay out of. The duty moves the ammeter's
# average.
circuit "2N2222 as a switch" as bjt-switch {
    meta {
        summary "A 2N2222A switching a 100 Ω load from 12 V, its base driven by a square wave. At 1 kΩ it saturates: the collector swings between 12 V and 0.1 V. Turn the base resistor past about 7 kΩ and it leaves saturation — the collector stops reaching the bottom and the transistor warms."
        category circuits
        tags transistors, switching, instruments, interactive
    }
    parameters {
        R_base = 1 kΩ in 1 kΩ .. 47 kΩ step 1 kΩ "Base resistor: past about 7 kΩ the transistor leaves saturation"
        f = 1 kHz in 100 Hz .. 10 kHz step 100 Hz "Drive frequency"
    }
    parts {
        V1 voltage-source (positive = vcc, negative = 0) U_output = 12 V
        G1 square-generator (positive = drive, negative = 0) high = 5 V, frequency = f, duty = 0.5
        RB resistor (drive, control) resistance = R_base
        A1 ammeter (in = vcc, out = top)
        RL resistor (top, switched) resistance = 100 Ω, power_rating = 2 W, thermal_resistance = 60 K/W
        Q1 2n2222 (base = control, collector = switched, emitter = 0)
        VM1 voltmeter (plus = switched, minus = 0)
    }
    layout {
        V1 at 160, 300 rotate 90
        G1 at 360, 380 rotate 90
        RB at 460, 300
        Q1 at 560, 300
        RL at 580, 160 rotate 90
        A1 at 380, 80
        VM1 at 720, 300 rotate 90
        Jc junction at 580, 230
        Jg1 junction at 160, 460
        Jg2 junction at 360, 460
        Jg3 junction at 580, 460
        Jg4 junction at 720, 460
        GND1 ground at 360, 520
        W1 wire V1.positive to A1.in via 160 80
        W2 wire A1.out to RL.positive via 580 80
        W3 wire RL.negative to Jc.j
        W4 wire Jc.j to Q1.collector
        W5 wire VM1.plus to Jc.j via 720 230
        W6 wire G1.positive to RB.positive via 360 300
        W7 wire RB.negative to Q1.base
        W8 wire V1.negative to Jg1.j
        W9 wire Jg1.j to Jg2.j
        W10 wire G1.negative to Jg2.j
        W11 wire Jg2.j to GND1.ground
        W12 wire Jg2.j to Jg3.j
        W13 wire Q1.emitter to Jg3.j
        W14 wire Jg3.j to Jg4.j
        W15 wire VM1.minus to Jg4.j
    }
    probes {
        CH1 drive 2 V/div
        CH2 switched 5 V/div
        CH3 control 0.5 V/div
    }
    expect "saturated while on: a tenth of a volt across it" from "datasheet VCE(sat) at most 0.3 V at 150 mA, IB 15 mA" {
        measure minimum switched after 1 ms
        within 0.05 V .. 0.3 V
    }
    expect "off: the collector at the supply" from "cut-off: no collector current, no drop across RL" {
        measure maximum switched after 1 ms
        within 11.9 V .. 12.1 V
    }
    expect "the load takes (12 V − VCE) / 100 Ω while on" from "Ohm's law across RL with the transistor saturated" {
        measure maximum current RL after 1 ms
        within 0.115 A .. 0.122 A
    }
    expect "the base sits one junction above the emitter" from "datasheet VBE(sat) 0.6 … 1.2 V; IB = (5 V − VBE) / 1 kΩ ≈ 4.2 mA" {
        measure maximum control after 1 ms
        within 0.65 V .. 1.0 V
    }
    analysis transient for 0.01 s
    view {
        transient_response primary
    }
}
