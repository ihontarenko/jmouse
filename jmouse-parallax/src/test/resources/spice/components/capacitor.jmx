component "Capacitor" as capacitor type capacitor {
    meta {
        designator C
        summary "Two-terminal capacitor"
        category circuits
    }
    parameters {
        capacitance = 100 nF "capacitance"
        tolerance = 10 %                         "how far a part may be from its value, ±; a bench's corners use it"
        temperature_coefficient = 200 ppm/K      "how its value moves per kelvin away from 25 °C; a bench's temperature uses it"
        voltage_rating = 50 V                    "the most it is made to hold"
    }
    pins {
        terminal_one analog 1 "first terminal"
        terminal_two analog 2 "second terminal"
    }
    # While it runs, beside it: how full it is — its charge as a share of the charge it holds at its rated voltage,
    # which is the voltage across it against that rating.
    display {
        charge = 100 * (terminal_one - terminal_two) / voltage_rating unit % "of rated voltage"
    }

    # Drawn plain, or as an electrolytic — the polarized drawing, its "+" on terminal_one — by a part's `symbol` choice.
    symbol uses capacitor-symbol, polarized-capacitor-symbol {
        a terminal_one
        b terminal_two
    }
}
