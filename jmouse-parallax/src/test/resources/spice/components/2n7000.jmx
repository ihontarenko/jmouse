# Switching macromodel anchored to onsemi's 2N7000 electrical table. The
# smooth channel law fits the two RDS(on) points; the body diode, avalanche
# knee and small-signal terminal capacitances are separate physical branches.
# Absolute maximum current and thermal ratings are not current clamps.
component "2N7000" as 2n7000 type mosfet {
    meta {
        designator Q
        summary "N-channel enhancement MOSFET, 60 V, 200 mA continuous"
        source "onsemi 2N7000/2N7002/NDS7002A datasheet NDS7002A/D, Rev. 11"
        package "TO-92"
        category circuits
        failure short
    }
    use smooth-transitions

    parameters {
        V_threshold = 2.1 V             "typical gate threshold at 1 mA"
        R_drain_source_at_10_volts = 1.2 Ohm           "typical RDS(on) at VGS 10 V, ID 500 mA"
        V_gate_fit = 2.2 V            "fits 1.8 Ohm at VGS 4.5 V"
        channel_saturation_factor = 0.04 A/V^2       "channel saturation fit"
        I_saturation = 15 pA            "body diode saturation current"
        emission_coefficient = 1.5                 "body diode emission factor"
        V_breakdown = 60 V              "drain-source breakdown at 10 uA"
        I_breakdown = 10 uA            "avalanche current at V_breakdown"
        C_gate_source = 16 pF            "Ciss - Crss at zero bias"
        C_gate_drain = 4 pF             "Crss at zero bias"
        C_drain_source = 7 pF             "Coss - Crss at zero bias"
        I_gate = 5 nA              "gate leakage scale"
        T_nominal = 298.15 K               "the temperature the figures above are measured at"
        V_threshold_coefficient = -0.005   "threshold change per kelvin, V/K: the gate turns on earlier when hot"
        mobility_exponent = 1.5            "the channel's conductance falls as (temperature / T_nominal)^-1.5"
        saturation_temperature_exponent = 3   "XTI of the body diode"
        E_gap = 1.11 V                     "silicon's band gap, in volts"
        # How it warms and where it gives up (TO-92: RθJA 312.5 K/W, TJ max 150 °C).
        power_rating = 0.4 W                "what it is rated for"
        thermal_resistance = 312 K/W       "kelvin above the bench per watt it takes"
        thermal_time_constant = 2 s      "how fast it warms to that"
        T_maximum = 150 °C               "past this it fails on a realistic bench"
    }

    pins {
        source analog 1              "source"
        gate analog input 2        "gate"
        drain analog output 3       "drain"
    }

    symbol uses n-channel-mosfet-symbol

    equations {
        let warmth : ratio = temperature / T_nominal
        let V_thermal : voltage = thermal_voltage(temperature)
        let V_threshold_now : voltage = V_threshold + V_threshold_coefficient * (temperature - T_nominal)
        let I_saturation_now : current = I_saturation * warmth ^ (saturation_temperature_exponent / emission_coefficient) * exp((warmth - 1) * E_gap / (emission_coefficient * V_thermal))
        let V_gate_source : voltage = gate - source
        let V_drain_source : voltage = drain - source
        let overdrive : voltage = soft_positive_part(V_gate_source - V_threshold_now, 0.02)
        let conductance : conductance = (overdrive / (overdrive + V_gate_fit)) / ((10 - V_threshold) / (10 - V_threshold + V_gate_fit)) / R_drain_source_at_10_volts / warmth ^ mobility_exponent
        let saturation : current = channel_saturation_factor * overdrive^2 + 1e-9
        let request : current = conductance * soft_positive_part(V_drain_source, 0.02)
        let channel : current = saturation * request / sqrt(saturation^2 + request^2)
        let body : current = I_saturation_now * (limit_exponential((source - drain) / (emission_coefficient * V_thermal)) - 1)
        let avalanche : current = I_breakdown * limit_exponential((V_drain_source - V_breakdown) / (emission_coefficient * V_thermal))

        current drain -> source = channel + avalanche + d(C_drain_source * V_drain_source)/dt
        current source -> drain = body
        # The gate leakage reaches I_gate at about the rated gate voltage: the knee is 15 V.
        let V_gate_knee : voltage = 15
        current gate -> source = I_gate * tanh(V_gate_source / V_gate_knee) + d(C_gate_source * V_gate_source)/dt
        current gate -> drain = I_gate * tanh((gate - drain) / V_gate_knee) + d(C_gate_drain * (gate - drain))/dt
    }

    expect "on-state voltage at 500 mA and 10 V gate drive" from "RDS(on) and VDS(on) at VGS 10 V" {
        bench for 1 ms {
            V1 voltage-source (gate, 0) U_output = 10 V
            V2 voltage-source (Vdd, 0) U_output = 10 V
            R1 resistor (Vdd, drain) resistance = 18.8 Ohm
            C1 capacitor (drain, 0) capacitance = 1 nF
            U1 self (gate = gate, drain = drain, source = 0)
        }
        measure final drain
        within 0.4 V .. 2.5 V
    }

    expect "on-resistance rises when hot" from "RDS(on) normalised to temperature: about 1.5x at 125 C" {
        bench for 1 ms at 125 °C {
            V1 voltage-source (gate, 0) U_output = 10 V
            V2 voltage-source (Vdd, 0) U_output = 10 V
            R1 resistor (Vdd, drain) resistance = 18.8 Ohm
            C1 capacitor (drain, 0) capacitance = 1 nF
            U1 self (gate = gate, drain = drain, source = 0)
        }
        measure final drain
        within 0.75 V .. 2.5 V
    }

    expect "low on-state voltage at 75 mA and 4.5 V gate drive" from "VDS(on) at VGS 4.5 V" {
        bench for 1 ms {
            V1 voltage-source (gate, 0) U_output = 4.5 V
            V2 voltage-source (Vdd, 0) U_output = 4.5 V
            R1 resistor (Vdd, drain) resistance = 58 Ohm
            C1 capacitor (drain, 0) capacitance = 1 nF
            U1 self (gate = gate, drain = drain, source = 0)
        }
        measure final drain
        within 0.08 V .. 0.4 V
    }

    expect "off-state drain current at 48 V" from "IDSS maximum 1 uA" {
        bench for 1 ms {
            V1 voltage-source (drain, 0) U_output = 48 V
            U1 self (gate = 0, drain = drain, source = 0)
        }
        measure operating current V1
        within -1 uA .. 0 A
    }

    expect "drain breakdown near 60 V" from "BVDSS at 10 uA" {
        bench for 1 ms {
            I1 current-source (drain, 0) I_output = 10 uA
            U1 self (gate = 0, drain = drain, source = 0)
        }
        measure operating drain
        within 59.9 V .. 62 V
    }

    expect "body diode forward voltage" from "drain-source diode characteristic" {
        bench for 1 ms {
            V1 voltage-source (Vdd, 0) U_output = 1 V
            R1 resistor (Vdd, source) resistance = 1 Ohm
            C1 capacitor (source, 0) capacitance = 1 nF
            U1 self (gate = 0, drain = 0, source = source)
        }
        measure final source
        within 0.7 V .. 1.2 V
    }
}
