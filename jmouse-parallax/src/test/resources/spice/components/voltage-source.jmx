component "Voltage source" as voltage-source type voltage-source {
    meta {
        designator V
        summary "Two-terminal voltage source: constant, or switched on at the start. A sine or a square is a generator — sine-generator, square-generator"
        category circuits
    }
    parameters {
        U_output = 5 V "source voltage"
    }
    pins {
        positive analog 1 "positive terminal"
        negative analog 2 "negative terminal"
    }
    symbol uses voltage-source-symbol {
        a positive
        b negative
    }
}
