# Four junctions turning both half-waves the same way round into a bare resistor: the load sees |V_in| less two forward
# drops, and goes to zero between the peaks — no capacitor to smooth it, so every diode turns on and off each cycle.

circuit "Bridge rectifier into a resistor" as bridge-rectifier-resistive {
    meta {
        summary "Benchmark: 10 V, 50 Hz, four 1N4148, 1 kΩ load and nothing else."
        category circuits
    }
    parts {
        AC1 sine-generator (positive = a, negative = b) amplitude = 10, frequency = 50
        D1 1n4148 (anode = a, cathode = p)
        D3 1n4148 (anode = b, cathode = p)
        D2 1n4148 (anode = 0, cathode = b)
        D4 1n4148 (anode = 0, cathode = a)
        RL resistor (p, 0) resistance = 1000
    }
    analysis transient for 0.04 s
}
