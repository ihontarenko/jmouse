# The MOSFET benchmark: a 2N7000 switched by a 100 kHz square through a gate resistor — the gate capacitances charging
# (the Miller plateau), the channel in its linear region, and the drain–bulk capacitance on the drain's edges.

circuit "N-channel MOSFET switch" as nmos-switch {
    meta {
        summary "Benchmark: 2N7000 low-side switch, 100 kHz, 200 mA."
        category circuits
    }
    parts {
        G1 square-generator (positive = drive, negative = 0) high = 10, low = 0, frequency = 100000
        R1 resistor (drive, gate) resistance = 100
        V1 voltage-source (supply, 0) U_output = 10
        R2 resistor (supply, drain) resistance = 47
        Q1 2n7000 (gate = gate, drain = drain, source = 0)
    }
    analysis transient for 0.0001 s
}
