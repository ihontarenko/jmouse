# The benchmark's mains case: a 50 Hz sine through a diode bridge into a smoothed load. A sine source and four diodes
# that switch twice a period. Fixed on purpose: a benchmark compares against its own past.

circuit "Bridge rectifier with a smoothing capacitor" as bridge-rectifier {
    meta {
        summary "Benchmark: 50 Hz sine, four 1N4148, RC load."
        category circuits
    }
    parts {
        AC1 sine-generator (positive = a, negative = b) amplitude = 10, frequency = 50
        D1 1n4148 (anode = a, cathode = p)
        D3 1n4148 (anode = b, cathode = p)
        D2 1n4148 (anode = 0, cathode = b)
        D4 1n4148 (anode = 0, cathode = a)
        RL resistor (p, 0) resistance = 1000
        CL capacitor (p, 0) capacitance = 10e-6
    }
    analysis transient for 0.04 s
}
