# A Cockcroft–Walton multiplier of 12 stages: 24 diodes and 24 capacitors, each stage pumping the next, so every
# diode's switching moves every node above it. Nonlinear, stiff and coupled end to end — one piece, no cut.

circuit "Voltage multiplier, 12 stages" as voltage-multiplier-12 {
    meta {
        summary "Benchmark: Cockcroft–Walton, 12 stages of 1N4148 and 100 nF from a 10 V, 1 kHz sine into 1 MΩ."
        category circuits
    }
    parts {
        AC1 sine-generator (positive = n0, negative = 0) amplitude = 10, frequency = 1000
        CA1 capacitor (n0, n1) capacitance = 1e-7
        DA1 1n4148 (anode = 0, cathode = n1)
        DB1 1n4148 (anode = n1, cathode = b1)
        CB1 capacitor (0, b1) capacitance = 1e-7
        CA2 capacitor (n1, n2) capacitance = 1e-7
        DA2 1n4148 (anode = b1, cathode = n2)
        DB2 1n4148 (anode = n2, cathode = b2)
        CB2 capacitor (b1, b2) capacitance = 1e-7
        CA3 capacitor (n2, n3) capacitance = 1e-7
        DA3 1n4148 (anode = b2, cathode = n3)
        DB3 1n4148 (anode = n3, cathode = b3)
        CB3 capacitor (b2, b3) capacitance = 1e-7
        CA4 capacitor (n3, n4) capacitance = 1e-7
        DA4 1n4148 (anode = b3, cathode = n4)
        DB4 1n4148 (anode = n4, cathode = b4)
        CB4 capacitor (b3, b4) capacitance = 1e-7
        CA5 capacitor (n4, n5) capacitance = 1e-7
        DA5 1n4148 (anode = b4, cathode = n5)
        DB5 1n4148 (anode = n5, cathode = b5)
        CB5 capacitor (b4, b5) capacitance = 1e-7
        CA6 capacitor (n5, n6) capacitance = 1e-7
        DA6 1n4148 (anode = b5, cathode = n6)
        DB6 1n4148 (anode = n6, cathode = b6)
        CB6 capacitor (b5, b6) capacitance = 1e-7
        CA7 capacitor (n6, n7) capacitance = 1e-7
        DA7 1n4148 (anode = b6, cathode = n7)
        DB7 1n4148 (anode = n7, cathode = b7)
        CB7 capacitor (b6, b7) capacitance = 1e-7
        CA8 capacitor (n7, n8) capacitance = 1e-7
        DA8 1n4148 (anode = b7, cathode = n8)
        DB8 1n4148 (anode = n8, cathode = b8)
        CB8 capacitor (b7, b8) capacitance = 1e-7
        CA9 capacitor (n8, n9) capacitance = 1e-7
        DA9 1n4148 (anode = b8, cathode = n9)
        DB9 1n4148 (anode = n9, cathode = b9)
        CB9 capacitor (b8, b9) capacitance = 1e-7
        CA10 capacitor (n9, n10) capacitance = 1e-7
        DA10 1n4148 (anode = b9, cathode = n10)
        DB10 1n4148 (anode = n10, cathode = b10)
        CB10 capacitor (b9, b10) capacitance = 1e-7
        CA11 capacitor (n10, n11) capacitance = 1e-7
        DA11 1n4148 (anode = b10, cathode = n11)
        DB11 1n4148 (anode = n11, cathode = b11)
        CB11 capacitor (b10, b11) capacitance = 1e-7
        CA12 capacitor (n11, n12) capacitance = 1e-7
        DA12 1n4148 (anode = b11, cathode = n12)
        DB12 1n4148 (anode = n12, cathode = b12)
        CB12 capacitor (b11, b12) capacitance = 1e-7
        RL resistor (b12, 0) resistance = 1000000
    }
    analysis transient for 0.02 s
}
