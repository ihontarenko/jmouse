# 40 RC sections in a chain, driven by a 1 kHz sine: every node is coupled to its neighbours and only the source's
# node is held, so the circuit is ONE piece — nothing to cut into parts. The case where partitioning cannot help.

circuit "RC ladder, 40 sections" as rc-ladder-40 {
    meta {
        summary "Benchmark: 40 × (100 Ω + 10 nF) in a chain from a 5 V, 1 kHz sine — one coupled piece."
        category circuits
    }
    parts {
        V1 sine-generator (positive = n0, negative = 0) amplitude = 5, frequency = 1000
