# The PNP benchmark: the NPN switch mirrored — a 2N2907A pulled into saturation and out by a 100 kHz square.

circuit "PNP saturated switch" as pnp-switch {
    meta {
        summary "Benchmark: 2N2907A switch, 100 kHz, 150 mA into saturation."
        category circuits
    }
    parts {
        G1 square-generator (positive = drive, negative = 0) high = 5, low = -5, frequency = 100000
        R1 resistor (drive, base) resistance = 330
        V1 voltage-source (0, supply) U_output = 10
        R2 resistor (collector, supply) resistance = 66
        Q1 2n2907 (base = base, collector = collector, emitter = 0)
    }
    analysis transient for 0.0001 s
}
