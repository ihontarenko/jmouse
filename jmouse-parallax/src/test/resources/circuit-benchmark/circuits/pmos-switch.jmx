# The p-channel benchmark: a BS250 high-side switch driven by a 100 kHz square through a gate resistor — the same
# mechanisms as the n-channel switch, every voltage and current of the opposite sign.

circuit "P-channel MOSFET switch" as pmos-switch {
    meta {
        summary "Benchmark: BS250 high-side switch, 100 kHz, 100 mA."
        category circuits
    }
    parts {
        G1 square-generator (positive = drive, negative = 0) high = 10, low = 0, frequency = 100000
        R1 resistor (drive, gate) resistance = 100
        V1 voltage-source (supply, 0) U_output = 10
        Q1 bs250 (gate = gate, drain = drain, source = supply)
        R2 resistor (drain, 0) resistance = 100
    }
    analysis transient for 0.0001 s
}
