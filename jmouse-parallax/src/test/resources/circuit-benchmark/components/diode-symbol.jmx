symbol "Diode" as diode-symbol {
    meta {
        summary "Diode, as drawn on a schematic"
        category circuits
        tags electronics, schematic
    }
    size 60 x 40
    path "M-30 0H-12V-12L12 0-12 12V0M12-12V12M12 0H30"
    pin a at -30, 0
    pin b at 30, 0
    label name at 0, -26
    label value at 0, 32
}
