# An inductor as it is: the voltage across it is the rate of the flux it links, its inductance times the current
# through it. Its current is the branch current of that voltage equation — an unknown of its own, as SPICE's L has —,
# and the flux reads it as terminal_one.current. Linear at any one temperature, it is integrated as every charge is.

component "Inductor" as inductor type inductor {
    meta {
        designator L
        summary "Two-terminal inductor: the flux its current links"
        category circuits
    }
    parameters {
        inductance = 1 mH "inductance"
    }
    pins {
        terminal_one analog 1 "first terminal"
        terminal_two analog 2 "second terminal"
    }
    symbol uses inductor-symbol {
        a terminal_one
        b terminal_two
    }
    equations {
        voltage terminal_one -> terminal_two = d(inductance * terminal_one.current)/dt
    }
}
