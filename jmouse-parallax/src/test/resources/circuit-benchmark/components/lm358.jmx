# Two identical amplifiers in one package, sharing a supply. `units A, B` makes the pin table give each block its own
# numbers; the family's state and equations live separately in each unit, while supply and ground are shared. Its
# PNP input stage works down to below ground and up to 1.5 V under the supply; the output reaches ground, not V+.

component "LM358" as lm358 type opamp {
    meta {
        designator U
        summary "Dual operational amplifier, single supply 3 V to 32 V, inputs and output to ground"
        source "TI LM358 datasheet (SLOS068)"
        package "SOIC-8"
        category circuits
        failure short Vcc GND
    }
    extends operational-amplifier
    units A, B

    parameters {
        open_loop_gain = 100000                 "open-loop gain, 100 dB (min 25 V/mV)"
        gain_bandwidth = 0.7 MHz               "unity-gain bandwidth"
        slew_rate = 0.3 V/us               "slew rate"
        V_input_offset = 0 V per unit          "input offset; typically 2 mV either way"
        I_input_bias = 20 nA               "input bias current, out of the input pins (PNP inputs)"
        # I_input_offset (typically 2 nA), CMRR (80 dB) and PSRR (100 dB) are errors of unknown sign, left at none like
        # the offset voltage; set them to see their effect.
        V_common_mode_high = 1.5 V         "the inputs work up to V+ - 1.5 V"
        V_noise = 40 nV                    "input voltage noise density at 1 kHz, 40 nV/√Hz"
        I_quiescent = 0.35 mA                "supply current per unit"
        R_output = 50 Ohm
        I_output_source = 40 mA             "output short-circuit current, sourcing"
        I_output_sink = 20 mA               "output short-circuit current, sinking"
        V_output_headroom = 1.5 V               "the output stays this far below V+"
        V_output_low = 5 mV                 "the output reaches this close to ground"
        recovery = 1e6 1/s          "how fast the gain stage comes back out of saturation"
        # How it warms and where it gives up (DIP-8 in still air).
        thermal_resistance = 120 K/W       "kelvin above the bench per watt it takes"
        thermal_time_constant = 5 s      "how fast it warms to that"
        T_maximum = 150 °C               "past this it fails on a realistic bench"
        V_offset_spread = 7 mV                "VIO at most 7 mV"
        V_supply_maximum = 32 V                "the supply span it is rated for"
    }

    pins {
        output analog output 1 7
        inverting_input analog input 2 6        "inverting"
        non_inverting_input analog input 3 5        "non-inverting"
        Vcc power 8
        GND ground 4
    }

    symbol uses operational-amplifier-symbol {
        positive_supply Vcc
        negative_supply GND
    }


    expect "inverting gain of ten" from "closed-loop application, G = -R2 / R1" {
        bench for 1 ms {
            V1 voltage-source (Vcc, 0) U_output = 15 V
            V2 voltage-source (reference, 0) U_output = 7.5 V
            V3 voltage-source (input, 0) U_output = 7.4 V
            R1 resistor (input, inverting_input) resistance = 10 kOhm
            R2 resistor (inverting_input, output) resistance = 100 kOhm
            U1 self (A.non_inverting_input = reference, A.inverting_input = inverting_input, A.output = output, Vcc = Vcc, GND = 0)
        }
        measure operating output
        near 8.5 V +- 1%
    }

    expect "slew rate" from "electrical characteristics, slew_rate 0.3 V/us" {
        bench for 10 us {
            V1 voltage-source (Vcc, 0) U_output = 15 V
            V2 voltage-source (input, 0) U_output = 5 V
            U1 self (A.non_inverting_input = input, A.inverting_input = output, A.output = output, Vcc = Vcc, GND = 0)
        }
        measure final output
        near 3 V +- 25%
    }

    expect "output high with 2 kOhm at 30 V" from "electrical characteristics, VOH min 26 V" {
        bench for 1 ms {
            V1 voltage-source (Vcc, 0) U_output = 30 V
            V2 voltage-source (input, 0) U_output = 1 V
            R1 resistor (output, 0) resistance = 2 kOhm
            U1 self (A.non_inverting_input = input, A.inverting_input = 0, A.output = output, Vcc = Vcc, GND = 0)
        }
        measure operating output
        within 26 V .. 30 V
    }

    expect "supply current, both units" from "electrical characteristics, ICC max 1.2 mA at 5 V" {
        bench for 1 ms {
            V1 voltage-source (Vcc, 0) U_output = 5 V
            V2 voltage-source (input, 0) U_output = 2.5 V
            U1 self (A.non_inverting_input = input, A.inverting_input = a, A.output = a, B.non_inverting_input = input, B.inverting_input = b, B.output = b, Vcc = Vcc, GND = 0)
        }
        measure final current V1
        within -1.2 mA .. 0 mA
    }
}
