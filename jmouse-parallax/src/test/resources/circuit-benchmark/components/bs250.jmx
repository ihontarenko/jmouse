# The BS250 is the level-1 p-channel MOSFET with numbers placed inside the datasheet's limits: its table gives ranges
# (VGS(th) -1 .. -3.5 V, RDS(on) at most 14 Ω), not typical curves, so the model is a typical part within them and
# its checks test the limits. The p-channel carrier: an imported `.model … PMOS(…)` without a part of its own is
# `p-mosfet`; this is the datasheet part.

component "BS250" as bs250 type mosfet {
    meta {
        designator Q
        summary "P-channel enhancement MOSFET, -45 V, -230 mA continuous"
        source "Diodes Inc. BS250P datasheet, electrical characteristics (limits only)"
        package "TO-92"
        category circuits
        failure short drain source
    }
    extends p-mosfet

    parameters {
        V_threshold = -2.4 V                  "VTO: inside VGS(th) -1 .. -3.5 V at -1 mA"
        transconductance = 26 mA/V^2          "KP: with RD + RS, about 9 Ω at VGS -10 V — under the 14 Ω limit"
        R_drain = 3.5 Ohm                     "RD"
        R_source = 0.5 Ohm                    "RS"
        I_saturation = 10 pA                  "IS: body diode saturation current"
        emission_coefficient = 1.5            "N: body diode emission factor"
        C_bulk_drain = 20 pF                  "CBD: output capacitance at zero bias"
        C_gate_source = 25 pF                 "CGSO: inside Ciss at most 60 pF"
        C_gate_drain = 5 pF                   "CGDO: Crss"
        T_nominal = 298.15 K                  "the temperature the figures above are measured at"
        V_threshold_coefficient = -0.004      "the gate turns on earlier when hot, V/K"
        resistance_temperature_exponent = 1.5 "RDS(on) rises when hot"
        V_breakdown = 50 V                    "drain-source avalanche: BVDSS is at least 45 V"
        I_breakdown = 100 uA                  "avalanche current at V_breakdown"
        V_drain_source_maximum = 45 V          "VDS"
        V_gate_source_maximum = 20 V          "VGS, either way"
        I_drain_maximum = 230 mA                "ID"
        V_threshold_spread = 1.1 V            "VGS(th) -1 ... -3.5 V"
    }

    pins {
        source analog 1                       "source"
        gate analog input 2                   "gate"
        drain analog output 3                 "drain"
    }

    symbol uses p-channel-mosfet-symbol

    expect "on-resistance at -200 mA and -10 V gate drive" from "RDS(on) at most 14 Ω at VGS -10 V, ID -200 mA" {
        bench for 1 ms {
            V1 voltage-source (Vdd, 0) U_output = 10 V
            R1 resistor (drain, 0) resistance = 50 Ohm
            U1 self (gate = 0, drain = drain, source = Vdd)
        }
        measure operating drain
        within 7.2 V .. 10 V
    }

    expect "gate threshold at -1 mA" from "VGS(th) -1 .. -3.5 V at ID -1 mA, VDS = VGS" {
        bench for 1 ms {
            V1 voltage-source (Vdd, 0) U_output = 10 V
            I1 current-source (0, gate) I_output = 1 mA
            U1 self (gate = gate, drain = gate, source = Vdd)
        }
        measure operating gate
        within 6.5 V .. 9 V
    }

    expect "drain breakdown beyond -45 V" from "BVDSS at least -45 V" {
        bench for 1 ms {
            I1 current-source (0, drain) I_output = 100 uA
            U1 self (gate = 0, drain = drain, source = 0)
        }
        measure operating drain
        within -60 V .. -45 V
    }
}
