# A capacitor as it is: the charge its capacitance holds at the voltage across it — its value at the corner of its
# tolerance a bench sets, moved by its temperature coefficient from T_nominal. It stores and gives back; it takes no
# power, so it does not warm. Linear at any one temperature, it is integrated as every charge in the circuit is.

component "Capacitor" as capacitor type capacitor {
    meta {
        designator C
        summary "Two-terminal capacitor: its charge, tolerance and temperature drift"
        category circuits
    }
    parameters {
        capacitance = 100 nF "capacitance"
        tolerance = 10 %                         "how far a part may be from its value, ±; a bench's corners use it"
        temperature_coefficient = 200 ppm/K      "how its value moves per kelvin away from T_nominal; a bench's temperature uses it"
        T_nominal = 298.15 K                     "the temperature its value is given at"
        voltage_rating = 50 V                    "the most it is made to hold"
    }
    pins {
        terminal_one analog 1 "first terminal"
        terminal_two analog 2 "second terminal"
    }
    # While it runs, beside it: how near its rating it is — the voltage across it against that rating, which is also
    # its charge against the charge it holds there. Past 100 % it fails.
    display {
        overvoltage = 100 * abs(terminal_one - terminal_two) / voltage_rating unit % "of its rated voltage"
    }

    equations {
        let C_now : capacitance = capacitance * (1 + tolerance_corner * tolerance) * (1 + temperature_coefficient * (temperature - T_nominal))
        current terminal_one -> terminal_two = d(C_now * (terminal_one - terminal_two))/dt
    }

    # Drawn plain, or as an electrolytic — the polarized drawing, its "+" on terminal_one — by a part's `symbol` choice.
    symbol uses capacitor-symbol, polarized-capacitor-symbol {
        a terminal_one
        b terminal_two
    }
}
