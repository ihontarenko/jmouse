          definitions: Optional SourceText[15:9@592] "# max(x, 0), rounded over a knee `width` wide\n        soft_positive_part(x, width) = if(x > 0, x + width * ln(1 + exp(-x / width)), width * ln(1 + exp(x / width)))\n\n        # x held between low and high, with rounded knees\n        soft_clamp(x, low, high, width) = low + soft_positive_part(x - low, width) - soft_positive_part(x - high, width)\n\n        # min(a, b), rounded\n        soft_minimum(a, b, width) = a - soft_positive_part(a - b, width)\n\n        # |x|, rounded at zero\n        soft_absolute(x, width) = sqrt(x^2 + width^2)\n\n        # a step from 0 to 1 around zero, `width` wide\n        soft_step(x, width) = if(x > 0, 1 / (1 + exp(-x / width)), exp(x / width) / (1 + exp(x / width)))\n\n        # exp(x) that turns into its own tangent above 40 instead of overflowing\n        limit_exponential(x) = if(x < 40, exp(x), exp(40) * (x - 39))\n\n        # kT/q in volts\n        thermal_voltage(temperature) = boltzmann * temperature / elementary_charge"
