                      value: Double 1.0E-12
                      unit: "F"
                      written: "1 pF"
                  range: Optional.empty
                  step: Optional.empty
                  flags: List(0)
                  description: "the capacitance between its turns: with 100 µH, a self-resonance near 16 MHz, as a datasheet's SRF gives"
                  values: List(0)
