      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[58:9@2840] "final let MOST_BYTES = 16\n\n        function half_period()\n            return 1 / (2 * clock_frequency)\n        end\n\n        function put_bit()\n            drive('mosi', bit(item(sent, floor(clocked / 8)), 7 - clocked % 8))\n        end\n\n        # The bytes it was told to send, read once a transaction; with none it selects and lets go.\n        function select_target()\n            let written = bytes_of(bytes)\n            if written | length > MOST_BYTES then\n                refuse('bytes holds ' ~ (written | length) ~ ' bytes; it sends up to ' ~ MOST_BYTES)\n            end\n            sending = 0\n            for value in written do\n                sent = with(sent, sending, value)\n                sending = sending + 1\n            end\n            selected = 1\n            clocked = 0\n            incoming = 0\n            drive('cs', 0)\n            if sending == 0 then\n                schedule('release', half_period())\n                return\n            end\n            put_bit()\n            schedule('rise', half_period())\n        end\n\n        on start do\n            drive('cs', 1)\n            drive('sck', 0)\n            drive('mosi', 0)\n            drive('data', 0)\n            schedule('select', start_at)\n            if repeat_every > 0 then\n                schedule('repeat', start_at + repeat_every)\n            end\n        end\n\n        on timer 'select' do\n            select_target()\n        end\n\n        # The rising edge: the target's bit is read. A MISO no target drives yet is read as 0 — a target's \"don't care\"\n        # bits before its answer, which a real controller reads as whatever the line floats at.\n        on timer 'rise' do\n            drive('sck', 1)\n            incoming = incoming * 2 + level_or(miso, 0)\n            schedule('fall', half_period())\n        end\n\n        # The falling edge: a byte is complete every eighth one, and the next bit goes out.\n        on timer 'fall' do\n            drive('sck', 0)\n            clocked = clocked + 1\n            if clocked % 8 == 0 then\n                previous_read = last_read\n                last_read = incoming\n                drive('data', incoming)\n                incoming = 0\n            end\n            if clocked < 8 * sending then\n                put_bit()\n                schedule('rise', half_period())\n            else\n                schedule('release', half_period())\n            end\n        end\n\n        on timer 'release' do\n            drive('cs', 1)\n            selected = 0\n            if waiting == 1 then\n                waiting = 0\n                schedule('select', half_period())\n            end\n        end\n\n        # Every repetition is counted from the moment the first transaction began.\n        on timer 'repeat' do\n            schedule('repeat', repeat_every)\n            if selected == 1 then\n                waiting = 1\n            else\n                select_target()\n            end\n        end"
  line: Integer 10
