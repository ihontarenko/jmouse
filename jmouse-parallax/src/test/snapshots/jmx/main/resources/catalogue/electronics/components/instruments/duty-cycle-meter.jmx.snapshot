      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[28:9@1204] "on above 'input - reference - threshold' do\n            if rose >= 0 and fell > rose then\n                duty = (fell - rose) / (time - rose)\n            end\n            rose = time\n        end\n        on below 'input - reference - threshold' do\n            fell = time\n        end"
