      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[58:9@3313] "# The three steps of writing one byte.\n        final let SET_LINES = 0\n        final let RAISE_ENABLE = 1\n        final let LOWER_ENABLE = 2\n\n        # The instructions of table 6, each built from its bits.\n        function clear_display()\n            return 1\n        end\n\n        function entry_mode(increment, shift)\n            return 4 + 2 * increment + shift\n        end\n\n        function display_control(display, cursor_shown, blinking)\n            return 8 + 4 * display + 2 * cursor_shown + blinking\n        end\n\n        function function_set(eight_bit, two_lines, large_font)\n            return 32 + 16 * eight_bit + 8 * two_lines + 4 * large_font\n        end\n\n        # DDRAM address: row 0 starts at 00h, row 1 at 40h.\n        function ddram_address(row, column)\n            return 128 + 64 * row + column\n        end\n\n        function add_byte(value, character)\n            bytes = with(bytes, planned, value)\n            characters = with(characters, planned, character)\n            planned = planned + 1\n        end\n\n        function add_command(value)\n            add_byte(value, 0)\n        end\n\n        # A text's characters, each its code, then spaces up to `width`.\n        function add_text(text, width)\n            let text_length = text | length\n            for index in 0..width - 1 do\n                if index < text_length then\n                    add_byte(text | sub(index, index + 1) | char | int, 1)\n                else\n                    add_byte(32, 1)\n                end\n            end\n        end\n\n        function add_digit(value)\n            add_byte(48 + value % 10, 1)\n        end\n\n        # The second line: its label, then the count in four digits at the line's end.\n        function plan_second_line()\n            add_command(ddram_address(1, 0))\n            add_text(second_label, columns - 4)\n            add_digit(floor(updates / 1000))\n            add_digit(floor(updates / 100))\n            add_digit(floor(updates / 10))\n            add_digit(updates)\n        end\n\n        function plan_initialization()\n            add_command(function_set(1, 1, 0))\n            add_command(display_control(1, 0, 0))\n            add_command(clear_display())\n            add_command(entry_mode(1, 0))\n            add_command(ddram_address(0, 0))\n            add_text(first_line, columns)\n        end\n\n        function start_burst(initializing)\n            on_the_bus = 1\n            planned = 0\n            cursor = 0\n            phase = SET_LINES\n            if initializing == 1 then\n                plan_initialization()\n            end\n            plan_second_line()\n            updates = updates + 1\n            schedule('tick', 0)\n        end\n\n        # A clear and a return home take 1.52 ms; every other byte 37 µs.\n        function wait_after(value, character)\n            if character == 0 and value < 4 then\n                return clear_settle\n            end\n            return settle\n        end\n\n        on start do\n            drive('register_select', 0)\n            drive('read_write', 0)\n            drive('enable', 0)\n            drive('data', 0)\n            schedule('initialize', start_at)\n        end\n\n        on timer 'initialize' do\n            start_burst(1)\n            schedule('update', update_every)\n        end\n\n        on timer 'update' do\n            schedule('update', update_every)\n            if on_the_bus == 1 then\n                waiting = 1\n            else\n                start_burst(0)\n            end\n        end\n\n        # The burst's last byte is executed: an update that fell due meanwhile goes now.\n        on timer 'written' do\n            on_the_bus = 0\n            if waiting == 1 then\n                waiting = 0\n                start_burst(0)\n            end\n        end\n\n        on timer 'tick' do\n            let value = item(bytes, cursor)\n            let character = item(characters, cursor)\n            if phase == SET_LINES then\n                drive('register_select', character)\n                drive('data', value)\n                phase = RAISE_ENABLE\n                schedule('tick', bit_time)\n            elseif phase == RAISE_ENABLE then\n                drive('enable', 1)\n                phase = LOWER_ENABLE\n                schedule('tick', bit_time)\n            else\n                drive('enable', 0)\n                phase = SET_LINES\n                cursor = cursor + 1\n                if cursor < planned then\n                    schedule('tick', wait_after(value, character))\n                else\n                    schedule('written', wait_after(value, character))\n                end\n            end\n        end"
  line: Integer 8
