      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[32:9@1172] "on start do\n            drive('output', 1)\n            schedule('fall', duty / frequency)\n        end\n\n        on timer 'fall' do\n            drive('output', 0)\n            schedule('rise', (1 - duty) / frequency)\n        end\n\n        on timer 'rise' do\n            drive('output', 1)\n            schedule('fall', duty / frequency)\n        end"
