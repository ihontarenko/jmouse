      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[63:9@4007] "final let CONTINUES = 7             # Co: the control byte's top bit\n        final let DATA = 6                  # D/C#: 1 display data, 0 commands\n        # The commands every member shares, by their codes.\n        final let DISPLAY_OFF = 174         # AEh; AFh is on\n        final let NORMAL = 166              # A6h; A7h is inverse\n        final let SEGMENT_REMAP = 160       # A0h; A1h is remapped\n        final let SCAN_UP = 192             # C0h; C8h scans down\n        final let SCAN_DOWN = 200\n        final let PAGE_FIRST = 176          # B0h–B7h: the page\n        final let PAGE_LAST = 183\n        final let LOW_COLUMN_LAST = 15      # 00h–0Fh: the column's low nibble\n        final let HIGH_COLUMN_LAST = 31     # 10h–1Fh: its high nibble\n        final let CONTRAST = 129            # 81h + level: not modelled\n        final let MULTIPLEX = 168           # A8h + ratio: the panel's rows are the parameter\n        final let OFFSET = 211              # D3h + rows\n        final let CLOCK = 213               # D5h + divider\n        final let PRECHARGE = 217           # D9h + periods\n        final let COM_PINS = 218            # DAh + configuration\n        final let DESELECT_LEVEL = 219      # DBh + level\n\n        function chip_arguments(code)\n            return 0\n        end\n\n        function chip_command(code)\n        end\n\n        function chip_argument(code, index, value)\n        end\n\n        # Page addressing: on along the page, back to its first column past the last.\n        function advance()\n            column = (column + 1) % memory_columns\n        end\n\n        # How many arguments a command takes after its code: the shared ones here, the member's own from it.\n        function arguments_of(code)\n            if code in [CONTRAST, MULTIPLEX, OFFSET, CLOCK, PRECHARGE, COM_PINS, DESELECT_LEVEL] then\n                return 1\n            end\n            return chip_arguments(code)\n        end\n\n        function command(code)\n            if arguments_left > 0 then\n                chip_argument(pending, argument_index, code)\n                argument_index = argument_index + 1\n                arguments_left = arguments_left - 1\n            elseif code == DISPLAY_OFF or code == DISPLAY_OFF + 1 then\n                display_on = bit(code, 0)\n            elseif code == NORMAL or code == NORMAL + 1 then\n                inverted = bit(code, 0)\n            elseif code == SEGMENT_REMAP or code == SEGMENT_REMAP + 1 then\n                remapped = bit(code, 0)\n            elseif code == SCAN_UP or code == SCAN_DOWN then\n                scanned_back = bit(code, 3)\n            elseif code >= PAGE_FIRST and code <= PAGE_LAST then\n                page = code - PAGE_FIRST\n            elseif code <= LOW_COLUMN_LAST then\n                column = bit_or(bit_and(column, 240), code) % memory_columns\n            elseif code <= HIGH_COLUMN_LAST then\n                column = bit_or(bit_and(column, 15), shift_left(low_bits(code, 4), 4, 8)) % memory_columns\n            elseif arguments_of(code) > 0 then\n                pending = code\n                arguments_left = arguments_of(code)\n                argument_index = 0\n            else\n                chip_command(code)\n            end\n        end\n\n        # The first byte after the address is a control byte; with Co set, so is every other one.\n        function received(value, index)\n            if index == 0 or control_next == 1 then\n                single = bit(value, CONTINUES)\n                data_mode = bit(value, DATA)\n                control_next = 0\n                return\n            end\n            if data_mode == 1 then\n                memory = with(memory, page * memory_columns + column, value)\n                advance()\n            else\n                command(value)\n            end\n            if single == 1 then\n                control_next = 1\n            end\n        end"
