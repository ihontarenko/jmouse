                  form: EquationForm.LOCAL
                  subject: "beta"
                  positive: null
                  negative: null
                  expression: SourceText[110:51@8071] "transconductance * (1 + tolerance_corner * transconductance_spread) / warmth ^ 1.5"
                  type: QuantityType
                      name: "transconductance_coefficient"
                      unit: ""
                      dimension: Dimension
                          mass: Integer -2
                          length: Integer -4
                          time: Integer 6
                          current: Integer 3
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "overdrive"
                  positive: null
                  negative: null
                  expression: SourceText[111:35@8189] "V_control - V_threshold_now"
