                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_threshold_now"
                  positive: null
                  negative: null
                  expression: SourceText[109:41@7904] "polarity * V_threshold + tolerance_corner * V_threshold_spread + V_threshold_coefficient * (T_junction - T_nominal)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
