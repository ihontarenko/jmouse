              - Equation
                  form: EquationForm.LOCAL
                  subject: "square_law"
                  positive: null
                  negative: null
                  expression: SourceText[112:36@8253] "if(V_across < overdrive, beta * (overdrive - V_across / 2) * V_across, beta / 2 * overdrive ^ 2)"
                  type: QuantityType
                      name: "current"
                      unit: "A"
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 1
                          temperature: Integer 0
