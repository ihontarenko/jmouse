      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[44:9@1946] "on start do\n            if (a - GND) > upper_share * (Vcc - GND) then\n                high = 0\n            end\n        end\n\n        on above 'a - GND - upper_share * (Vcc - GND)' do\n            high = 0\n        end\n\n        on below 'a - GND - lower_share * (Vcc - GND)' do\n            high = 1\n        end"
