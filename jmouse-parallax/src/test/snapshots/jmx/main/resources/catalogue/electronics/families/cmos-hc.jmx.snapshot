      - Formulas
          definitions: Optional SourceText[28:9@1694] "# VIL and VIH: a CMOS input switches at a share of its supply\n        input_low(supply) = input_low_share * supply\n        input_high(supply) = input_high_share * supply\n\n        # An output's channel conducts less as its gate drive drops: the resistance grows as the supply falls\n        output_resistance(supply) = nominal_output_resistance * (nominal_supply / max(supply, minimum_supply)) ^ 1.5\n\n        # How much slower every delay a part writes is at this supply than at the nominal one\n        delay_scale(supply) = (nominal_supply / max(supply, minimum_supply)) ^ delay_exponent"
