      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[68:9@3980] "# The steps that are not a byte to send.\n        final let READ_AND_ACKNOWLEDGE = -1\n        final let READ_THE_LAST = -2  # read and NACK it: the target lets go of the bus\n        final let REPEATED_START = -3\n        final let STOP = -4\n        final let START = -5\n        final let MOST_BYTES = 16\n\n        function add_step(step)\n            plan = with(plan, planned, step)\n            planned = planned + 1\n        end\n\n        # The bytes it was told to send, read once a transaction.\n        function written_bytes()\n            let written = bytes_of(bytes)\n            if written | length > MOST_BYTES then\n                refuse('bytes holds ' ~ (written | length) ~ ' bytes; it sends up to ' ~ MOST_BYTES)\n            end\n            return written\n        end\n\n        function plan_write()\n            add_step(START)\n            add_step(address * 2)\n            for value in written_bytes() do\n                add_step(value)\n            end\n            add_step(STOP)\n        end\n\n        # A read names its register first, then turns the bus round with a repeated START.\n        function plan_read()\n            let written = written_bytes()\n            add_step(START)\n            if written | length > 0 then\n                add_step(address * 2)\n                add_step(written | first)\n                add_step(REPEATED_START)\n            end\n            add_step(address * 2 + 1)\n            for index in 1..count do\n                if index == count then\n                    add_step(READ_THE_LAST)\n                else\n                    add_step(READ_AND_ACKNOWLEDGE)\n                end\n            end\n            add_step(STOP)\n        end\n\n        function quarter_time()\n            return 1 / (4 * clock_frequency)\n        end\n\n        function next_step()\n            cursor = cursor + 1\n            quarter = 0\n        end\n\n        # START: SDA falls while SCL is high, then SCL falls.\n        function start_condition()\n            if quarter == 0 then\n                drive('sda', 0)\n            else\n                drive('scl', 0)\n                next_step()\n                return\n            end\n            quarter = quarter + 1\n        end\n\n        # A repeated START: SDA let go, SCL raised, then SDA falls under it and SCL follows.\n        function repeated_start()\n            if quarter == 0 then\n                drive('sda', 1)\n            elseif quarter == 1 then\n                drive('scl', 1)\n            elseif quarter == 2 then\n                drive('sda', 0)\n            else\n                drive('scl', 0)\n                next_step()\n                return\n            end\n            quarter = quarter + 1\n        end\n\n        # STOP: SDA low, SCL raised, then SDA let go under it.\n        function stop_condition()\n            if quarter == 0 then\n                drive('sda', 0)\n            elseif quarter == 1 then\n                drive('scl', 1)\n            else\n                drive('sda', 1)\n                next_step()\n                return\n            end\n            quarter = quarter + 1\n        end\n\n        # One bit of a byte, a quarter at a time: SDA set while SCL is low, SCL raised, SDA read, SCL lowered.\n        function byte_quarter(step)\n            let sending = step >= 0\n            if quarter == 0 then\n                if bits < 8 and sending then\n                    drive('sda', bit(step, 7 - bits))\n                elseif bits == 8 and step == READ_AND_ACKNOWLEDGE then\n                    drive('sda', 0)\n                else\n                    drive('sda', 1)\n                end\n            elseif quarter == 1 then\n                drive('scl', 1)\n            elseif quarter == 2 then\n                if bits < 8 and not sending then\n                    # A line nobody holds at a level reads as the pull-up leaves it.\n                    incoming = incoming * 2 + level_or(sda, 1)\n                elseif bits == 8 and sending then\n                    acknowledged = 1 - level_or(sda, 1)\n                end\n            else\n                drive('scl', 0)\n                bits = bits + 1\n                if bits == 9 then\n                    if not sending then\n                        last_read = incoming\n                        drive('data', incoming)\n                        incoming = 0\n                    end\n                    bits = 0\n                    next_step()\n                    return\n                end\n            end\n            quarter = (quarter + 1) % 4\n        end\n\n        function begin()\n            on_the_bus = 1\n            planned = 0\n            cursor = 0\n            quarter = 0\n            bits = 0\n            incoming = 0\n            if operation == 'read' or reading_back == 1 then\n                plan_read()\n            else\n                plan_write()\n            end\n            schedule('tick', quarter_time())\n        end\n\n        # The last STOP is out: a write's read back follows, else the bus is free — for a repetition that waited.\n        function finish()\n            if operation == 'write-read' and reading_back == 0 then\n                reading_back = 1\n                schedule('begin', pause)\n                return\n            end\n            reading_back = 0\n            on_the_bus = 0\n            if waiting == 1 then\n                waiting = 0\n                begin()\n            end\n        end\n\n        # Every repetition is counted from the moment the first transaction began.\n        on timer 'repeat' do\n            schedule('repeat', repeat_every)\n            if on_the_bus == 1 then\n                waiting = 1\n            else\n                begin()\n            end\n        end\n\n        on start do\n            drive('scl', 1)\n            drive('sda', 1)\n            drive('data', 0)\n            schedule('begin', start_at)\n            if repeat_every > 0 then\n                schedule('repeat', start_at + repeat_every)\n            end\n        end\n\n        on timer 'begin' do\n            begin()\n        end\n\n        on timer 'tick' do\n            let step = item(plan, cursor)\n            if step == START then\n                start_condition()\n            elseif step == REPEATED_START then\n                repeated_start()\n            elseif step == STOP then\n                stop_condition()\n            else\n                byte_quarter(step)\n            end\n            if cursor < planned then\n                schedule('tick', quarter_time())\n            else\n                finish()\n            end\n        end"
  line: Integer 14
