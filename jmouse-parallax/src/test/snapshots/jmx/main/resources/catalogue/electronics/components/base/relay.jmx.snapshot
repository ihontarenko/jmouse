      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[87:9@5038] "# Either way round: a relay's coil pulls whichever way its current runs.\n        on above 'abs(coil_current - coil_two) - V_pull_in / R_coil' do\n            energized = 1\n        end\n\n        on below 'abs(coil_current - coil_two) - V_drop_out / R_coil' when energized > 0 do\n            energized = 0\n        end"
