                  positive: null
                  negative: null
                  expression: SourceText[111:36@7813] "I_input_bias * 2 ^ ((T_junction - T_nominal) / bias_doubling)"
                  type: QuantityType
                      name: "current"
                      unit: "A"
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "high"
                  positive: null
                  negative: null
                  expression: SourceText[112:30@7905] "GND + V_output_low + soft_positive_part((Vcc - GND) - V_output_headroom - V_output_low, 0.02)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "low"
                  positive: null
                  negative: null
                  expression: SourceText[113:29@8028] "GND + V_output_low"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_common"
                  positive: null
                  negative: null
                  expression: SourceText[117:34@8326] "(non_inverting_input + inverting_input) / 2"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_lowest"
                  positive: null
                  negative: null
                  expression: SourceText[118:34@8404] "soft_minimum(non_inverting_input, inverting_input, 0.01)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_highest"
                  positive: null
                  negative: null
                  expression: SourceText[119:35@8496] "0 - soft_minimum(0 - non_inverting_input, 0 - inverting_input, 0.01)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "past_low"
                  positive: null
                  negative: null
                  expression: SourceText[120:34@8599] "soft_positive_part(GND + V_common_mode_low - V_lowest, 0.1)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "past_high"
                  positive: null
                  negative: null
                  expression: SourceText[121:35@8694] "soft_positive_part(V_highest - (Vcc - V_common_mode_high), 0.1)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "lost"
                  positive: null
                  negative: null
                  expression: SourceText[122:28@8786] "(past_low + past_high) / sqrt(1 + (past_low + past_high) ^ 2)"
                  type: QuantityType
                      name: "ratio"
                      unit: ""
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 0
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "reversed"
                  positive: null
                  negative: null
                  expression: SourceText[123:32@8880] "phase_reversal * past_low / sqrt(1 + past_low ^ 2)"
                  type: QuantityType
                      name: "ratio"
                      unit: ""
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 0
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "common_mode_error"
                  positive: null
                  negative: null
                  expression: SourceText[125:43@8976] "(V_common - (Vcc + GND) / 2) / common_mode_rejection"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "supply_error"
                  positive: null
                  negative: null
                  expression: SourceText[126:38@9067] "((Vcc - GND) - V_supply_nominal) / supply_rejection"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "input"
                  positive: null
                  negative: null
                  expression: SourceText[127:31@9150] "(non_inverting_input - inverting_input) + V_offset_now + (noise_input - GND) + common_mode_error + supply_error"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "error"
                  positive: null
                  negative: null
                  expression: SourceText[128:31@9293] "input * (1 - lost - reversed) - gain_stage_voltage / open_loop_gain"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "slew_ratio"
