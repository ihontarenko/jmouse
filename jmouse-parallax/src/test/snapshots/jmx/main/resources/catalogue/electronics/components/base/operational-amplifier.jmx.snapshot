                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_offset_now"
                  positive: null
                  negative: null
                  expression: SourceText[110:38@7681] "V_input_offset + tolerance_corner * V_offset_spread + V_offset_drift * (T_junction - T_nominal)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
