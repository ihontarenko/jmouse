                  length: Integer 0
      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[60:9@3120] "final let IDLE = 0             # not addressed: it only listens for a START\n        final let ADDRESSING = 1       # a START was heard; the address byte is coming in\n        final let WRITTEN_TO = 2       # its address was heard with the write bit\n        final let READ_FROM = 3        # its address was heard with the read bit\n        final let ACKNOWLEDGING = 9    # the count of bits while the ninth clock — the ACK — is on the bus\n\n        function own_address()\n            return address\n        end\n\n        function acknowledges()\n            return true\n        end\n\n        function received(value, index)\n        end\n\n        function transmitted(index)\n            return 255\n        end\n\n        function stopped()\n        end\n\n        function release()\n            drive('sda', 1, data_hold)\n        end\n\n        # The transaction is lost or not ours: the bus is let go of until the next START.\n        function forget()\n            phase = IDLE\n            bits = 0\n            release()\n        end\n\n        # The next byte out: asked of the chip, its first bit put on the line at once.\n        function send_next()\n            outgoing = transmitted(position)\n            position = position + 1\n            bits = 0\n            drive('sda', bit(outgoing, 7), data_hold)\n        end\n\n        # The ninth clock is over: the next byte begins.\n        function next_byte()\n            bits = 0\n            shift = 0\n            if phase == ADDRESSING then\n                if bit(selection, 0) == 1 then\n                    phase = READ_FROM\n                    send_next()\n                else\n                    phase = WRITTEN_TO\n                    release()\n                end\n            else\n                release()\n            end\n        end\n\n        # Eight bits are in: an address that is ours and answered, or a data byte for the chip — acknowledged either way.\n        function byte_in()\n            if phase == ADDRESSING then\n                if shift_right(shift, 1) != own_address() or not acknowledges() then\n                    forget()\n                    return\n                end\n                selection = shift\n            else\n                received(shift, position)\n                position = position + 1\n            end\n            bits = ACKNOWLEDGING\n            drive('sda', 0, data_hold)\n        end\n\n        # SDA falling while SCL is high: a START, or a repeated one.\n        on falling 'sda' when scl == 1 do\n            phase = ADDRESSING\n            bits = 0\n            shift = 0\n            position = 0\n            release()\n        end\n\n        # SDA rising while SCL is high: a STOP.\n        on rising 'sda' when scl == 1 do\n            if phase != IDLE then\n                stopped()\n            end\n            forget()\n        end\n\n        on rising 'scl' when phase != IDLE do\n            if not known(sda) then\n                forget()\n            elseif phase == READ_FROM then\n                if bits < 8 then\n                    bits = bits + 1\n                elseif bits == 8 then\n                    # The controller's ACK: a high here is its NACK, the last byte it wanted.\n                    bits = ACKNOWLEDGING\n                    if sda == 1 then\n                        phase = IDLE\n                    end\n                end\n            elseif bits < 8 then\n                shift = shift * 2 + sda\n                bits = bits + 1\n            end\n        end\n\n        on falling 'scl' when phase != IDLE do\n            if phase == READ_FROM then\n                if bits < 8 then\n                    drive('sda', bit(outgoing, 7 - bits), data_hold)\n                elseif bits == 8 then\n                    release()\n                else\n                    send_next()\n                end\n            elseif bits == 8 then\n                byte_in()\n            elseif bits == ACKNOWLEDGING then\n                next_byte()\n            end\n        end"
  line: Integer 15
