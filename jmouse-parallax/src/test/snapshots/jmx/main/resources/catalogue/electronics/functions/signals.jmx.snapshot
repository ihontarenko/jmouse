      - Formulas
          definitions: Optional SourceText[16:9@975] "# where in its slice the k-th sine sits, 0.05 … 0.95, and its phase: deterministic scatter\n        slice_jitter(k, seed) = 0.5 + 0.45 * sin(12.9898 * k + 78.233 * seed)\n        slice_phase(k, seed) = pi * (1 + sin(39.3468 * k + 11.135 * seed))\n\n        # white noise up to `bandwidth`: 48 sines, equally strong, evenly over the band — RMS 1\n        band_noise(t, bandwidth, seed) = sqrt(2 / 48) * sum(k, 1, 48, sin(2 * pi * bandwidth * (k - 1 + slice_jitter(k, seed)) / 48 * t + slice_phase(k, seed)))\n\n        # pink noise from `lowest` to `highest`: 48 sines, equally strong, evenly over the band's LOGARITHM — the same\n        # power in every octave, which is what pink means — RMS 1\n        pink_noise(t, lowest, highest, seed) = sqrt(2 / 48) * sum(k, 1, 48, sin(2 * pi * lowest * (highest / lowest)^((k - 1 + slice_jitter(k, seed)) / 48) * t + slice_phase(k, seed)))"
