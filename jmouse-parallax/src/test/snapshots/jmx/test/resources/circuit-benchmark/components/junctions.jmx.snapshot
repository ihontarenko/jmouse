      - Formulas
          definitions: Optional SourceText[14:9@720] "# A saturation current (IS, ISR, ISE …) at `temperature`, from its value at `nominal`: the band gap and XTI\n        junction_saturation(current, temperature, nominal, exponent, emission, gap) = current * (temperature / nominal) ^ (exponent / emission) * exp((temperature / nominal - 1) * gap / (emission * thermal_voltage(temperature)))\n\n        # The ideal junction: saturation · (e^(V / N·Vt) − 1), its exponential turned tangent before it can overflow\n        junction_current(voltage, saturation, emission, temperature) = saturation * (limit_exponential(voltage / (emission * thermal_voltage(temperature))) - 1)\n\n        # The depletion charge. Below FC·VJ the graded junction, CJO·VJ/(1−M)·(1 − (1 − V/VJ)^(1−M)); above it SPICE\n        # continues the capacitance as a straight line, since the true one goes to infinity at VJ. The voltage inside\n        # the power is held at the boundary, so no branch ever raises a negative number to a fraction.\n        depletion_charge(voltage, zero_bias, potential, grading, boundary) = zero_bias * potential / (1 - grading) * (1 - (1 - if(voltage < boundary * potential, voltage, boundary * potential) / potential) ^ (1 - grading)) + if(voltage < boundary * potential, 0, zero_bias / (1 - boundary) ^ (1 + grading) * ((1 - boundary * (1 + grading)) * (voltage - boundary * potential) + grading / (2 * potential) * (voltage ^ 2 - (boundary * potential) ^ 2)))\n\n        # ISR's generation–recombination factor: the low-current excess of the forward curve, and the reverse leakage\n        # that grows with the depletion width\n        recombination_factor(voltage, potential, grading) = ((1 - voltage / potential) ^ 2 + 0.005) ^ (grading / 2)\n\n        # High injection (IKF): above the knee the current grows as the square root of what the ideal law says\n        high_injection(current, knee) = current * sqrt(knee / (knee + soft_positive_part(current, 1e-15)))\n\n        # The reverse breakdown, an exponential in how far past V_breakdown the junction is pushed\n        breakdown_current(voltage, breakdown, current, emission, temperature) = current * limit_exponential((0 - voltage - breakdown) / (emission * thermal_voltage(temperature)))"
