      - Behaviour
          script: ScriptNode "SCRIPT['behaviour']"
          source: SourceText[85:9@3732] "on start do\n            if (reset - GND) > V_reset and (trigger - lower) < 0 then\n                latched = 1\n            end\n        end\n\n        # the trigger fell under Vcc / 3: set\n        on below 'trigger - lower' when (reset - GND) > V_reset do\n            latched = 1\n        end\n\n        # the threshold rose over 2/3 Vcc: reset, unless the trigger still holds it set\n        on above 'threshold - control' when (trigger - lower) > 0 do\n            latched = 0\n        end\n\n        # the trigger let go while the threshold was already over\n        on above 'trigger - lower' when (threshold - control) > 0 do\n            latched = 0\n        end\n\n        # reset dominates\n        on below 'reset - GND - V_reset' do\n            latched = 0\n        end"
