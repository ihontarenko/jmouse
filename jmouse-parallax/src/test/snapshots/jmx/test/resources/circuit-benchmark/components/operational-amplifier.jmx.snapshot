      - Equations
          equations: List(34)
              - Equation
                  form: EquationForm.LOCAL
                  subject: "T_junction"
                  positive: null
                  negative: null
                  expression: SourceText[97:40@6597] "temperature"
                  type: QuantityType
                      name: "temperature"
                      unit: "K"
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 0
                          temperature: Integer 1
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_supply_knee"
                  positive: null
                  negative: null
                  expression: SourceText[99:39@6745] "1"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_offset_now"
                  positive: null
                  negative: null
                  expression: SourceText[100:38@6785] "V_input_offset + tolerance_corner * V_offset_spread + V_offset_drift * (T_junction - T_nominal)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "I_bias_now"
                  positive: null
                  negative: null
                  expression: SourceText[101:36@6917] "I_input_bias * 2 ^ ((T_junction - T_nominal) / bias_doubling)"
                  type: QuantityType
                      name: "current"
                      unit: "A"
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "high"
                  positive: null
                  negative: null
                  expression: SourceText[102:30@7009] "GND + V_output_low + soft_positive_part((Vcc - GND) - V_output_headroom - V_output_low, 0.02)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "low"
                  positive: null
                  negative: null
                  expression: SourceText[103:29@7132] "GND + V_output_low"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_common"
                  positive: null
                  negative: null
                  expression: SourceText[107:34@7430] "(non_inverting_input + inverting_input) / 2"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_lowest"
                  positive: null
                  negative: null
                  expression: SourceText[108:34@7508] "soft_minimum(non_inverting_input, inverting_input, 0.01)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "V_highest"
                  positive: null
                  negative: null
                  expression: SourceText[109:35@7600] "0 - soft_minimum(0 - non_inverting_input, 0 - inverting_input, 0.01)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "past_low"
                  positive: null
                  negative: null
                  expression: SourceText[110:34@7703] "soft_positive_part(GND + V_common_mode_low - V_lowest, 0.1)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "past_high"
                  positive: null
                  negative: null
                  expression: SourceText[111:35@7798] "soft_positive_part(V_highest - (Vcc - V_common_mode_high), 0.1)"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "lost"
                  positive: null
                  negative: null
                  expression: SourceText[112:28@7890] "(past_low + past_high) / sqrt(1 + (past_low + past_high) ^ 2)"
                  type: QuantityType
                      name: "ratio"
                      unit: ""
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 0
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "reversed"
                  positive: null
                  negative: null
                  expression: SourceText[113:32@7984] "phase_reversal * past_low / sqrt(1 + past_low ^ 2)"
                  type: QuantityType
                      name: "ratio"
                      unit: ""
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 0
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "common_mode_error"
                  positive: null
                  negative: null
                  expression: SourceText[115:43@8080] "(V_common - (Vcc + GND) / 2) / common_mode_rejection"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "supply_error"
                  positive: null
                  negative: null
                  expression: SourceText[116:38@8171] "((Vcc - GND) - V_supply_nominal) / supply_rejection"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "input"
                  positive: null
                  negative: null
                  expression: SourceText[117:31@8254] "(non_inverting_input - inverting_input) + V_offset_now + (noise_input - GND) + common_mode_error + supply_error"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "error"
                  positive: null
                  negative: null
                  expression: SourceText[118:31@8397] "input * (1 - lost - reversed) - gain_stage_voltage / open_loop_gain"
                  type: QuantityType
                      name: "voltage"
                      unit: "V"
                      dimension: Dimension
                          mass: Integer 1
                          length: Integer 2
                          time: Integer -3
                          current: Integer -1
                          temperature: Integer 0
              - Equation
                  form: EquationForm.LOCAL
                  subject: "slew_ratio"
                  positive: null
                  negative: null
                  expression: SourceText[123:34@8856] "2 * pi * gain_bandwidth * error / slew_rate"
                  type: QuantityType
                      name: "ratio"
                      unit: ""
                      dimension: Dimension
                          mass: Integer 0
                          length: Integer 0
                          time: Integer 0
                          current: Integer 0
                          temperature: Integer 0
              - Equation
                  form: EquationForm.DERIVATIVE
                  subject: "gain_stage_voltage"
                  positive: null
                  negative: null
                  expression: SourceText[124:36@8936] "slew_rate * slew_ratio / sqrt(1 + slew_ratio ^ 2) - recovery * (gain_stage_voltage - soft_clamp(gain_stage_voltage, low - 0.5, high + 0.5, 0.05))"
                  type: null
              - Equation
                  form: EquationForm.LOCAL
                  subject: "pole_time"
                  positive: null
