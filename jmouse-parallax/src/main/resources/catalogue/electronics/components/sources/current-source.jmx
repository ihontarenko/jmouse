component "Current source" as current-source type current-source {
    meta {
        designator I
        summary "Two-terminal DC current source"
        category circuits
    }
    parameters {
        I_output = 1 mA "source current"
    }
    pins {
        positive analog 1 "positive terminal"
        negative analog 2 "negative terminal"
    }
    symbol uses current-source-symbol {
        a positive
        b negative
    }
}
