# An ideal square voltage between two levels, its duty worked while the circuit runs. Its edges are where the comparison
# flips and where the period wraps — the engine finds both in this equation and lands a step on each, so nothing about
# a square wave is known anywhere but here.

component "Square generator" as square-generator type generator {
    meta {
        designator G
        summary "An ideal square voltage: high for the duty's share of every period, low for the rest"
        category circuits
    }

    parameters {
        high = 5 V                                   "the level while on"
        low = 0 V                                    "the level while off"
        frequency = 1 kHz                            "how many periods a second"
        duty = 0.5 in 0.01 .. 0.99 step 0.01 live    "share of each period spent high"
    }

    pins {
        positive analog 1  "positive terminal"
        negative analog 2  "negative terminal"
    }

    symbol uses square-source-symbol {
        a positive
        b negative
    }

    equations {
        voltage positive -> negative = low + (high - low) * (mod(frequency * time, 1) < duty)
    }
}
