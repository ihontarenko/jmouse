component "Wattmeter" as wattmeter type meter {
    meta {
        designator WM
        summary "Reads the power a load takes: its current through in and out, its voltage across plus and minus"
        category circuits
    }
    parameters {
        R_input = 10 MOhm "voltage input resistance: what it draws through, on a realistic bench"
    }
    pins {
        in analog 1 "current in"
        out analog 2 "current out"
        plus analog 3 "voltage, red lead"
        minus analog 4 "voltage, black lead"
    }
    equations {
        voltage in -> out = 0
        current plus -> minus = realistic * (plus - minus) / R_input
    }
    leads {
        in yellow stripes black
        out yellow
        plus red stripes black
        minus black stripes white
    }
    measure {
        reading = (plus - minus) * in.current unit W signal
    }
    symbol uses wattmeter-symbol {
        a in
        b out
        c plus
        d minus
    }

    expect "neither drops nor draws on an ideal bench" from "an ideal wattmeter on a 1 kOhm load leaves all 10 V across it" {
        bench for 1 ms {
            V1 voltage-source (top, 0) U_output = 10 V
            U1 self (in = top, out = load, plus = load, minus = 0)
            R1 resistor (load, 0) resistance = 1 kOhm
        }
        measure final load
        near 10 V +- 0.1%
    }
}
