component "Voltmeter" as voltmeter type meter {
    meta {
        designator VM
        summary "Reads the voltage of its red lead against its black one"
        category circuits
    }
    parameters {
        R_input = 10 MOhm "input resistance: what it draws through, on a realistic bench"
    }
    pins {
        plus analog 1 "red lead"
        minus analog 2 "black lead"
    }
    equations {
        # Ideal it draws nothing; on a realistic bench it is its input resistance across what it reads.
        current plus -> minus = realistic * (plus - minus) / R_input
    }
    leads {
        plus red stripes black
        minus black stripes white
    }
    measure {
        reading = plus - minus unit V signal
    }
    symbol uses voltmeter-symbol {
        a plus
        b minus
    }

    expect "draws nothing on an ideal bench" from "an ideal voltmeter across the lower half of a 1 MOhm divider leaves it at half" {
        bench for 1 ms {
            V1 voltage-source (top, 0) U_output = 10 V
            R1 resistor (top, middle) resistance = 1 MOhm
            R2 resistor (middle, 0) resistance = 1 MOhm
            U1 self (plus = middle, minus = 0)
        }
        measure final middle
        near 5 V +- 0.1%
    }
}
