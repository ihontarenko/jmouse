component "Frequency meter" as frequency-meter type meter {
    meta {
        designator FM
        summary "Reads how often its input rises through a level: one over the time between two rising edges"
        category circuits
    }
    parameters {
        threshold = 0 V "the level a rising edge crosses"
        R_input = 1 MOhm "input resistance: what it draws through, on a realistic bench"
    }
    pins {
        input analog 1 "signal"
        reference analog 2 "what the signal is read against"
    }
    state {
        last_edge = -1 discrete "when the input last rose through the level; -1 before the first"
        frequency = 0 discrete "one over the time between the last two rising edges"
    }
    equations {
        current input -> reference = realistic * (input - reference) / R_input
    }
    behaviour {
        on above 'input - reference - threshold' do
            if last_edge >= 0 then
                frequency = 1 / (time - last_edge)
            end
            last_edge = time
        end
    }
    leads {
        input white stripes blue
        reference grey
    }
    measure {
        reading = frequency unit Hz
    }
    symbol uses frequency-meter-symbol {
        a input
        b reference
    }

    expect "draws nothing on an ideal bench" from "an ideal frequency meter across the lower half of a 1 MOhm divider leaves it at half" {
        bench for 1 ms {
            V1 voltage-source (top, 0) U_output = 10 V
            R1 resistor (top, middle) resistance = 1 MOhm
            R2 resistor (middle, 0) resistance = 1 MOhm
            U1 self (input = middle, reference = 0)
        }
        measure final middle
        near 5 V +- 0.1%
    }
}
