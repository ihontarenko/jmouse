# An I²C controller for the bench: it drives a transaction onto SCL and SDA, once or over and over — a write, a read, or
# a write and then a read of what was written — at a set moment and a set clock, as a bus analyser's "send" button does.
# Both lines are open drain, so the bus wants its pull-ups. The last byte it read stands on its data outputs, where an
# LED bar or a check can see it; whether the target acknowledged is its display.
#
# What it sends is one text of bytes, decimal or 0x hexadecimal, parted by spaces or commas: `bytes = "3 90"` writes a
# register, then a byte into it. A read sends the first of them — the register it starts from — then turns the bus round
# with a repeated START and reads `count` bytes; with no bytes at all it reads from where the target's pointer stands.
#
# A transaction is planned as a row of steps, then clocked out a quarter of a bit at a time. A repetition that falls due
# while one is still on the bus waits for its STOP, as a controller's queue would; it never cuts a transfer short. It
# never waits for a target that stretches the clock, and it is the only controller it expects on the bus.

component "I²C controller" as i2c-controller type controller {
    meta {
        designator BUS
        summary "Drives one I²C transaction — write, read, or write then read — and shows the last byte it read"
        source "NXP UM10204, I²C-bus specification and user manual, rev. 7.0 (2021): §3.1, a controller's view of a transfer"
        category circuits
    }
    use cmos-hc

    parameters {
        address = 80 in 8 .. 119 step 1 integer        "the target's 7-bit address"
        bytes = "0 165"                                "the bytes after the address, up to 16, decimal or 0x hexadecimal: a register, then what is written into it"
        operation = "write" in ["write", "read", "write-read"]   "a write, a read, or a write and then a read back from its first byte"
        count = 1 in 1 .. 8 step 1 integer             "how many bytes a read takes"
        clock_frequency = 100 kHz                      "SCL: 100 kHz standard mode, 400 kHz fast mode"
        start_at = 20 us                               "when the transaction begins"
        pause = 100 us                                 "between the write and the read back: an EEPROM's write cycle wants 5 ms"
        repeat_every = 0 s                             "the whole transaction again this long after it began; 0 runs it once"
    }

    pins {
        scl digital bidirectional open-drain 1         "serial clock"
        sda digital bidirectional open-drain 2         "serial data"
        data[0..7] digital output 3, 4, 5, 6, 7, 8, 9, 10   "the last byte read, D0 the least significant bit"
        GND ground 11
        Vcc power 12
    }

    symbol box {
        left scl, sda
        right data
        power Vcc, GND
    }

    state {
        plan[24] = 0 discrete         "the steps of this transaction: a byte to send, or one of the conditions below"
        planned = 0 discrete          "how many steps are planned"
        cursor = 0 discrete           "the step being clocked out"
        quarter = 0 discrete          "which quarter of the bit or condition it is in"
        bits = 0 discrete             "bits of the present byte clocked; 8 is the ACK clock"
        incoming = 0 discrete         "the byte being read"
        reading_back = 0 discrete     "1 during the read that follows a write"
        on_the_bus = 0 discrete       "1 from a transaction's START to its last STOP"
        waiting = 0 discrete          "1 when a repetition fell due while a transaction was on the bus"
        acknowledged = 0 discrete     "whether the last byte sent was acknowledged"
        last_read = 0 discrete        "the last byte read"
    }

    display {
        taken = acknowledged          "1 when the target took the last byte sent"
        byte_read = last_read         "the last byte read"
    }

    behaviour {
        # The steps that are not a byte to send.
        final let READ_AND_ACKNOWLEDGE = -1
        final let READ_THE_LAST = -2  # read and NACK it: the target lets go of the bus
        final let REPEATED_START = -3
        final let STOP = -4
        final let START = -5
        final let MOST_BYTES = 16

        function add_step(step)
            plan = with(plan, planned, step)
            planned = planned + 1
        end

        # The bytes it was told to send, read once a transaction.
        function written_bytes()
            let written = bytes_of(bytes)
            if written | length > MOST_BYTES then
                refuse('bytes holds ' ~ (written | length) ~ ' bytes; it sends up to ' ~ MOST_BYTES)
            end
            return written
        end

        function plan_write()
            add_step(START)
            add_step(address * 2)
            for value in written_bytes() do
                add_step(value)
            end
            add_step(STOP)
        end

        # A read names its register first, then turns the bus round with a repeated START.
        function plan_read()
            let written = written_bytes()
            add_step(START)
            if written | length > 0 then
                add_step(address * 2)
                add_step(written | first)
                add_step(REPEATED_START)
            end
            add_step(address * 2 + 1)
            for index in 1..count do
                if index == count then
                    add_step(READ_THE_LAST)
                else
                    add_step(READ_AND_ACKNOWLEDGE)
                end
            end
            add_step(STOP)
        end

        function quarter_time()
            return 1 / (4 * clock_frequency)
        end

        function next_step()
            cursor = cursor + 1
            quarter = 0
        end

        # START: SDA falls while SCL is high, then SCL falls.
        function start_condition()
            if quarter == 0 then
                drive('sda', 0)
            else
                drive('scl', 0)
                next_step()
                return
            end
            quarter = quarter + 1
        end

        # A repeated START: SDA let go, SCL raised, then SDA falls under it and SCL follows.
        function repeated_start()
            if quarter == 0 then
                drive('sda', 1)
            elseif quarter == 1 then
                drive('scl', 1)
            elseif quarter == 2 then
                drive('sda', 0)
            else
                drive('scl', 0)
                next_step()
                return
            end
            quarter = quarter + 1
        end

        # STOP: SDA low, SCL raised, then SDA let go under it.
        function stop_condition()
            if quarter == 0 then
                drive('sda', 0)
            elseif quarter == 1 then
                drive('scl', 1)
            else
                drive('sda', 1)
                next_step()
                return
            end
            quarter = quarter + 1
        end

        # One bit of a byte, a quarter at a time: SDA set while SCL is low, SCL raised, SDA read, SCL lowered.
        function byte_quarter(step)
            let sending = step >= 0
            if quarter == 0 then
                if bits < 8 and sending then
                    drive('sda', bit(step, 7 - bits))
                elseif bits == 8 and step == READ_AND_ACKNOWLEDGE then
                    drive('sda', 0)
                else
                    drive('sda', 1)
                end
            elseif quarter == 1 then
                drive('scl', 1)
            elseif quarter == 2 then
                if bits < 8 and !sending then
                    # A line nobody holds at a level reads as the pull-up leaves it.
                    incoming = incoming * 2 + level_or(sda, 1)
                elseif bits == 8 and sending then
                    acknowledged = 1 - level_or(sda, 1)
                end
            else
                drive('scl', 0)
                bits = bits + 1
                if bits == 9 then
                    if !sending then
                        last_read = incoming
                        drive('data', incoming)
                        incoming = 0
                    end
                    bits = 0
                    next_step()
                    return
                end
            end
            quarter = (quarter + 1) % 4
        end

        function begin()
            on_the_bus = 1
            planned = 0
            cursor = 0
            quarter = 0
            bits = 0
            incoming = 0
            if operation == 'read' or reading_back == 1 then
                plan_read()
            else
                plan_write()
            end
            schedule('tick', quarter_time())
        end

        # The last STOP is out: a write's read back follows, else the bus is free — for a repetition that waited.
        function finish()
            if operation == 'write-read' and reading_back == 0 then
                reading_back = 1
                schedule('begin', pause)
                return
            end
            reading_back = 0
            on_the_bus = 0
            if waiting == 1 then
                waiting = 0
                begin()
            end
        end

        # Every repetition is counted from the moment the first transaction began.
        on timer 'repeat' do
            schedule('repeat', repeat_every)
            if on_the_bus == 1 then
                waiting = 1
            else
                begin()
            end
        end

        on start do
            drive('scl', 1)
            drive('sda', 1)
            drive('data', 0)
            schedule('begin', start_at)
            if repeat_every > 0 then
                schedule('repeat', start_at + repeat_every)
            end
        end

        on timer 'begin' do
            begin()
        end

        on timer 'tick' do
            let step = item(plan, cursor)
            if step == START then
                start_condition()
            elseif step == REPEATED_START then
                repeated_start()
            elseif step == STOP then
                stop_condition()
            else
                byte_quarter(step)
            end
            if cursor < planned then
                schedule('tick', quarter_time())
            else
                finish()
            end
        end
    }
}
