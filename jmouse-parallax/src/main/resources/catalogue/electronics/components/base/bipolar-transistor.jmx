# The bipolar transistor every bipolar part is a member of: the Gummel–Poon model, both junctions from the shared
# junction functions. A datasheet part writes `family npn-transistor` (or pnp) and its numbers; the physics is here.
#
# What the effects are for:
#   ISE/NE, ISC/NC   the base currents that do not reach the collector — the gain falls at low current
#   IKF, IKR         high injection — the gain falls at high current; with the two above, hFE peaks and falls both sides
#   VAF, VAR         the Early effect — the collector current rises with VCE
#   TF, XTF, VTF, ITF  the charge stored in the base — fT, and how it drops at high current and low VCE
#   TR               the charge stored when saturated — the storage time of a switch
#   CJE…, CJC…, XCJC the junction capacitances and how much of CJC sits behind the base resistance (Miller)
#   RB, RBM          the base resistance, falling towards RBM at high injection
#   XTB, XTI, EG     the gain and the saturation currents over temperature
#   V_breakdown      collector–emitter avalanche: not part of Gummel–Poon, but where an inductive kick stops
#
# Polarity is a parameter: 1 for NPN, -1 for PNP — every voltage is read, and every current driven, through it.
# Not represented: the substrate junction (CJS), IRB's current-dependent base resistance, excess phase (PTF), noise.

component "Bipolar transistor" as bipolar-transistor type bjt {
    meta {
        designator Q
        summary "Gummel–Poon bipolar transistor: gain falling at both ends, Early effect, stored charge, junction capacitances"
        source "Gummel–Poon model as in Berkeley SPICE3 / ngspice 47; defaults are that model's"
        category circuits
        failure open
    }
    use smooth-transitions, junctions

    parameters {
        polarity = 1                          "1 for NPN, -1 for PNP"
        I_saturation = 0.1 fA                 "IS: transport saturation current"
        beta_forward = 100                    "BF: ideal forward current gain"
        beta_forward_spread = 0               "how far BF spreads from part to part, as a share: a bench's tolerance corners use it"
        emission_coefficient = 1              "NF: forward emission coefficient"
        V_early = 1 MV                        "VAF: forward Early voltage (none is a megavolt here)"
        I_knee = 1000000000 A                 "IKF: forward high-injection knee (none is a gigaampere here)"
        I_leakage_base_emitter = 0 A          "ISE: base–emitter leakage saturation current"
        leakage_emission_base_emitter = 1.5   "NE: its emission coefficient"
        beta_reverse = 1                      "BR: ideal reverse current gain"
        emission_coefficient_reverse = 1      "NR: reverse emission coefficient"
        V_early_reverse = 1 MV                "VAR: reverse Early voltage"
        I_knee_reverse = 1000000000 A         "IKR: reverse high-injection knee"
        I_leakage_base_collector = 0 A        "ISC: base–collector leakage saturation current"
        leakage_emission_base_collector = 2   "NC: its emission coefficient"
        R_base = 1 mOhm                       "RB: zero-bias base resistance"
        R_base_minimum = 0 Ohm                "RBM: the base resistance at high current; 0 means R_base"
        R_emitter = 1 mOhm                    "RE: emitter resistance"
        R_collector = 1 mOhm                  "RC: collector resistance"
        C_base_emitter = 0 F                  "CJE: base–emitter zero-bias capacitance"
        V_junction_base_emitter = 0.75 V      "VJE: its built-in potential"
        grading_base_emitter = 0.33           "MJE: its grading coefficient"
        C_base_collector = 0 F                "CJC: base–collector zero-bias capacitance"
        V_junction_base_collector = 0.75 V    "VJC: its built-in potential"
        grading_base_collector = 0.33         "MJC: its grading coefficient"
        internal_base_collector_fraction = 1  "XCJC: the share of CJC at the internal base; the rest is at the base pin"
        forward_bias_coefficient = 0.5        "FC: past FC·VJ a depletion capacitance goes on as a straight line"
        transit_time_forward = 0 s            "TF: ideal forward transit time — sets fT"
        transit_time_bias_dependence = 0      "XTF: how much TF grows with current"
        transit_time_bias_voltage = 1 MV      "VTF: the VBC that halves that growth"
        transit_time_current = 0 A            "ITF: the current at which TF's growth sets in"
        transit_time_reverse = 0 s            "TR: ideal reverse transit time — the storage time of a saturated switch"
        beta_temperature_exponent = 0         "XTB: how the gains follow the temperature"
        saturation_temperature_exponent = 3   "XTI: how the saturation current follows the temperature"
        E_gap = 1.11 V                        "EG: band gap, in volts"
        T_nominal = 300.15 K                  "TNOM: the temperature the figures above are measured at"
        V_breakdown = 1 kV                    "collector–emitter sustaining voltage: an inductive kick stops here"
        I_breakdown = 1 mA                    "avalanche current at V_breakdown"
        power_rating = 0.5 W                  "what it is rated for"
        thermal_resistance = 250 K/W          "kelvin above the bench per watt it takes"
        thermal_time_constant = 2 s           "how fast it warms to that"
        T_maximum = 150 °C                    "past this it fails on a realistic bench"
        V_collector_emitter_maximum = 1e6 V   "VCEO: the collector-emitter voltage it is rated for; none is a megavolt"
        I_collector_maximum = 1e6 A           "IC: the collector current it is rated for; none is a megaampere"
    }

    pins {
        emitter analog 1                      "emitter"
        base analog input 2                   "base"
        collector analog output 3             "collector"
    }

    nodes {
        bi                                    "the intrinsic base, behind the base resistance"
        ci                                    "the intrinsic collector, behind the collector resistance"
        ei                                    "the intrinsic emitter, behind the emitter resistance"
    }

    symbol uses npn-transistor-symbol

    display {
        overvoltage = 100 * abs(collector - emitter) / V_collector_emitter_maximum unit % "of VCEO"
        overcurrent = 100 * abs(collector.current) / I_collector_maximum unit % "of its rated IC"
    }

    state {
        heating = 0 continuous                "how far its own heat has raised it above the bench, kelvin; 0 on an ideal bench"
    }

    equations {
        let T_junction : temperature = temperature + heating
        let beta_now : ratio = beta_forward * (1 + tolerance_corner * beta_forward_spread)
        let V_be : voltage = polarity * (bi - ei)
        let V_bc : voltage = polarity * (bi - ci)
        let V_bx : voltage = polarity * (base - ci)
        let V_ce : voltage = polarity * (ci - ei)
        let warmth : ratio = T_junction / T_nominal
        let gain_drift : ratio = warmth ^ beta_temperature_exponent
        let I_saturation_now : current = junction_saturation(I_saturation, T_junction, T_nominal, saturation_temperature_exponent, 1, E_gap)
        let I_leakage_base_emitter_now : current = junction_saturation(I_leakage_base_emitter, T_junction, T_nominal, saturation_temperature_exponent, leakage_emission_base_emitter, E_gap) / gain_drift
        let I_leakage_base_collector_now : current = junction_saturation(I_leakage_base_collector, T_junction, T_nominal, saturation_temperature_exponent, leakage_emission_base_collector, E_gap) / gain_drift

        let forward : current = junction_current(V_be, I_saturation_now, emission_coefficient, T_junction)
        let reverse : current = junction_current(V_bc, I_saturation_now, emission_coefficient_reverse, T_junction)
        let leakage_emitter : current = junction_current(V_be, I_leakage_base_emitter_now, leakage_emission_base_emitter, T_junction)
        let leakage_collector : current = junction_current(V_bc, I_leakage_base_collector_now, leakage_emission_base_collector, T_junction)

        # The normalised base charge: the Early effect (q1) and high injection (q2)
        let early : ratio = 1 / (1 - V_bc / V_early - V_be / V_early_reverse)
        let injection : ratio = forward / I_knee + reverse / I_knee_reverse
        let base_charge : ratio = early * (1 + sqrt(soft_positive_part(1 + 4 * injection, 1e-9))) / 2
        let transport : current = (forward - reverse) / base_charge

        let transit_growth : ratio = transit_time_bias_dependence * exp(V_bc / (1.44 * transit_time_bias_voltage)) * if(transit_time_current > 0, (forward / (forward + transit_time_current)) ^ 2, 1)
        let Q_base_emitter : charge = depletion_charge(V_be, C_base_emitter, V_junction_base_emitter, grading_base_emitter, forward_bias_coefficient) + transit_time_forward * (1 + transit_growth) * forward / base_charge
        let Q_base_collector : charge = depletion_charge(V_bc, internal_base_collector_fraction * C_base_collector, V_junction_base_collector, grading_base_collector, forward_bias_coefficient) + transit_time_reverse * reverse
        let Q_base_external : charge = depletion_charge(V_bx, (1 - internal_base_collector_fraction) * C_base_collector, V_junction_base_collector, grading_base_collector, forward_bias_coefficient)

        let R_base_high : resistance = if(R_base_minimum > 0, R_base_minimum, R_base)
        let R_base_now : resistance = R_base_high + (R_base - R_base_high) / base_charge
        let avalanche : current = I_breakdown * limit_exponential((V_ce - V_breakdown) / thermal_voltage(T_junction))

        current base -> bi = (base - bi) / R_base_now
        current collector -> ci = (collector - ci) / R_collector
        current ei -> emitter = (ei - emitter) / R_emitter
        # Shot noise, 2qI, of the collector and the base currents: nothing to the solution, all of a noise analysis.
        current ci -> ei = polarity * (transport + avalanche) + noise(2 * 1.602176634e-19 * abs(transport))
        current bi -> ei = polarity * (forward / (beta_now * gain_drift) + leakage_emitter + d(Q_base_emitter)/dt) + noise(2 * 1.602176634e-19 * abs(forward / (beta_now * gain_drift) + leakage_emitter))
        current bi -> ci = polarity * (reverse / (beta_reverse * gain_drift) + leakage_collector + d(Q_base_collector)/dt)
        current base -> ci = polarity * d(Q_base_external)/dt

        # Its own heat, on a realistic bench: the power it dissipates, through thermal_resistance, over thermal_time_constant.
        d(heating)/dt = (realistic * ((collector - emitter) * (collector - ci) / R_collector + (base - emitter) * (base - bi) / R_base_now) * thermal_resistance - heating) / thermal_time_constant
    }
}
