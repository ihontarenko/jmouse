# A p-channel MOSFET at the level-1 model's neutral defaults: what an imported `.model … PMOS(…)` becomes, the model's
# numbers set on it. A datasheet p-channel part is a member of this family.

component "P-channel MOSFET" as p-mosfet type mosfet {
    meta {
        designator Q
        summary "P-channel MOSFET, the level-1 model at its defaults"
        category circuits
        failure short drain source
    }
    extends mos-transistor

    parameters {
        polarity = -1                         "p-channel"
        V_threshold = -1 V                    "VTO: an enhancement part opens when the gate is this far below the source"
        transconductance = 0.1 A/V^2          "KP: the whole channel"
    }

    symbol uses p-channel-mosfet-symbol

    expect "on: the gate 5 V below the source sources the load's current" from "KP 0.1 A/V², VTO -1 V: deep in the linear region" {
        bench for 1 ms {
            V1 voltage-source (Vdd, 0) U_output = 5 V
            R1 resistor (drain, 0) resistance = 100 Ohm
            U1 self (gate = 0, drain = drain, source = Vdd)
        }
        measure operating drain
        within 4.85 V .. 4.9 V
    }
}
