# An n-channel JFET at the level-1 model's defaults: what an imported `.model … NJF(…)` is meant to become. A datasheet
# n-channel part is a member of this family.

component "N-channel JFET" as n-jfet type jfet {
    meta {
        designator J
        summary "N-channel JFET, the level-1 model at its defaults"
        category circuits
        failure open
    }
    extends junction-field-effect-transistor

    parameters {
        polarity = 1                          "n-channel"
    }

    symbol uses n-channel-jfet-symbol
}
