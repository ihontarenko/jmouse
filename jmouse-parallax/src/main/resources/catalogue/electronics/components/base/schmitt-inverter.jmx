# The Schmitt-trigger inverter every such part is a member of. Its input is read against two thresholds, not one: the
# output falls once the input rises past the upper and rises again only once it falls below the lower. Between them it
# keeps what it was — the hysteresis that turns a slow or noisy edge into one clean one. The input is analog, since the
# thresholds are the whole of the part; the output stage follows its latch with a finite edge and an output resistance.

component "Schmitt-trigger inverter" as schmitt-inverter type gate {
    meta {
        designator U
        summary "An inverter with two input thresholds: a slow or noisy edge switches it once"
        source "behavioural: two thresholds as shares of the supply, a latch between them"
        category circuits
        failure short Vcc GND
    }

    parameters {
        upper_share = 0.6                     "the rising threshold as a share of the supply"
        lower_share = 0.4                     "the falling threshold as a share of the supply"
        edge = 10 ns                          "output transition time"
        R_output = 50 Ohm                     "output resistance"
        R_input = 1 GOhm                      "input leakage"
    }

    pins {
        a analog input 2                      "input A"
        GND ground 3
        output analog output 4                "output Y"
        Vcc power 5
    }

    symbol uses schmitt-not-gate-symbol

    state {
        high = 1 discrete                     "the output's level: written by the behaviour, read by the equations"
        shown = 1 continuous                  "the output stage following it with a finite edge"
    }

    equations {
        current a -> GND = (a - GND) / R_input
        d(shown)/dt = (high - shown) / edge
        current Vcc -> output = (GND + shown * (Vcc - GND) - output) / R_output
    }

    behaviour {
        on start do
            if (a - GND) > upper_share * (Vcc - GND) then
                high = 0
            end
        end

        on above 'a - GND - upper_share * (Vcc - GND)' do
            high = 0
        end

        on below 'a - GND - lower_share * (Vcc - GND)' do
            high = 1
        end
    }
}
