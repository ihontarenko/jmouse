# Two resistances that share a wiper: moving it changes both while the circuit runs.
component "Potentiometer" as potentiometer type potentiometer {
    meta {
        designator RV
        summary "A resistance with a wiper, moved while the circuit runs"
        category circuits
        failure open
    }

    parameters {
        position = 0.5 in 0 .. 1 step 0.01 live "Wiper position"
        resistance = 10 kOhm    "end-to-end resistance"
        R_wiper = 1 Ohm         "wiper contact resistance"
        # How it warms and where it gives up (a carbon-track trimmer, 0.5 W at 70 °C).
        power_rating = 0.5 W                "what it is rated for"
        thermal_resistance = 100 K/W       "kelvin above the bench per watt it takes"
        thermal_time_constant = 20 s      "how fast it warms to that"
        T_maximum = 125 °C               "past this it fails on a realistic bench"
    }

    pins {
        a analog 1  "first end"
        w analog 2  "wiper"
        b analog 3  "second end"
    }

    symbol uses potentiometer-symbol {
        failed = failed
        position = position
    }

    equations {
        current a -> w = (a - w) / (position * resistance + R_wiper)
        current w -> b = (w - b) / ((1 - position) * resistance + R_wiper)
    }
}
