# An aluminium electrolytic capacitor as it really is: the capacitance behind an equivalent series resistance — the
# ESR that heats it under ripple and makes a step jump before the charge moves — with a leakage current across it.
# Not represented: the series inductance (ESL, a few nanohenries), the capacitance's fall with frequency and
# temperature, and what a reversed electrolytic does.

component "Electrolytic capacitor" as electrolytic-capacitor type capacitor {
    meta {
        designator C
        summary "Aluminium electrolytic capacitor: capacitance, ESR, leakage"
        source "the equivalent circuit an electrolytic's datasheet tabulates: C, ESR at 100 kHz, leakage current"
        category circuits
        failure short
    }

    parameters {
        capacitance = 1000 uF                 "capacitance"
        R_equivalent_series = 0.1 Ohm         "ESR"
        R_leakage = 1 MOhm                    "leakage: the datasheet's I = 0.01 · C · V, as a resistance"
        ESR_doubling = 20 K                   "the ESR doubles for every this many kelvin colder: an electrolyte thickens in the cold"
        T_nominal = 298.15 K                  "the temperature the ESR is given at"
        power_rating = 0.5 W                  "what the ripple may heat it with"
        thermal_resistance = 40 K/W           "kelvin above the bench per watt it takes"
        thermal_time_constant = 60 s          "how fast it warms to that"
        T_maximum = 105 °C                    "past this it fails on a realistic bench"
        voltage_rating = 25 V                 "the rated voltage"
    }

    pins {
        positive analog 1                     "positive, the longer lead"
        negative analog 2                     "negative, the striped side"
    }

    nodes {
        plate                                 "the capacitance, behind the ESR"
    }

    symbol uses polarized-capacitor-symbol {
        a positive
        b negative
    }

    # Beside it on the sheet: how near its rating it is, and the two things a bench's temperature moves — its ESR, read
    # exactly as the equations below read it, and the temperature of its body (the bench plus its own heat).
    display {
        overvoltage = 100 * abs(positive - negative) / voltage_rating unit % "of its rated voltage"
        ESR = R_equivalent_series * 2 ^ ((T_nominal - temperature - heating) / ESR_doubling) unit Ω "at its temperature"
        body = temperature + heating - 273.15 unit °C "the bench and its own heat"
    }

    state {
        heating = 0 continuous                "how far its own heat has raised it above the bench, kelvin; 0 on an ideal bench"
    }

    equations {
        let T_body : temperature = temperature + heating
        let R_series_now : resistance = R_equivalent_series * 2 ^ ((T_nominal - T_body) / ESR_doubling)
        current positive -> plate = (positive - plate) / R_series_now
        current plate -> negative = d(capacitance * (plate - negative))/dt + (plate - negative) / R_leakage

        # Its own heat, on a realistic bench: the power it dissipates, through thermal_resistance, over thermal_time_constant.
        d(heating)/dt = (realistic * ((positive - plate) ^ 2 / R_series_now) * thermal_resistance - heating) / thermal_time_constant
    }

    expect "a step jumps by its ESR share before the charge moves" from "ESR 0.1 Ω behind 1 Ω: 1 V × 0.1 / 1.1 at once" {
        bench for 10 us {
            V1 voltage-source (input, 0) waveform = step, U_output = 1 V
            R1 resistor (input, positive) resistance = 1 Ohm
            U1 self (positive = positive, negative = 0)
        }
        measure final positive
        within 0.08 V .. 0.12 V
    }

    expect "in the cold the ESR grows, and the step's jump with it" from "at −40 °C the ESR is 0.1 Ω × 2^(65/20) ≈ 0.95 Ω: 1 V × 0.95 / 1.95 at once" {
        bench for 10 us at -40 °C {
            V1 voltage-source (input, 0) waveform = step, U_output = 1 V
            R1 resistor (input, positive) resistance = 1 Ohm
            U1 self (positive = positive, negative = 0)
        }
        measure final positive
        within 0.45 V .. 0.52 V
    }
}
