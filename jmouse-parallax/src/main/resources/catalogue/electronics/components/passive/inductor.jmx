component "Inductor" as inductor type inductor {
    meta {
        designator L
        summary "Two-terminal inductor"
        category circuits
    }
    parameters {
        inductance = 1 mH "inductance"
    }
    pins {
        terminal_one analog 1 "first terminal"
        terminal_two analog 2 "second terminal"
    }
    symbol uses inductor-symbol {
        a terminal_one
        b terminal_two
    }
}
