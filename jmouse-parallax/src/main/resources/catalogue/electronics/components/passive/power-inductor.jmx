# A power inductor as it really is: a winding resistance (DCR) and a core that saturates. The flux it links is
# L_air · I + (L − L_air) · I_saturation · tanh(I / I_saturation) — an inductance of L at small currents that falls,
# past the saturation current, to the winding's own air-core inductance, so the current of a converter that runs past
# it rises steeply and the DCR and that small L_air are what still hold it. The floor is physics, not a convenience:
# without it the incremental inductance went to L · sech²(I / I_sat), 10⁻²² of L at 50 A, the equation stopped being
# a differential one, and no step a solver could take settled the circuit.
# Not represented: core losses, hysteresis, the winding's capacitance.

component "Power inductor" as power-inductor type inductor {
    meta {
        designator L
        summary "Power inductor: inductance, winding resistance, core saturation"
        source "the figures a power inductor's datasheet gives: L, DCR, ISAT"
        category circuits
        failure open
    }

    parameters {
        inductance = 100 uH                   "inductance at small currents"
        I_saturation = 2 A                    "ISAT: past it the core saturates and the inductance falls away"
        saturated_inductance = 5 uH           "what is left once the core is saturated: the winding's air-core inductance. An approximation — a datasheet gives ISAT as a 30 % drop, not this floor"
        R_winding = 50 mOhm                   "DCR: the winding's resistance"
        copper_temperature_coefficient = 0.00393 "copper: the winding's resistance rises 0.393 % per kelvin"
        saturation_temperature_coefficient = -0.004 "a ferrite core saturates earlier when hot, about 0.4 % per kelvin"
        T_nominal = 298.15 K                  "the temperature the figures are given at"
        power_rating = 1 W                    "what it is rated for"
        thermal_resistance = 50 K/W           "kelvin above the bench per watt it takes"
        thermal_time_constant = 30 s          "how fast it warms to that"
        T_maximum = 125 °C                    "past this it fails on a realistic bench"
    }

    pins {
        terminal_one analog 1                 "first terminal"
        terminal_two analog 2                 "second terminal"
    }

    nodes {
        winding_current                       "a node whose voltage above terminal_two is the winding's current, one volt per ampere"
    }

    symbol uses inductor-symbol {
        a terminal_one
        b terminal_two
    }

    state {
        heating = 0 continuous                "how far its own heat has raised it above the bench, kelvin; 0 on an ideal bench"
    }

    equations {
        let T_winding : temperature = temperature + heating
        let R_winding_now : resistance = R_winding * (1 + copper_temperature_coefficient * (T_winding - T_nominal))
        let I_saturation_now : current = I_saturation * (1 + saturation_temperature_coefficient * (T_winding - T_nominal))
        # The flux is a charge the equations differentiate, and a charge reads voltages, not currents: the current is
        # carried as a voltage on a node of its own.
        let R_carrier : resistance = 1
        let I_winding : current = (winding_current - terminal_two) / R_carrier
        voltage winding_current -> terminal_two = R_carrier * terminal_one.current
        voltage terminal_one -> terminal_two = R_winding_now * terminal_one.current + d(saturated_inductance * I_winding + (inductance - saturated_inductance) * I_saturation_now * tanh(I_winding / I_saturation_now))/dt

        # Its own heat, on a realistic bench: the power it dissipates, through thermal_resistance, over thermal_time_constant.
        d(heating)/dt = (realistic * (R_winding_now * I_winding ^ 2) * thermal_resistance - heating) / thermal_time_constant
    }

    expect "a ramp of V / L below saturation" from "1 V across 100 µH: 0.5 A after 50 µs" {
        bench for 50 us {
            V1 voltage-source (feed, 0) waveform = step, U_output = 1 V
            U1 self (terminal_one = feed, terminal_two = 0)
        }
        measure final current V1
        within -0.55 A .. -0.45 A
    }

    expect "the core saturates past ISAT" from "the same 1 V after 250 µs: a linear inductor would carry 2.5 A" {
        bench for 250 us {
            V1 voltage-source (feed, 0) waveform = step, U_output = 1 V
            U1 self (terminal_one = feed, terminal_two = 0)
        }
        measure final current V1
        within -21 A .. -4 A
    }
}
