# Two coupled windings — what SPICE writes as two inductors and a K line. Each winding's voltage is its resistance's
# drop plus the rate of the flux it links: its own inductance times its current, and the mutual inductance
# M = k · √(L1 · L2) times the other winding's. The turns ratio is √(L1 / L2); a coupling below 1 is the leakage
# inductance a real core has. The `_one` pins are the dotted ends: a current into both makes flux the same way.
# Not represented: the core's saturation and hysteresis, its losses, the windings' capacitance.

component "Transformer" as transformer type transformer {
    meta {
        designator T
        summary "Two coupled windings: self and mutual inductance, leakage, winding resistance"
        source "coupled inductors as in Berkeley SPICE3 / ngspice 47 (L, L, K)"
        category circuits
        failure open
    }

    parameters {
        L_primary = 10 H                      "primary inductance: the magnetising inductance seen from the primary"
        L_secondary = 0.1 H                   "secondary inductance: turns ratio √(L1 / L2) = 10"
        coupling = 0.999                      "K: 1 is a perfect core; below it, leakage"
        R_primary = 10 Ohm                    "primary winding resistance"
        R_secondary = 0.1 Ohm                 "secondary winding resistance"
        copper_temperature_coefficient = 0.00393 "copper: the windings' resistance rises 0.393 % per kelvin"
        T_nominal = 298.15 K                  "the temperature the resistances are given at"
        power_rating = 10 W                   "what it is rated for"
        thermal_resistance = 10 K/W           "kelvin above the bench per watt it takes"
        thermal_time_constant = 300 s         "how fast it warms to that"
        T_maximum = 120 °C                    "past this it fails on a realistic bench"
    }

    pins {
        primary_one analog 1                  "primary, dotted end"
        primary_two analog 2                  "primary"
        secondary_one analog 3                "secondary, dotted end"
        secondary_two analog 4                "secondary"
    }

    nodes {
        primary_current                       "a node whose voltage above primary_two is the primary current, one volt per ampere"
        secondary_current                     "the same for the secondary"
    }

    symbol uses transformer-symbol

    equations {
        # temperature is the part's own: the bench's, and on a realistic bench raised by its own heat, which the engine keeps
        let T_winding : temperature = temperature
        let R_primary_now : resistance = R_primary * (1 + copper_temperature_coefficient * (T_winding - T_nominal))
        let R_secondary_now : resistance = R_secondary * (1 + copper_temperature_coefficient * (T_winding - T_nominal))
        # A flux is a charge the equations differentiate, and a charge reads voltages, not currents: each winding's
        # current is carried as a voltage on a node of its own.
        let M : inductance = coupling * sqrt(L_primary * L_secondary)
        let R_carrier : resistance = 1
        let I_primary : current = (primary_current - primary_two) / R_carrier
        let I_secondary : current = (secondary_current - secondary_two) / R_carrier
        voltage primary_current -> primary_two = R_carrier * primary_one.current
        voltage secondary_current -> secondary_two = R_carrier * secondary_one.current
        voltage primary_one -> primary_two = R_primary_now * primary_one.current + d(L_primary * I_primary + M * I_secondary)/dt
        voltage secondary_one -> secondary_two = R_secondary_now * secondary_one.current + d(L_secondary * I_secondary + M * I_primary)/dt
    }

    expect "ten to one on a loaded secondary" from "turns ratio √(L1 / L2) = 10: 100 V peak in, about 10 V peak out into 100 Ω" {
        bench for 60 ms {
            V1 sine-generator (positive = input, negative = 0) amplitude = 100 V, frequency = 50 Hz
            U1 self (primary_one = input, primary_two = 0, secondary_one = output, secondary_two = 0)
            R1 resistor (output, 0) resistance = 100 Ohm
        }
        measure maximum output after 40 ms
        within 9 V .. 10.2 V
    }
}
