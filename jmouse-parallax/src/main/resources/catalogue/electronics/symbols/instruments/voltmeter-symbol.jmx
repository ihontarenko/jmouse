symbol "Voltmeter" as voltmeter-symbol {
    meta {
        summary "Voltmeter, as drawn on a schematic: a dial marked V"
        category circuits
        tags electronics, schematic, instrument
    }
    size 80 x 40
    path "M-40 0H-18M18 0H40M-18 0A18 18 0 1 0 18 0A18 18 0 1 0 -18 0"
    path "M-7 -8L0 8L7 -8" upright
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -28
    label value at 0, 32
}
