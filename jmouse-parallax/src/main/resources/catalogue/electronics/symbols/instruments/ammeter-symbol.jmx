symbol "Ammeter" as ammeter-symbol {
    meta {
        summary "Ammeter, as drawn on a schematic: a dial marked A"
        category circuits
        tags electronics, schematic, instrument
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    path "M-40 0H-18M18 0H40M-18 0A18 18 0 1 0 18 0A18 18 0 1 0 -18 0"
    path "M-7 8L0 -8L7 8M-4 2H4" upright
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -28
    label value at 0, 32
}
