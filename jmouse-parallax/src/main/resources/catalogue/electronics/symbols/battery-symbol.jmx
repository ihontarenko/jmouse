symbol "Battery" as battery-symbol {
    meta {
        summary "Battery, as drawn on a schematic"
        category circuits
        tags electronics, schematic
    }
    size 80 x 40
    path "M-40 0H-9M-9-15V15M-2-8V8M5-15V15M12-8V8M12 0H40"
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
