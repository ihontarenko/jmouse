symbol "LED bar" as led-bar-symbol {
    meta {
        summary "Eight LEDs in a row, cathodes common: each segment lights red as its own current flows"
        category circuits
        tags electronics, schematic, display
        license "CERN-OHL-W-2.0"
    }
    size 180 x 120
    input light_0 0 .. 100
    input light_1 0 .. 100
    input light_2 0 .. 100
    input light_3 0 .. 100
    input light_4 0 .. 100
    input light_5 0 .. 100
    input light_6 0 .. 100
    input light_7 0 .. 100

    path "M-90-40H70V40H-90Z"
    path "M-80 26V32H60V26M-20 32V60"
    path "M-80-40V-60"
    path "M-60-40V-60"
    path "M-40-40V-60"
    path "M-20-40V-60"
    path "M0-40V-60"
    path "M20-40V-60"
    path "M40-40V-60"
    path "M60-40V-60"
    live path glow_0 "M-86-30H-74V20H-86Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_0, 0, 100))
        live glow = 6 * share(light_0, 0, 100)
    }
    live path glow_1 "M-66-30H-54V20H-66Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_1, 0, 100))
        live glow = 6 * share(light_1, 0, 100)
    }
    live path glow_2 "M-46-30H-34V20H-46Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_2, 0, 100))
        live glow = 6 * share(light_2, 0, 100)
    }
    live path glow_3 "M-26-30H-14V20H-26Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_3, 0, 100))
        live glow = 6 * share(light_3, 0, 100)
    }
    live path glow_4 "M-6-30H6V20H-6Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_4, 0, 100))
        live glow = 6 * share(light_4, 0, 100)
    }
    live path glow_5 "M14-30H26V20H14Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_5, 0, 100))
        live glow = 6 * share(light_5, 0, 100)
    }
    live path glow_6 "M34-30H46V20H34Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_6, 0, 100))
        live glow = 6 * share(light_6, 0, 100)
    }
    live path glow_7 "M54-30H66V20H54Z" {
        fill = red
        live opacity = 0.12 + 0.88 * seen(share(light_7, 0, 100))
        live glow = 6 * share(light_7, 0, 100)
    }

    pin anode_0 at -80, -60
    pin anode_1 at -60, -60
    pin anode_2 at -40, -60
    pin anode_3 at -20, -60
    pin anode_4 at 0, -60
    pin anode_5 at 20, -60
    pin anode_6 at 40, -60
    pin anode_7 at 60, -60
    pin cathode at -20, 60
    label name at 100, -30
    label value at 100, 30
}
