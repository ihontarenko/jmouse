symbol "Photodiode" as photodiode-symbol {
    meta {
        summary "Photodiode, as drawn on a schematic: a diode with light falling on it; the arrows light up with the light it takes"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input forward 0 .. 1
    input reverse 0 .. 1
    input light 0 .. 1
    input failed
    live path die "M-12-12L12 0-12 12Z" {
        stroke = clear
        fill = positive
        live opacity = seen(forward)
        live glow = 9 * seen(forward)
    }
    live group body {
        path "M-40 0H-12V-12L12 0-12 12V0M12-12V12M12 0H40"
        live stroke = if(failed > 0.5, burned, signal)
    }
    live path light_in "M-4-30L4-22M4-26V-22H0M8-30L16-22M16-26V-22H12" {
        live stroke = if(light > 0.02, warm, signal)
        live glow = 5 * light
    }
    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
