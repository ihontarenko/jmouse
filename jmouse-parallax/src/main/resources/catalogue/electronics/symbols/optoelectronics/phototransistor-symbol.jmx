symbol "Phototransistor" as phototransistor-symbol {
    meta {
        summary "NPN phototransistor, as drawn on a schematic: light falling on its base does what a base current would"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 80
    input conduction
    input light 0 .. 1
    input failed
    live group body {
        path "M-10-14V14M-10-6L20-20V-40M-10 6L20 20V40M6.18 17.41L14 17.2L9.14 11.07"
        live stroke = if(failed > 0.5, burned, signal)
    }
    live path channel "M20-40V-20L-10-6M-10 6L20 20V40" {
        stroke = positive
        live opacity = smooth(conduction, 80 ms)
        live glow = 6 * conduction
    }
    live path light_in "M-38-18L-22-6M-26-6H-22V-10M-38-2L-22 10M-26 10H-22V6" {
        live stroke = if(light > 0.02, warm, signal)
        live glow = 5 * light
    }
    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin collector at 20, -40
    pin emitter at 20, 40
    label name at 32, -8
    label value at 32, 8
}
