symbol "Pin header, 2 x 2" as pin-header-2x2-symbol {
    meta {
        summary "A two-row pin header of 4, as drawn on a schematic: odd contacts on the left, even on the right, numbered as on the board"
        category circuits
        tags electronics, schematic, connector
        license "CERN-OHL-W-2.0"
    }
    # Generated from symbol-standards/connector-symbols.sht; regenerate, never edit.
    size 120 x 100
    path "M-20 -10H20V50H-20ZM-60 0H-20M20 0H60M-60 40H-20M20 40H60"
    pin pin1 at -60, 0 "1"
    pin pin2 at 60, 0 "2"
    pin pin3 at -60, 40 "3"
    pin pin4 at 60, 40 "4"
    label name at 0, -24
    label value at 0, 68
}
