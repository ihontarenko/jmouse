symbol "Motor" as motor-symbol {
    meta {
        summary "Motor, as drawn on a schematic"
        category circuits
        tags electronics, schematic
    }
    size 80 x 40
    path "M-40 0H-16M16 0H40M-16 0A16 16 0 1 0 16 0A16 16 0 1 0-16 0M-8 8V-8L0 2 8-8V8"
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
