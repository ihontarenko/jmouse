symbol "Relay with two normally-open contacts" as two-contact-relay-symbol {
    meta {
        summary "A relay with two make contacts, as drawn on a schematic: its coil, and two contacts on one armature that close together while the coil holds them"
        category circuits
        tags electronics, schematic
    }
    # Pins where KiCad's RTE4 relay has them (2.54 mm = 40): the coil on the left, each contact's common below and its
    # make side above — so a KiCad design's wires land. The drawing is ours.
    size 400 x 240
    input energized
    input failed

    live group body {
        path "M-180-120V-40M-180 40V120M-200-40H-160V40H-200ZM-200 40L-160-40"
        path "M-20 120V20M20-120V-20M14-20H26"
        path "M140 120V20M180-120V-20M174-20H186"
        path "M-23 20A3 3 0 1 0 -17 20A3 3 0 1 0 -23 20M137 20A3 3 0 1 0 143 20A3 3 0 1 0 137 20"
        live stroke = if(failed > 0.5, burned, signal)
    }

    # The armature's link: dashes from the coil to both contacts — they move as one.
    path "M-156 0H-140M-130 0H-114M-104 0H-88M-78 0H-62M-52 0H-36M-26 0H-10M2 0H18M28 0H44M54 0H70M80 0H96M106 0H122M132 0H148"

    live group first_blade pivot -20, 20 {
        path "M-20 20L-1-33"
        live rotate = between(0 deg, 25 deg, smooth(energized, 40 ms))
        live stroke = if(failed > 0.5, burned, if(energized > 0.5, positive, signal))
    }

    live group second_blade pivot 140, 20 {
        path "M140 20L159-33"
        live rotate = between(0 deg, 25 deg, smooth(energized, 40 ms))
        live stroke = if(failed > 0.5, burned, if(energized > 0.5, positive, signal))
    }

    live when failed > 0.5 {
        path scorch "M-187-9L-183-3M-174-8L-178-2M-186 8L-182 3M-173 9L-177 3"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin coil_one at -180, -120
    pin coil_two at -180, 120
    pin first_common at -20, 120
    pin first_normally_open at 20, -120
    pin second_common at 140, 120
    pin second_normally_open at 180, -120
    label name at -120, -60
    label value at -120, 64
}
