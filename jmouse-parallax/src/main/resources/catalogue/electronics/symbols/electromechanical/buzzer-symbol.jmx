symbol "Buzzer" as buzzer-symbol {
    meta {
        summary "A buzzer, as drawn on a schematic: a sounder's dome on its body, its leads in from one side — waves leave the dome while it sounds"
        category circuits
        tags electronics, schematic
    }
    # Both leads in from the left, 2.54 mm apart, as a sounder is usually wired: the positive one above.
    size 80 x 80
    input sounding 0 .. 1
    input failed

    live group body {
        path "M-24-20H0V20H-24Z"
        path "M0-20A20 20 0 0 1 0 20"
        path "M-40-40H-12V-20M-40 40H-12V20"
        path "M-34-50H-26M-30-54V-46"
        live stroke = if(failed > 0.5, burned, signal)
    }

    # Sounding, two arcs ripple out from the dome, as loud as it is driven.
    live group sound {
        path "M28-14A20 20 0 0 1 28 14M36-22A30 30 0 0 1 36 22"
        stroke = positive
        animate opacity = seen(sounding) * (0.4 + 0.6 * blink(4 Hz))
    }

    live when failed > 0.5 {
        path scorch "M-17-9L-13-3M-4-8L-8-2M-16 8L-12 3M-3 9L-7 3"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin positive at -40, -40
    pin negative at -40, 40
    label name at 48, -12
    label value at 48, 12
}
