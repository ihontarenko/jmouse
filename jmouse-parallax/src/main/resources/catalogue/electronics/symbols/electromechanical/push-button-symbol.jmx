symbol "Push button" as push-button-symbol {
    meta {
        summary "Push button, as drawn on a schematic: its bar rests above the contacts and comes down onto them while it is held"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input closed

    path "M-40 0H-13M13 0H40"
    path "M-15 0A2 2 0 1 0-11 0A2 2 0 1 0-15 0M11 0A2 2 0 1 0 15 0A2 2 0 1 0 11 0"

    # The bar, its stem and its cap move together: up while released, down onto the contacts while held.
    live group plunger {
        path "M-15-10H15M0-10V-18M-6-18H6"
        live move = 0, between(0, 7, smooth(closed, 40 ms))
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -28
    label value at 0, 20
}
