symbol "Jumper" as jumper-symbol {
    meta {
        summary "Open jumper, as drawn on a schematic: two contacts and the cap that would bridge them, lifted off"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input closed

    path "M-40 0H-12M12 0H40"
    path "M-14 0A2 2 0 1 0-10 0A2 2 0 1 0-14 0M10 0A2 2 0 1 0 14 0A2 2 0 1 0 10 0"

    # The cap: lifted while the jumper is open, down on both contacts once it is closed.
    live path cap "M-12-4A12 12 0 0 1 12-4" {
        live move = 0, between(-6, 0, smooth(closed, 60 ms))
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
