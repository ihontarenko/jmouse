symbol "Reed switch" as reed-switch-symbol {
    meta {
        summary "Reed switch, as drawn on a schematic: a switch sealed in glass, closed while a magnet is near"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input closed

    path "M-40 0H-13M13 0H40"
    path "M-15 0A2 2 0 1 0-11 0A2 2 0 1 0-15 0M11 0A2 2 0 1 0 15 0A2 2 0 1 0 11 0"
    # The glass envelope around the reeds.
    path "M-20-12H20A8 8 0 0 1 20 12H-20A8 8 0 0 1-20-12Z"

    live group lever pivot -13, 0 {
        path "M-13 0H13"
        live rotate = between(-24 deg, 0 deg, smooth(closed, 60 ms))
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
