symbol "Jumper, bridged" as bridged-jumper-symbol {
    meta {
        summary "A jumper closed by its bridge, as drawn on a schematic: two pads and the solder or link that joins them — a connection that can be cut"
        category circuits
        tags electronics, schematic
    }
    size 80 x 40
    input failed

    live group body {
        path "M-40 0H-18M18 0H40"
        path "M-18-8H-4V8H-18ZM4-8H18V8H4Z"
        live stroke = if(failed > 0.5, burned, signal)
    }

    # The bridge across the gap, filled: what makes it a closed jumper rather than an open one.
    live path bridge "M-6-3H6V3H-6Z" {
        fill = signal
        live stroke = if(failed > 0.5, burned, signal)
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -22
    label value at 0, 28
}
