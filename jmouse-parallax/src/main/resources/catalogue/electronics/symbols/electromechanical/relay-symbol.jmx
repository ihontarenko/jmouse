symbol "Relay" as relay-symbol {
    meta {
        summary "A relay, as drawn on a schematic: its coil, and a changeover contact that leaves normally-closed for normally-open while the coil holds it"
        category circuits
        tags electronics, schematic
    }
    size 100 x 80
    input energized

    path "M-50-30H-30V-14M-50 30H-30V14M-38-14H-22V14H-38ZM-38 14L-22-14M-18 3H-13M-9 3H-4M0 3H5M9 3H14M10 40V20M50-30H31V-14M50 10H36V-2M8 20A2 2 0 1 0 12 20A2 2 0 1 0 8 20"

    live group armature pivot 10, 20 {
        path "M10 20L28-14"
        live rotate = between(0 deg, 22 deg, smooth(energized, 40 ms))
    }

    pin coil_one at -50, -30
    pin coil_two at -50, 30
    pin common at 10, 40
    pin normally_closed at 50, -30
    pin normally_open at 50, 10
    label name at 0, -46
    label value at 0, 52
}
