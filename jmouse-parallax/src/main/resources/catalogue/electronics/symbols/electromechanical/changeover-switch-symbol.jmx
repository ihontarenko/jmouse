symbol "Changeover switch" as changeover-switch-symbol {
    meta {
        summary "Changeover switch, as drawn on a schematic: its lever lies on the upper contact while it is thrown, on the lower one otherwise"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 80
    input thrown

    path "M-40 0H-13M13-20H40M13 20H40"
    path "M-15 0A2 2 0 1 0-11 0A2 2 0 1 0-15 0M13-22A2 2 0 1 0 13-18A2 2 0 1 0 13-22M13 18A2 2 0 1 0 13 22A2 2 0 1 0 13 18"

    live group lever pivot -13, 0 {
        path "M-13 0L12 17"
        live rotate = between(0 deg, -68 deg, smooth(thrown, 60 ms))
    }

    pin common at -40, 0
    pin upper at 40, -20
    pin lower at 40, 20
    label name at 0, -36
    label value at 0, 40
}
