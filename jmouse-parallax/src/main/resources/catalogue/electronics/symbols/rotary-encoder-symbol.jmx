symbol "Rotary encoder with switch" as rotary-encoder-symbol {
    meta {
        summary "An incremental rotary encoder with a push switch, as drawn on a schematic: its two phases and common on the left, the switch on the right"
        category circuits
        tags electronics, schematic
    }
    size 80 x 80
    path "M-20-30H20V30H-20ZM-40-20H-20M-40 0H-20M-40 20H-20M20-20H40M20 20H40M-10 0A10 10 0 1 0 10 0A10 10 0 1 0-10 0ZM0-10V-4"
    pin phase_a at -40, -20 "A"
    pin common at -40, 0 "C"
    pin phase_b at -40, 20 "B"
    pin switch_one at 40, -20 "S1"
    pin switch_two at 40, 20 "S2"
    label name at 0, -44
    label value at 0, 48
}
