symbol "Low-dropout regulator with set and good pins" as low-dropout-regulator-symbol {
    meta {
        summary "A resistor-set low-dropout regulator, as drawn on a schematic: input, enable and the good-threshold on the left, the output, its sense and the good flag on the right, the set, the limit and ground below"
        category circuits
        tags electronics, schematic
    }
    size 160 x 160
    input failed

    live group body {
        path "M-60-40H60V40H-60Z"
        path "M-80-20H-60M-80 0H-60M-80 20H-60M60-20H80M60 0H80M60 20H80M-20 40V60M0 40V60M20 40V60"
        live stroke = if(failed > 0.5, burned, signal)
    }

    pin input at -80, -20 "IN"
    pin enable at -80, 0 "EN/UV"
    pin power_good_feedback at -80, 20 "PGFB"
    pin output at 80, -20 "OUT"
    pin output_sense at 80, 0 "OUTS"
    pin power_good at 80, 20 "PG"
    pin set at -20, 60 "SET"
    pin current_limit at 0, 60 "ILIM"
    pin GND at 20, 60 "GND"
    label name at 0, -54
    label value at 0, 74
}
