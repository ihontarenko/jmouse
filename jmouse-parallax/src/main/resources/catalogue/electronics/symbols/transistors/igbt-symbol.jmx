symbol "IGBT" as igbt-symbol {
    meta {
        summary "N-channel insulated-gate bipolar transistor, as drawn on a schematic: a MOSFET's insulated gate driving a bipolar collector and emitter"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 80
    input conduction
    input failed
    live group body {
        path "M-40 0H-12M-12-13V13M-6-13V13M-6-6L20-20V-40M-6 6L20 20V40M6.18 17.41L14 17.2L9.14 11.07"
        live stroke = if(failed > 0.5, burned, signal)
    }
    live path channel "M20-40V-20L-6-6V6L20 20V40" {
        stroke = positive
        live opacity = smooth(conduction, 80 ms)
        live glow = 6 * conduction
    }
    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin gate at -40, 0
    pin collector at 20, -40
    pin emitter at 20, 40
    label name at 32, -8
    label value at 32, 8
}
