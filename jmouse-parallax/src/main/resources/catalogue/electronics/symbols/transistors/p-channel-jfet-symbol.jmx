symbol "P-channel JFET" as p-channel-jfet-symbol {
    meta {
        summary "P-channel JFET, as drawn on a schematic: the source at the top, the gate's arrow pointing out of the channel"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 80
    input conduction
    input failed

    live group body {
        path "M-40 10H-5M-5-15V15M-5-10H20V-40M-5 10H20V40M-13 10L-21 6M-13 10L-21 14"
        live stroke = if(failed > 0.5, burned, signal)
    }

    live path channel "M20-40V-10H-5M-5-15V15M-5 10H20V40" {
        stroke = positive
        live opacity = smooth(conduction, 80 ms)
        live glow = 6 * conduction
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin gate at -40, 10
    pin source at 20, -40
    pin drain at 20, 40
    label name at 32, -8
    label value at 32, 8
}
