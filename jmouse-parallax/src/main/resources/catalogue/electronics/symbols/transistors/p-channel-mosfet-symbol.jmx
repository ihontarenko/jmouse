symbol "P-channel MOSFET" as p-channel-mosfet-symbol {
    meta {
        summary "P-channel MOSFET, as drawn on a schematic: the source at the top, the arrow pointing out of the channel"
        category circuits
        tags electronics, schematic
    }
    size 80 x 80
    input conduction
    input failed

    live group body {
        path "M-40 0H-10M-10-13V13M-5-13V-7M-5-3V3M-5 7V13M-5-10H20V-40M-5 10H20V40M20-10V0H-4M-1-4L3 0-1 4"
        live stroke = if(failed > 0.5, burned, signal)
    }

    live path channel "M20-40V-10H-5M-5-13V13M-5 10H20V40" {
        stroke = positive
        live opacity = smooth(conduction, 80 ms)
        live glow = 6 * conduction
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin gate at -40, 0
    pin source at 20, -40
    pin drain at 20, 40
    label name at 32, -8
    label value at 32, 8
}
