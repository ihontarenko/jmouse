symbol "Triac" as triac-symbol {
    meta {
        summary "Triac, as drawn on a schematic: two thyristors back to back with one gate"
        category circuits
        tags electronics, schematic
    }
    size 80 x 60
    input conduction
    input failed

    live group body {
        path "M-40 0H-10M-10-14V14M10-14V14M10 0H40M-10-12L10-4-10 4M10 12L-10 4 10-4M10 8L20 20V30"
        live stroke = if(failed > 0.5, burned, signal)
    }

    live path channel "M-40 0H-10M-10-12L10-4-10 4M10 12L-10 4 10-4M10 0H40" {
        stroke = positive
        live opacity = smooth(conduction, 40 ms)
        live glow = 6 * conduction
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin a at -40, 0
    pin b at 40, 0
    pin gate at 20, 30
    label name at 0, -20
    label value at 0, 40
}
