symbol "Current-sense amplifier" as current-sense-amplifier-symbol {
    meta {
        summary "A current-sense amplifier, as drawn on a schematic: the shunt's two inputs and the two references on the left, the output on the right, the supply above and ground below"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 120 x 160
    input failed

    live group body {
        path "M-40-60H40V60H-40Z"
        path "M-60-40H-40M-60-20H-40M-60 20H-40M-60 40H-40M40 0H60M0-60V-80M-20 60V80M20 60V80"
        path "M-30-44H-24M-27-47V-41M-30-20H-24"
        live stroke = if(failed > 0.5, burned, signal)
    }

    pin non_inverting_input at -60, -40 "IN+"
    pin inverting_input at -60, -20 "IN−"
    pin reference_one at -60, 20 "REF1"
    pin reference_two at -60, 40 "REF2"
    pin output at 60, 0 "OUT"
    pin Vcc at 0, -80 "VS"
    pin GND at -20, 80 "GND"
    pin not_connected at 20, 80 "NC"
    label name at 30, -70
    label value at 30, 94
}
