symbol "Polarized capacitor" as polarized-capacitor-symbol {
    meta {
        summary "Polarized capacitor, as drawn on a schematic: its plates take the colours of + and − as it charges, thickening and glowing as strongly as its voltage is against its rating"
        category circuits
        tags electronics, schematic
    }
    size 80 x 40
    input charge -1 .. 1
    input failed

    live group body {
        path "M-40 0H-5M4 0H40M-18-13H-10M-14-17V-9"
        live stroke = if(failed > 0.5, burned, signal)
    }

    # The charge each plate holds: the plate at the higher voltage in the colour of +, the other in the colour of −,
    # thicker and glowing as strongly as the voltage across is against the rating — which, at its capacitance, is its
    # charge against the charge it is made to hold. A fiftieth of the rating already shows, a tenth is plain: a 5 V
    # circuit on a 50 V part reads at a glance.
    live path plate_a "M-5-14V14" {
        live stroke = if(failed > 0.5, burned, if(charge > 0.005, positive, if(charge < -0.005, negative, signal)))
        live glow = curve(absolute(charge), 0 -> 0, 0.02 -> 2, 0.1 -> 5, 1 -> 8)
        live thickness = curve(absolute(charge), 0 -> 1, 0.1 -> 1.8, 1 -> 3)
    }

    live path plate_b "M7-14Q0 0 7 14" {
        live stroke = if(failed > 0.5, burned, if(charge > 0.005, negative, if(charge < -0.005, positive, signal)))
        live glow = curve(absolute(charge), 0 -> 0, 0.02 -> 2, 0.1 -> 5, 1 -> 8)
        live thickness = curve(absolute(charge), 0 -> 1, 0.1 -> 1.8, 1 -> 3)
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
