symbol "PTC thermistor" as ptc-thermistor-symbol {
    meta {
        summary "Thermistor whose resistance rises with its temperature, as drawn on a schematic"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input failed
    live group body {
        path "M-40 0H-16V-7H16V7H-16V0M16 0H40M-18 14L14-14H22M22-24V-16M18-20H26"
        live stroke = if(failed > 0.5, burned, signal)
    }
    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
