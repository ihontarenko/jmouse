symbol "Gas discharge tube" as gas-discharge-tube-symbol {
    meta {
        summary "Gas discharge tube, as drawn on a schematic: two electrodes in a gas-filled envelope, the dot its gas"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input failed
    live group body {
        path "M-40 0H-6M6 0H40M-6-9V9M6-9V9M-14 0A14 14 0 1 0 14 0A14 14 0 1 0-14 0M-2 6A2 2 0 1 0 2 6A2 2 0 1 0-2 6"
        live stroke = if(failed > 0.5, burned, signal)
    }
    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
