symbol "Thermistor" as thermistor-symbol {
    meta {
        summary "A thermistor, as drawn on a schematic: a resistor's body crossed by the hooked line of a resistance that follows the temperature"
        category circuits
        tags electronics, schematic
    }
    size 80 x 40
    input failed

    live group body {
        path "M-40 0H-16V-7H16V7H-16V0M16 0H40M-18 14L14-14H22"
        live stroke = if(failed > 0.5, burned, signal)
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
