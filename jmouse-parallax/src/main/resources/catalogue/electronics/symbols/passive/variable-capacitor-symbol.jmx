symbol "Variable capacitor" as variable-capacitor-symbol {
    meta {
        summary "Variable capacitor, as drawn on a schematic: a capacitor with an arrow through its plates"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input failed
    live group body {
        path "M-40 0H-5M5 0H40M-5-14V14M5-14V14M-18 14L16-12M9-12H16V-5"
        live stroke = if(failed > 0.5, burned, signal)
    }
    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
