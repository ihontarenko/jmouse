symbol "Varistor" as varistor-symbol {
    meta {
        summary "A varistor, as drawn on a schematic: a resistor's body crossed by the bent line of a resistance that falls with the voltage"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input failed

    live group body {
        path "M-40 0H-16V-7H16V7H-16V0M16 0H40M-22 14H-14L14-14"
        live stroke = if(failed > 0.5, burned, signal)
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
