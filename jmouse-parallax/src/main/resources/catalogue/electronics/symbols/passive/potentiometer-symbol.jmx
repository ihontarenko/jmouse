symbol "Potentiometer" as potentiometer-symbol {
    meta {
        summary "Potentiometer, as drawn on a schematic: its wiper stands where it is turned to"
        category circuits
        tags electronics, schematic
    }
    size 80 x 80
    input position
    input failed

    live group body {
        path "M-40 0H-16V-7H16V7H-16V0M16 0H40"
        live stroke = if(failed > 0.5, burned, signal)
    }

    path "M0-40V-24"

    live line bridge from 0, -24 to 1, -24 pivot 0, -24 {
        live scale = between(-12, 12, smooth(position, 80 ms)), 1
    }

    live group wiper {
        path "M0-24V-10M-4-14L0-10L4-14"
        live move = between(-12, 12, smooth(position, 80 ms)), 0
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin a at -40, 0
    pin w at 0, -40
    pin b at 40, 0
    label name at 0, 22
    label value at 24, -26
}
