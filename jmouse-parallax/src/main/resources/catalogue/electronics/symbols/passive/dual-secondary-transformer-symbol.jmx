symbol "Transformer with two secondaries" as dual-secondary-transformer-symbol {
    meta {
        summary "A transformer with one primary and two separate secondaries, as drawn on a schematic: each winding on pins of its own"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    # Pins where KiCad's TEZ10 draws them (2.54 mm = 40): the primary on the left, the first secondary high and the second
    # low on the right — so a KiCad design's wires land on them as drawn there.
    size 160 x 340
    input failed

    live group body {
        path "M-80-80H-40C-20-80-20-40-40-40C-20-40-20 0-40 0C-20 0-20 40-40 40C-20 40-20 80-40 80H-80"
        path "M-4-130V170M4-130V170"
        path "M80-120H40C20-120 20-80 40-80C20-80 20-40 40-40C20-40 20 0 40 0H80"
        path "M80 40H40C20 40 20 80 40 80C20 80 20 120 40 120C20 120 20 160 40 160H80"
        live stroke = if(failed > 0.5, burned, signal)
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin primary_one at -80, -80
    pin primary_two at -80, 80
    pin secondary_a_one at 80, -120
    pin secondary_a_two at 80, 0
    pin secondary_b_one at 80, 40
    pin secondary_b_two at 80, 160
    label name at 0, -146
    label value at 0, 186
}
