symbol "Shunt resistor, four terminals" as shunt-resistor-symbol {
    meta {
        summary "A current-sense shunt with Kelvin terminals, as drawn on a schematic: the current runs top to bottom, the voltage is taken from the right"
        category circuits
        tags electronics, schematic
    }
    size 80 x 80
    input load 0 .. 1
    input failed

    live box loading at 0, 0 size 14 x 28 {
        live level = load
        live fill = curve(load, 0 -> positive, 0.6 -> warm, 1 -> hot)
    }

    live group body {
        path "M0-40V-16M-7-16H7V16H-7ZM0 16V40M0-20H40M0 20H40"
        live stroke = if(failed > 0.5, burned, signal)
    }

    pin force_one at 0, -40
    pin sense_one at 40, -20
    pin sense_two at 40, 20
    pin force_two at 0, 40
    label name at -24, -8
    label value at -24, 12
}
