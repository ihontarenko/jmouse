symbol "Transformer with a centre tap" as center-tapped-transformer-symbol {
    meta {
        summary "A transformer whose secondary is tapped in its middle, as drawn on a schematic: two halves of one winding"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 64
    input failed

    live group body {
        path "M-40-20H-18C-3-20-3-7-18-7C-3-7-3 7-18 7C-3 7-3 20-18 20H-40M-2-32V32M2-32V32M40-30H18C33-30 33-15 18-15C33-15 33 0 18 0C33 0 33 15 18 15C33 15 33 30 18 30H40M18 0H40"
        live stroke = if(failed > 0.5, burned, signal)
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin primary_one at -40, -20
    pin primary_two at -40, 20
    pin secondary_one at 40, -30
    pin center_tap at 40, 0
    pin secondary_two at 40, 30
    label name at 0, -42
    label value at 0, 46
}
