symbol "Diode" as diode-symbol {
    meta {
        summary "Diode, as drawn on a schematic"
        category circuits
        tags electronics, schematic
    }
    size 80 x 40
    path "M-40 0H-12V-12L12 0-12 12V0M12-12V12M12 0H40"
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
