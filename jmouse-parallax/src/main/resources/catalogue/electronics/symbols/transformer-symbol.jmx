symbol "Transformer" as transformer-symbol {
    meta {
        summary "Transformer, as drawn on a schematic: its windings char and smoulder once it has burned out"
        category circuits
        tags electronics, schematic
    }
    size 80 x 60
    input failed

    path "M-2-22V22M2-22V22"
    live path windings "M-40-20H-18C-3-20-3-7-18-7C-3-7-3 7-18 7C-3 7-3 20-18 20H-40M40-20H18C3-20 3-7 18-7C3-7 3 7 18 7C3 7 3 20 18 20H40" {
        live stroke = if(failed > 0.5, burned, signal)
    }

    live when failed > 0.5 {
        path scorch "M-14-6L-8 0M-10-12L-4-6M8-8L14-2M6 2L12 8"
        stroke = burned
        animate opacity = 0.4 + 0.6 * blink(1 Hz)
    }

    pin primary_one at -40, -20
    pin primary_two at -40, 20
    pin secondary_one at 40, -20
    pin secondary_two at 40, 20
    label name at 0, -32
    label value at 0, 36
}
