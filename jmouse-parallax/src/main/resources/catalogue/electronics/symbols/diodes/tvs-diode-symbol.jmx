symbol "TVS diode" as tvs-diode-symbol {
    meta {
        summary "Transient voltage suppressor, as drawn on a schematic: a diode whose bar bends both ways, glowing while it clamps a surge"
        category circuits
        tags electronics, schematic
        license "CERN-OHL-W-2.0"
    }
    size 80 x 40
    input forward 0 .. 1
    input reverse 0 .. 1
    input breakdown 0 .. 1
    input failed
    live path die "M-12-12L12 0-12 12Z" {
        stroke = clear
        fill = positive
        live opacity = seen(forward)
        live glow = 9 * seen(forward)
    }
    live group body {
        path "M-40 0H-12V-12L12 0-12 12V0M12 0H40"
        live stroke = if(failed > 0.5, burned, signal)
    }
    # The bar is where it works: it clamps in breakdown, glowing in the colour of + with the surge it takes.
    live path bar "M7-16L12-12V12L17 16" {
        live stroke = if(failed > 0.5, burned, if(breakdown > 0.05, positive, if(reverse > 0.005, negative, signal)))
        live thickness = curve(reverse, 0 -> 1, 0.05 -> 1.6, 1 -> 2.2)
        live glow = curve(breakdown, 0 -> 0, 0.2 -> 3, 1 -> 7)
    }
    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }
    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
