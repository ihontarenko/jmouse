symbol "Schottky diode" as schottky-diode-symbol {
    meta {
        summary "Schottky diode, as drawn on a schematic: the diode's triangle against a bar hooked at both ends — lit inside while it conducts, the bar thickening as it blocks"
        category circuits
        tags electronics, schematic
    }
    size 80 x 40
    input forward 0 .. 1
    input reverse 0 .. 1
    input breakdown 0 .. 1
    input failed

    # Conducting, it fills as any diode does: with the current against its rating, as an eye takes a light.
    live path die "M-12-12L12 0-12 12Z" {
        stroke = clear
        fill = positive
        live opacity = seen(forward)
        live glow = 9 * seen(forward)
    }

    live group body {
        path "M-40 0H-12V-12L12 0-12 12V0M12 0H40"
        live stroke = if(failed > 0.5, burned, signal)
    }

    # The metal–semiconductor junction's mark: the bar hooked back at both ends. A Schottky leaks more than a junction
    # diode, so the bar thickens early as the reverse voltage nears its rating.
    live path bar "M18-7V-12H12V12H6V7" {
        live stroke = if(failed > 0.5, burned, if(breakdown > 0.05, hot, if(reverse > 0.005, negative, signal)))
        live thickness = curve(reverse, 0 -> 1, 0.05 -> 1.6, 1 -> 2.6)
        live glow = curve(breakdown, 0 -> 0, 1 -> 6)
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin a at -40, 0
    pin b at 40, 0
    label name at 0, -26
    label value at 0, 32
}
