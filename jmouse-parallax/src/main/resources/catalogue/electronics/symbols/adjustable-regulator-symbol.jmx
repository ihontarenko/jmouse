symbol "Adjustable voltage regulator" as adjustable-regulator-symbol {
    meta {
        summary "An adjustable three-terminal linear regulator, as drawn on a schematic: input on the left, output on the right, the adjustment below"
        category circuits
        tags electronics, schematic
    }
    size 120 x 80
    input failed

    live group body {
        path "M-30-20H30V20H-30Z"
        path "M-60 0H-30M30 0H60M0 20V40"
        live stroke = if(failed > 0.5, burned, signal)
    }

    live when failed > 0.5 {
        path scorch "M-7-9L-3-3M6-8L2-2M-6 8L-2 3M7 9L3 3M-10 0H-5M10 0H5"
        stroke = burned
        animate opacity = 0.35 + 0.65 * blink(1 Hz)
    }

    pin input at -60, 0 "IN"
    pin output at 60, 0 "OUT"
    pin adjust at 0, 40 "ADJ"
    label name at 0, -32
    label value at 0, 52
}
