    size 60 x 140
    path "M-4 -40H40M-8 -42H-4V-38H-8ZM-4 -20H40M-8 -22H-4V-18H-8ZM-4 0H40M-8 -2H-4V2H-8ZM-4 20H40M-8 18H-4V22H-8ZM-4 40H40M-8 38H-4V42H-8ZM-4 60H40M-8 58H-4V62H-8Z"
    pin pin1 at 40, -40 "1"
    pin pin2 at 40, -20 "2"
    pin pin3 at 40, 0 "3"
    pin pin4 at 40, 20 "4"
    pin pin5 at 40, 40 "5"
    pin pin6 at 40, 60 "6"
    label name at -4, -56
