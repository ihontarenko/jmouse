    path "M-4 -80H40M-8 -82H-4V-78H-8ZM-4 -40H40M-8 -42H-4V-38H-8ZM-4 0H40M-8 -2H-4V2H-8ZM-4 40H40M-8 38H-4V42H-8ZM-4 80H40M-8 78H-4V82H-8ZM-4 120H40M-8 118H-4V122H-8Z"
