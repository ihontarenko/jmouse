# What every 74HC part has in common. A digital pin never meets the analog solver directly: where it lands on an
# analog node, the simulator puts a bridge on it built from this family — an input reads the node through the
# thresholds, an output pulls it towards a rail through the output resistance, moving over the edge time.
#
# Every law is the family's, written here as a formula of the supply its part runs from: the engine evaluates them and
# invents none. A TTL family writes its thresholds as fixed volts — input_low(supply) = 0.8 — and the same engine reads
# it.

family "74HC CMOS logic" as cmos-hc {
    meta {
        summary "74HC high-speed CMOS, 2 V to 6 V"
        source "74HC family characteristics (Nexperia, TI)"
    }

    parameters {
        input_low_share = 0.3              "VIL as a share of the supply"
        input_high_share = 0.7             "VIH as a share of the supply"
        nominal_supply = 4.5 V             "the supply the output resistance and every part's delays are written at"
        nominal_output_resistance = 45 Ohm "the output's resistance at the nominal supply"
        delay_exponent = 2                 "delays grow as (nominal_supply / supply)^this: about five times slower at 2 V"
        minimum_supply = 0.5 V             "below this a part is not powered: its inputs read unknown"
        edge = 7 ns                        "output transition time, 4.5 V, 50 pF"
        input_capacitance = 3.5 pF         "input pin capacitance to ground; adjustable for a specific part"
        output_capacitance = 5 pF          "pin capacitance to ground; adjustable for a specific part"
    }

    formulas {
        # VIL and VIH: a CMOS input switches at a share of its supply
        input_low(supply) = input_low_share * supply
        input_high(supply) = input_high_share * supply

        # An output's channel conducts less as its gate drive drops: the resistance grows as the supply falls
        output_resistance(supply) = nominal_output_resistance * (nominal_supply / max(supply, minimum_supply)) ^ 1.5

        # How much slower every delay a part writes is at this supply than at the nominal one
        delay_scale(supply) = (nominal_supply / max(supply, minimum_supply)) ^ delay_exponent
    }
}
