# Pin headers and sockets by pitch: square leads on a grid, every row count with every pin count of the ranges. A member
# is named `<name>-<rows>x<pins>-pitch-<pitch in hundredths of a millimetre>-vertical`.
map "Header packages" as header-packages {
    description "Pin headers and sockets, square leads on a grid."
    form header

    pin-header "Pin header, 2.54 mm pitch" source standard "IEC 60603-13 grid" {
        name pin-header
        pitch 2.54 mm
        lead 0.64 mm
        thickness 0.64 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
    }

    pin-socket "Pin socket, 2.54 mm pitch" source standard "IEC 60603-13 grid" {
        name pin-socket
        pitch 2.54 mm
        lead 0.64 mm
        thickness 0.64 mm
        rows 1, 2
        pins 1 .. 40
        folder "electromechanical/connectors/through-hole"
    }
}
