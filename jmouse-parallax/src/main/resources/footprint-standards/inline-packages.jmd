# Transistor outlines whose leads stand in one row, the body upright behind them: `body-width` across the row,
# `body-depth` front to back, `back` from the leads' line to the body's back face, `tab` the metal tab's thickness at the
# back (0 for none). Leads `lead` × `thickness` at their largest.
map "Inline packages" as inline-packages {
    description "Upright transistor outlines, the leads in one row."
    form inline

    to-126 "TO-126 (SOT-32)" source standard "JEDEC TO-126" {
        name to-126-3-vertical
        leads 3
        pitch 2.28 mm
        lead 0.88 mm
        thickness 0.6 mm
        body-width 8 mm
        body-depth 3 mm
        back 1.5 mm
        tab 0.5 mm
        folder "packages/through-hole/transistor-outline"
    }

    to-247 "TO-247-3" source standard "JEDEC TO-247 AD" {
        name to-247-3-vertical
        leads 3
        pitch 5.45 mm
        lead 1.4 mm
        thickness 0.8 mm
        body-width 16.25 mm
        body-depth 5.21 mm
        back 2.6 mm
        tab 2 mm
        folder "packages/through-hole/transistor-outline"
    }

    to-3p "TO-3P-3" source standard "JEITA SC-65" {
        name to-3p-3-vertical
        leads 3
        pitch 5.45 mm
        lead 1.2 mm
        thickness 0.7 mm
        body-width 15.6 mm
        body-depth 4.8 mm
        back 2.5 mm
        tab 1.5 mm
        folder "packages/through-hole/transistor-outline"
    }
}
