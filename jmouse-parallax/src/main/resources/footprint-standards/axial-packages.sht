# Cylindrical bodies with a lead out of each end, laid flat (`horizontal`) or stood on end over pin 1 (`vertical`).
# A kind writes what its sizes share — the name template, the folder, the pitches a lead may be bent to, the least
# straight lead it keeps out of the body before a bend —, a size its body: `length` and `diameter` at their largest and
# the lead's diameter. A size is laid flat at every pitch that leaves `bend` free on each side, and stood on end at
# every standing pitch its body clears.
map "Axial packages" as axial-packages {
    description "Cylindrical bodies with a lead out of each end."
    form axial

    resistors "Axial resistor" source standard "IEC 60286-1 bodies, DIN 44051 size codes" {
        name "axial-resistor-body-{code}-pitch-{pitch}-{standing}"
        polarity none
        pitches 5.08 mm, 7.62 mm, 10.16 mm, 12.7 mm, 15.24 mm, 20.32 mm, 25.4 mm, 30.48 mm
        standing-pitches 2.54 mm, 5.08 mm
        bend 1 mm
        folder "passive/resistors/through-hole"

        resistor-0204 "DIN 0204" {
            code "0204"
            length 3.6 mm
            diameter 1.6 mm
            lead 0.5 mm
        }
        resistor-0207 "DIN 0207" {
            code "0207"
            length 6.3 mm
            diameter 2.5 mm
            lead 0.6 mm
        }
        resistor-0309 "DIN 0309" {
            code "0309"
            length 9 mm
            diameter 3.2 mm
            lead 0.7 mm
        }
        resistor-0411 "DIN 0411" {
            code "0411"
            length 9.9 mm
            diameter 3.6 mm
            lead 0.8 mm
        }
        resistor-0414 "DIN 0414" {
            code "0414"
            length 11.9 mm
            diameter 4.5 mm
            lead 0.8 mm
        }
        resistor-0617 "DIN 0617" {
            code "0617"
            length 17 mm
            diameter 6 mm
            lead 0.8 mm
        }
        resistor-0922 "DIN 0922" {
            code "0922"
            length 20 mm
            diameter 9 mm
            lead 0.8 mm
        }
    }

    diodes "Axial diode" source standard "JEDEC DO-204 outlines" {
        name "axial-diode-{code}-pitch-{pitch}-{standing}"
        polarity cathode
        pitches 5.08 mm, 7.62 mm, 10.16 mm, 12.7 mm, 15.24 mm, 20.32 mm
        standing-pitches 2.54 mm, 5.08 mm
        bend 1 mm
        folder "semiconductors/diodes/through-hole"

        diode-do-35 "DO-35 (DO-204AH)" {
            code do-35
            length 4 mm
            diameter 2 mm
            lead 0.56 mm
        }
        diode-do-41 "DO-41 (DO-204AL)" {
            code do-41
            length 5.2 mm
            diameter 2.7 mm
            lead 0.86 mm
        }
        diode-do-15 "DO-15 (DO-204AC)" {
            code do-15
            length 7.6 mm
            diameter 3.6 mm
            lead 0.88 mm
        }
        diode-do-201ad "DO-201AD" {
            code do-201ad
            length 9.5 mm
            diameter 5.3 mm
            lead 1.3 mm
        }
    }
}
